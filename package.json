{
  "name": "plenix",
  "version": "0.31.69",
  "private": true,
  "description": "Plenix Platform: the design system, component library and apps",
  "scripts": {
    "build:app": "node build-app.js && node build-usage.js",
    "lint:system": "node check-system.js",
    "lint:spec": "node check-spec.js",
    "build:docs": "node build-docs.js",
    "build:packages": "node build-packages.js",
    "release:build": "node build-app.js && node build-usage.js && node check-system.js && node build-packages.js",
    "test": "node tests/run.js",
    "test:full": "node tests/run.js --full",
    "test:scope": "node tests/changed.js",
    "test:visual": "node tests/visual.test.js",
    "test:pages": "node tests/pages.test.js",
    "test:a11y": "node tests/a11y.test.js",
    "test:keyboard": "node tests/keyboard.test.js",
    "test:layout": "node tests/layout.test.js",
    "test:theme": "node tests/theme.test.js",
    "test:density": "node tests/density.test.js",
    "test:labs": "node tests/labs.test.js",
    "test:reflow": "node tests/reflow.test.js",
    "test:targets": "node tests/targets.test.js",
    "test:typography": "node tests/typography.test.js",
    "test:login": "node tests/login.test.js",
    "test:contrast": "node tests/contrast.test.js",
    "test:formats": "node tests/formats.test.js",
    "test:utilities": "node tests/utilities.test.js",
    "test:high-contrast": "node tests/high-contrast.test.js",
    "test:focus-order": "node tests/focus-order.test.js",
    "test:semantic-html": "node tests/semantic-html.test.js",
    "test:brand-rules": "node tests/brand-rules.test.js",
    "test:data-table": "node tests/data-table.test.js",
    "test:navigation": "node tests/navigation.test.js"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.9",
    "axe-core": "4.10.3",
    "esbuild": "0.25.10",
    "puppeteer-core": "25.12.0"
  }
}
