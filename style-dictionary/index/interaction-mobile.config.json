{
  "source": [
    "platform/tokens/semantic.interaction-mobile.tokens.json",
    "platform/tokens/components.interaction-mobile.tokens.json",
    "platform/tokens/components/*.interaction-mobile.tokens.json"
  ],
  "log": {
    "warnings": "disabled",
    "verbosity": "silent",
    "errors": {
      "brokenReferences": "console"
    }
  },
  "platforms": {
    "json": {
      "transforms": [
        "name/kebab"
      ],
      "buildPath": "build/sd/index/",
      "files": [
        {
          "destination": "interaction-mobile.json",
          "format": "json"
        }
      ]
    }
  }
}
