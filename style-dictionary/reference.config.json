{
  "source": [
    "platform/tokens/reference.tokens.json",
    "platform/tokens/reference/*.tokens.json"
  ],
  "platforms": {
    "css": {
      "transforms": ["name/kebab", "size/rem", "time/seconds", "color/css", "fontFamily/css", "cubicBezier/css"],
      "buildPath": "build/sd/",
      "files": [
        {
          "destination": "reference.css",
          "format": "css/variables",
          "options": {
            "selector": ":root",
            "outputReferences": true
          }
        }
      ]
    }
  }
}
