{
  "source": [
    "platform/tokens/theme-default.dark.forced-colors.tokens.json"
  ],
  "platforms": {
    "css": {
      "transforms": ["name/kebab", "size/rem", "time/seconds", "color/css", "fontFamily/css", "cubicBezier/css"],
      "buildPath": "build/sd/",
      "files": [
        {
          "destination": "theme-default.dark.forced-colors.css",
          "format": "css/variables",
          "options": {
            "selector": [
              "@media (forced-colors: active)",
              ":root[data-plx-mode=\"dark\"]:not([data-plx-theme]:not([data-plx-theme=\"default\"])),[data-plx-theme=\"default\"][data-plx-mode=\"dark\"]"
            ],
            "outputReferences": true
          }
        }
      ]
    }
  }
}
