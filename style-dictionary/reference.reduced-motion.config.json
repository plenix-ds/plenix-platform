{
  "source": [
    "platform/tokens/reference.reduced-motion.tokens.json"
  ],
  "platforms": {
    "css": {
      "transforms": [
        "name/kebab"
      ],
      "buildPath": "build/sd/",
      "files": [
        {
          "destination": "reference.reduced-motion.css",
          "format": "css/variables",
          "options": {
            "selector": [
              "@media (prefers-reduced-motion: reduce)",
              ":root"
            ],
            "outputReferences": true
          }
        },
        {
          "destination": "reference.density-changing.css",
          "format": "css/variables",
          "options": {
            "selector": [
              "@media (prefers-reduced-motion: no-preference)",
              ":root[data-plx-density-changing]"
            ],
            "outputReferences": true
          }
        }
      ]
    }
  }
}
