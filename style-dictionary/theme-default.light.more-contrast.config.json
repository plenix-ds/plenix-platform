{
  "source": [
    "platform/tokens/theme-default.light.more-contrast.tokens.json"
  ],
  "platforms": {
    "css": {
      "transforms": [
        "name/kebab"
      ],
      "buildPath": "build/sd/",
      "files": [
        {
          "destination": "theme-default.light.more-contrast.css",
          "format": "css/variables",
          "options": {
            "selector": [
              "@media (prefers-contrast: more)",
              ":root:not([data-plx-mode=\"dark\"], [data-plx-theme]:not([data-plx-theme=\"default\"])),[data-plx-theme=\"default\"][data-plx-mode=\"light\"]"
            ],
            "outputReferences": true
          }
        }
      ]
    }
  }
}
