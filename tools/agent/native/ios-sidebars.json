  "code": {
   "swiftui": [
    "import SwiftUI",
    "",
    "/// The Plenix sidebar on iOS: the system sidebar List in a NavigationSplitView, styled with the Plenix tokens.",
    "struct PlenixSidebar: View {",
    "    @State private var selection: Area? = .inbox",
    "",
    "    var body: some View {",
    "        NavigationSplitView {",
    "            List(selection: $selection) {",
    "                Section {",
    "                    row(.inbox, \"Inbox\", \"tray\")",
    "                    row(.assets, \"Assets\", \"photo.on.rectangle\")",
    "                } header: { header(\"Library\") }",
    "                Section {",
    "                    DisclosureGroup(\"Projects\") {",
    "                        row(.spring, \"Spring launch\", \"folder\")",
    "                    }",
    "                } header: { header(\"Work\") }",
    "            }",
    "            .listStyle(.sidebar)",
    "            .environment(\\.defaultMinListRowHeight, Plenix.Platform.controlTargetMin)",
    "            .navigationSplitViewColumnWidth(min: Plenix.Shell.shellNavMinWidth, ideal: Plenix.Component.navPaneWidth, max: Plenix.Shell.shellNavMaxWidth) (no generated name yet)",
    "        } detail: {",
    "            DetailView(area: selection)",
    "        }",
    "    }",
    "",
    "    private func row(_ area: Area, _ title: String, _ symbol: String) -> some View {",
    "        let selected = selection == area",
    "        return NavigationLink(value: area) {",
    "            Label { Text(title) } icon: { Image(systemName: symbol).foregroundStyle(Plenix.Colors.contentMuted) }",
    "                .font(Plenix.Font.sans(Plenix.Platform.textBodySize, relativeTo: .body).weight(selected ? .medium : .regular))",
    "                .foregroundStyle(selected ? Plenix.Colors.selectedContent : Plenix.Colors.contentDefault)",
    "        }",
    "        .listRowBackground(selected ? RoundedRectangle(cornerRadius: Plenix.Radius.radiusControl).fill(Plenix.Colors.stateSelected) : nil)",
    "    }",
    "",
    "    private func header(_ title: String) -> some View {",
    "        Text(title)",
    "            .font(Plenix.Font.sans(Plenix.Platform.textEyebrowSize, relativeTo: .caption).weight(.semibold))",
    "            .foregroundStyle(Plenix.Colors.contentMuted)",
    "    }",
    "}"
   ],
   "uikit": [
    "import UIKit",
    "import SwiftUI",
    "",
    "/// The Plenix sidebar on iOS in UIKit: a sidebar list layout with Plenix cell configurations.",
    "var config = UICollectionLayoutListConfiguration(appearance: .sidebar)",
    "config.headerMode = .supplementary",
    "let layout = UICollectionViewCompositionalLayout.list(using: config)",
    "",
    "let body = UIFontMetrics(forTextStyle: .body).scaledFont(for: UIFont(name: \"DMSans-Regular\", size: Plenix.Platform.textBodySize) ?? .preferredFont(forTextStyle: .body))",
    "let rowRegistration = UICollectionView.CellRegistration<UICollectionViewListCell, Area> { cell, _, area in",
    "    var content = UIListContentConfiguration.sidebarCell()",
    "    content.text = area.title",
    "    content.image = UIImage(systemName: area.symbol)",
    "    content.textProperties.font = body",
    "    content.imageToTextPadding = Plenix.Space.spaceInlineSm",
    "    cell.configurationUpdateHandler = { cell, state in",
    "        var c = content",
    "        c.textProperties.color = UIColor(state.isSelected ? Plenix.Colors.selectedContent : Plenix.Colors.contentDefault)",
    "        c.imageProperties.tintColor = UIColor(Plenix.Colors.contentMuted)",
    "        cell.contentConfiguration = c",
    "        var background = UIBackgroundConfiguration.listSidebarCell().updated(for: state)",
    "        background.cornerRadius = Plenix.Radius.radiusControl",
    "        background.backgroundColor = state.isSelected ? UIColor(Plenix.Colors.stateSelected) : (state.isHighlighted ? UIColor(Plenix.Colors.statePressed) : .clear)",
    "        cell.backgroundConfiguration = background",
    "    }",
    "    if area.hasChildren { cell.accessories = [.outlineDisclosure()] }",
    "}",
    "",
    "let headerRegistration = UICollectionView.SupplementaryRegistration<UICollectionViewListCell>(elementKind: UICollectionView.elementKindSectionHeader) { header, _, indexPath in",
    "    var content = UIListContentConfiguration.sidebarHeader()",
    "    content.text = sections[indexPath.section].title",
    "    content.textProperties.font = UIFontMetrics(forTextStyle: .caption1).scaledFont(for: UIFont(name: \"DMSans-SemiBold\", size: Plenix.Platform.textEyebrowSize) ?? .preferredFont(forTextStyle: .caption1))",
    "    content.textProperties.color = UIColor(Plenix.Colors.contentMuted)",
    "    header.contentConfiguration = content",
    "}"
   ],
   "appkit": [
    "import AppKit",
    "import SwiftUI",
    "",
    "// The Plenix sidebar on the Mac. A Mac Catalyst app uses the iOS tokens and the UIKit code above. A native AppKit app",
    "// needs a macOS build of PlenixTokens.swift (it uses UIColor today; the macOS build is not generated yet). With it:",
    "let outline = NSOutlineView()",
    "outline.style = .sourceList",
    "outline.rowSizeStyle = .default",
    "outline.floatsGroupRows = false",
    "let sidebar = NSSplitViewItem(sidebarWithViewController: SidebarViewController(outline: outline))",
    "sidebar.minimumThickness = Plenix.Shell.shellNavMinWidth",
    "sidebar.maximumThickness = Plenix.Shell.shellNavMaxWidth",
    "sidebar.canCollapse = true                   // collapses when the window gets narrow",
    "",
    "final class PlenixRowView: NSTableRowView {",
    "    override func drawSelection(in dirtyRect: NSRect) {",
    "        NSColor(Plenix.Colors.stateSelected).setFill()",
    "        NSBezierPath(roundedRect: bounds.insetBy(dx: Plenix.Space.spaceInsetSm, dy: 0), xRadius: Plenix.Radius.radiusControl, yRadius: Plenix.Radius.radiusControl).fill()",
    "    }",
    "}"
   ]
  }
 }
}
