  "code": {
   "compose": [
    "import androidx.compose.foundation.border",
    "import androidx.compose.foundation.layout.*",
    "import androidx.compose.foundation.shape.RoundedCornerShape",
    "import androidx.compose.material.icons.Icons",
    "import androidx.compose.material.icons.outlined.Close",
    "import androidx.compose.material.icons.outlined.Search",
    "import androidx.compose.material3.*",
    "import androidx.compose.runtime.*",
    "import androidx.compose.runtime.saveable.rememberSaveable",
    "import androidx.compose.ui.Modifier",
    "import androidx.compose.ui.text.font.*",
    "import androidx.compose.ui.unit.dp",
    "import plenix.tokens.*",
    "",
    "// DM Sans (PlenixFonts.SANS), bundled in res/font; the app’s MaterialTheme typography uses it for bodyLarge",
    "val DmSans = FontFamily(Font(R.font.dm_sans_regular), Font(R.font.dm_sans_medium, FontWeight.Medium), Font(R.font.dm_sans_semibold, FontWeight.SemiBold), Font(R.font.dm_sans_bold, FontWeight.Bold))",
    "",
    "/** The Plenix search bar on Android: the Material 3 SearchBar, styled with the generated Plenix tokens. */",
    "@OptIn(ExperimentalMaterial3Api::class)",
    "@Composable",
    "fun PlenixSearchBar(",
    "    query: String,",
    "    onQueryChange: (String) -> Unit,",
    "    onSearch: (String) -> Unit,",
    "    placeholder: String = \"Search\",",
    "    results: @Composable ColumnScope.() -> Unit,",
    ") {",
    "    var expanded by rememberSaveable { mutableStateOf(false) }",
    "    val shape = RoundedCornerShape(PlenixRadius.radiusControl)",
    "    val muted = PlenixColors.contentMuted.current()",
    "    val text = PlenixColors.contentDefault.current()",
    "    val hint = PlenixColors.fieldPlaceholder.current()",
    "    SearchBar(",
    "        inputField = {",
    "            SearchBarDefaults.InputField(",
    "                query = query,",
    "                onQueryChange = onQueryChange,",
    "                onSearch = { onSearch(it); expanded = false },",
    "                expanded = expanded,",
    "                onExpandedChange = { expanded = it },",
    "                placeholder = { Text(placeholder) },",
    "                leadingIcon = { Icon(Icons.Outlined.Search, contentDescription = null, Modifier.size(PlenixPlatform.inputIcon), tint = muted) },",
    "                trailingIcon = {",
    "                    if (query.isNotEmpty()) IconButton(onClick = { onQueryChange(\"\") }) {",
    "                        Icon(Icons.Outlined.Close, contentDescription = \"Clear search\", tint = muted)",
    "                    }",
    "                },",
    "                colors = SearchBarDefaults.inputFieldColors(",
    "                    focusedTextColor = text, unfocusedTextColor = text,",
    "                    focusedPlaceholderColor = hint, unfocusedPlaceholderColor = hint,",
    "                    cursorColor = PlenixColors.focusRingColor.current(),",
    "                ),",
    "                modifier = Modifier.heightIn(min = PlenixPlatform.inputMinHeight),",
    "            )",
    "        },",
    "        expanded = expanded,",
    "        onExpandedChange = { expanded = it },",
    "        shape = shape,",
    "        colors = SearchBarDefaults.colors(",
    "            containerColor = if (expanded) PlenixColors.surfaceDefault.current() else PlenixColors.fillNeutral.current(),",
    "            dividerColor = PlenixColors.borderDivider.current(),",
    "        ),",
    "        tonalElevation = 0.dp,",
    "        shadowElevation = 0.dp,",
    "        modifier = if (expanded) Modifier else Modifier.border(PlenixComponent.searchInputBorderWidth, PlenixColors.controlBorder.current(), shape),",
    "        content = results,",
    "    )",
    "}",
    "",
    "// Medium and Wide windows: the same inputField and colors in a DockedSearchBar"
   ],
   "views": [
    "<!-- res/layout: the Material search bar and the search view it opens -->",
    "<com.google.android.material.search.SearchBar",
    "    android:id=\"@+id/search_bar\"",
    "    android:layout_width=\"match_parent\"",
    "    android:layout_height=\"wrap_content\"",
    "    android:hint=\"Search\" />",
    "<com.google.android.material.search.SearchView",
    "    android:id=\"@+id/search_view\"",
    "    android:layout_width=\"match_parent\"",
    "    android:layout_height=\"match_parent\"",
    "    android:hint=\"Search\"",
    "    app:layout_anchor=\"@id/search_bar\" />",
    "",
    "// Kotlin. Views take ARGB ints and pixels: a Plenix color for the current appearance, a Plenix dp in pixels",
    "fun Context.argb(light: Color, dark: Color): Int =",
    "    (if ((resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES) dark else light).toArgb()",
    "fun Context.px(dp: Dp): Float = dp.value * resources.displayMetrics.density",
    "",
    "val bar = findViewById<SearchBar>(R.id.search_bar)",
    "val view = findViewById<SearchView>(R.id.search_view)",
    "view.setupWithSearchBar(bar)",
    "val dmSans = ResourcesCompat.getFont(this, R.font.dm_sans_regular)",
    "",
    "bar.backgroundTintList = ColorStateList.valueOf(argb(PlenixColors.fillNeutral.light, PlenixColors.fillNeutral.dark))",
    "bar.setStrokeColor(argb(PlenixColors.controlBorder.light, PlenixColors.controlBorder.dark))",
    "bar.setStrokeWidth(px(PlenixComponent.searchInputBorderWidth))",
    "bar.elevation = 0f",
    "(bar.background as? MaterialShapeDrawable)?.let {",
    "    it.shapeAppearanceModel = it.shapeAppearanceModel.toBuilder().setAllCornerSizes(px(PlenixRadius.radiusControl)).build()",
    "}",
    "bar.setNavigationIconTint(argb(PlenixColors.contentMuted.light, PlenixColors.contentMuted.dark))",
    "bar.textView.typeface = dmSans",
    "bar.textView.setTextSize(TypedValue.COMPLEX_UNIT_SP, PlenixPlatform.textBodySize.value)",
    "bar.textView.setHintTextColor(argb(PlenixColors.fieldPlaceholder.light, PlenixColors.fieldPlaceholder.dark))",
    "",
    "view.setBackgroundColor(argb(PlenixColors.surfaceDefault.light, PlenixColors.surfaceDefault.dark))",
    "view.editText.typeface = dmSans",
    "view.editText.setTextColor(argb(PlenixColors.contentDefault.light, PlenixColors.contentDefault.dark))",
    "view.editText.setOnEditorActionListener { _, _, _ -> search(view.text.toString()); view.hide(); true }"
   ]
  }
 }
