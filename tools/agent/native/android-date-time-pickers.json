  "code": {
   "compose": [
    "import android.text.format.DateFormat",
    "import androidx.compose.foundation.shape.RoundedCornerShape",
    "import androidx.compose.material3.*",
    "import androidx.compose.runtime.Composable",
    "import androidx.compose.ui.platform.LocalContext",
    "import androidx.compose.ui.unit.dp",
    "import plenix.tokens.*",
    "",
    "/** The Plenix date picker colors: Material 3’s DatePicker with the generated Plenix tokens. */",
    "@OptIn(ExperimentalMaterial3Api::class)",
    "@Composable",
    "fun plenixDatePickerColors() = DatePickerDefaults.colors(",
    "    containerColor = PlenixColors.surfaceOverlay.current(),",
    "    titleContentColor = PlenixColors.contentMuted.current(),",
    "    headlineContentColor = PlenixColors.contentDefault.current(),",
    "    weekdayContentColor = PlenixColors.contentMuted.current(),",
    "    navigationContentColor = PlenixColors.contentMuted.current(),",
    "    dayContentColor = PlenixColors.contentDefault.current(),",
    "    disabledDayContentColor = PlenixColors.contentDisabled.current(),",
    "    selectedDayContainerColor = PlenixColors.actionPrimaryBackground.current(),",
    "    selectedDayContentColor = PlenixColors.actionPrimaryContent.current(),",
    "    selectedYearContainerColor = PlenixColors.actionPrimaryBackground.current(),",
    "    selectedYearContentColor = PlenixColors.actionPrimaryContent.current(),",
    "    currentYearContentColor = PlenixColors.contentLink.current(),",
    "    todayContentColor = PlenixColors.contentLink.current(),",
    "    todayDateBorderColor = PlenixColors.contentLink.current(),",
    "    dayInSelectionRangeContainerColor = PlenixColors.stateSelected.current(),",
    "    dayInSelectionRangeContentColor = PlenixColors.contentDefault.current(),",
    "    dividerColor = PlenixColors.borderDivider.current(),",
    ")",
    "",
    "// The actions: OK in the link color, Cancel muted, as text buttons",
    "@Composable",
    "fun PickerConfirm(onClick: () -> Unit) = TextButton(onClick = onClick, colors = ButtonDefaults.textButtonColors(contentColor = PlenixColors.contentLink.current())) { Text(\"OK\") }",
    "@Composable",
    "fun PickerDismiss(onClick: () -> Unit) = TextButton(onClick = onClick, colors = ButtonDefaults.textButtonColors(contentColor = PlenixColors.contentMuted.current())) { Text(\"Cancel\") }",
    "",
    "@OptIn(ExperimentalMaterial3Api::class)",
    "@Composable",
    "fun PlenixDatePickerDialog(onPick: (Long?) -> Unit, onDismiss: () -> Unit) {",
    "    val state = rememberDatePickerState()",
    "    val colors = plenixDatePickerColors()",
    "    DatePickerDialog(",
    "        onDismissRequest = onDismiss,",
    "        confirmButton = { PickerConfirm { onPick(state.selectedDateMillis) } },",
    "        dismissButton = { PickerDismiss(onDismiss) },",
    "        shape = RoundedCornerShape(PlenixRadius.radiusDialog8px),",
    "        tonalElevation = 0.dp,",
    "        colors = colors,",
    "    ) { DatePicker(state = state, colors = colors) }",
    "}",
    "",
    "@OptIn(ExperimentalMaterial3Api::class)",
    "@Composable",
    "fun PlenixTimePickerDialog(onPick: (hour: Int, minute: Int) -> Unit, onDismiss: () -> Unit) {",
    "    val state = rememberTimePickerState(is24Hour = DateFormat.is24HourFormat(LocalContext.current))",
    "    AlertDialog(",
    "        onDismissRequest = onDismiss,",
    "        confirmButton = { PickerConfirm { onPick(state.hour, state.minute) } },",
    "        dismissButton = { PickerDismiss(onDismiss) },",
    "        shape = RoundedCornerShape(PlenixRadius.radiusDialog8px),",
    "        containerColor = PlenixColors.surfaceOverlay.current(),",
    "        tonalElevation = 0.dp,",
    "        text = {",
    "            TimePicker(state = state, colors = TimePickerDefaults.colors(",
    "                containerColor = PlenixColors.surfaceOverlay.current(),",
    "                clockDialColor = PlenixColors.fillNeutral.current(),",
    "                selectorColor = PlenixColors.actionPrimaryBackground.current(),",
    "                clockDialSelectedContentColor = PlenixColors.actionPrimaryContent.current(),",
    "                clockDialUnselectedContentColor = PlenixColors.contentDefault.current(),",
    "                periodSelectorBorderColor = PlenixColors.controlBorder.current(),",
    "                periodSelectorSelectedContainerColor = PlenixColors.stateSelected.current(),",
    "                periodSelectorSelectedContentColor = PlenixColors.selectedContent.current(),",
    "                periodSelectorUnselectedContentColor = PlenixColors.contentMuted.current(),",
    "                timeSelectorSelectedContainerColor = PlenixColors.stateSelected.current(),",
    "                timeSelectorSelectedContentColor = PlenixColors.selectedContent.current(),",
    "                timeSelectorUnselectedContainerColor = PlenixColors.fillNeutral.current(),",
    "                timeSelectorUnselectedContentColor = PlenixColors.contentDefault.current(),",
    "            ))",
    "        },",
    "    )",
    "}"
   ],
   "views": [
    "<!-- res/values/themes.xml: theme overlays for the Material pickers. Views themes read color resources, so the app",
    "     declares one per Plenix role it uses (values/ and values-night/), holding the light and dark values of PlenixColors. -->",
    "<style name=\"ThemeOverlay.App.PlenixDatePicker\" parent=\"ThemeOverlay.Material3.MaterialCalendar\">",
    "    <item name=\"colorPrimary\">@color/plx_action_primary_background</item>",
    "    <item name=\"colorOnPrimary\">@color/plx_action_primary_content</item>",
    "    <item name=\"colorSecondaryContainer\">@color/plx_state_selected</item>",
    "    <item name=\"colorOnSecondaryContainer\">@color/plx_content_default</item>",
    "    <item name=\"colorSurfaceContainerHigh\">@color/plx_surface_overlay</item>",
    "    <item name=\"colorOnSurface\">@color/plx_content_default</item>",
    "    <item name=\"colorOnSurfaceVariant\">@color/plx_content_muted</item>",
    "    <item name=\"colorOutline\">@color/plx_control_border</item>",
    "    <item name=\"shapeAppearanceCornerExtraLarge\">@style/ShapeAppearance.App.PlenixDialog</item>",
    "    <item name=\"fontFamily\">@font/dm_sans_regular</item>",
    "    <item name=\"android:fontFamily\">@font/dm_sans_regular</item>",
    "</style>",
    "<style name=\"ThemeOverlay.App.PlenixTimePicker\" parent=\"ThemeOverlay.Material3.MaterialTimePicker\">",
    "    <item name=\"colorPrimary\">@color/plx_action_primary_background</item>",
    "    <item name=\"colorOnPrimary\">@color/plx_action_primary_content</item>",
    "    <item name=\"colorPrimaryContainer\">@color/plx_state_selected</item>",
    "    <item name=\"colorOnPrimaryContainer\">@color/plx_selected_content</item>",
    "    <item name=\"colorTertiaryContainer\">@color/plx_state_selected</item>",
    "    <item name=\"colorSurfaceContainerHighest\">@color/plx_fill_neutral</item>",
    "    <item name=\"colorSurfaceContainerHigh\">@color/plx_surface_overlay</item>",
    "    <item name=\"colorOutline\">@color/plx_control_border</item>",
    "    <item name=\"shapeAppearanceCornerExtraLarge\">@style/ShapeAppearance.App.PlenixDialog</item>",
    "    <item name=\"fontFamily\">@font/dm_sans_regular</item>",
    "</style>",
    "<!-- 8 dp: PlenixRadius.radiusDialog8px -->",
    "<style name=\"ShapeAppearance.App.PlenixDialog\" parent=\"\">",
    "    <item name=\"cornerFamily\">rounded</item>",
    "    <item name=\"cornerSize\">@dimen/plx_radius_radius_dialog_8px</item>",
    "</style>",
    "",
    "// Kotlin",
    "val date = MaterialDatePicker.Builder.datePicker()",
    "    .setTitleText(\"Due date\")",
    "    .setTheme(R.style.ThemeOverlay_App_PlenixDatePicker)",
    "    .build()",
    "date.addOnPositiveButtonClickListener { millis -> onPick(millis) }",
    "date.show(supportFragmentManager, \"due-date\")",
    "",
    "val time = MaterialTimePicker.Builder()",
    "    .setTimeFormat(if (DateFormat.is24HourFormat(this)) TimeFormat.CLOCK_24H else TimeFormat.CLOCK_12H)",
    "    .setInputMode(MaterialTimePicker.INPUT_MODE_CLOCK)",
    "    .setTitleText(\"Reminder\")",
    "    .setTheme(R.style.ThemeOverlay_App_PlenixTimePicker)",
    "    .build()",
    "time.addOnPositiveButtonClickListener { onPick(time.hour, time.minute) }",
    "time.show(supportFragmentManager, \"reminder-time\")"
   ]
  }
 }
}
