  "code": {
   "compose": [
    "import androidx.compose.foundation.BorderStroke",
    "import androidx.compose.foundation.background",
    "import androidx.compose.foundation.layout.*",
    "import androidx.compose.foundation.shape.RoundedCornerShape",
    "import androidx.compose.material3.*",
    "import androidx.compose.runtime.*",
    "import androidx.compose.ui.Modifier",
    "import androidx.compose.ui.text.TextStyle",
    "import androidx.compose.ui.text.font.*",
    "import androidx.compose.ui.unit.dp",
    "import plenix.tokens.*",
    "",
    "// DM Sans (PlenixFonts.SANS), bundled in res/font",
    "val DmSans = FontFamily(Font(R.font.dm_sans_regular), Font(R.font.dm_sans_medium, FontWeight.Medium), Font(R.font.dm_sans_semibold, FontWeight.SemiBold), Font(R.font.dm_sans_bold, FontWeight.Bold))",
    "",
    "/** The Plenix select on Android: Material 3’s exposed dropdown menu, styled with the generated Plenix tokens. */",
    "@OptIn(ExperimentalMaterial3Api::class)",
    "@Composable",
    "fun <T> PlenixSelect(label: String, options: List<T>, selected: T, onSelect: (T) -> Unit, text: (T) -> String = { it.toString() }) {",
    "    var expanded by remember { mutableStateOf(false) }",
    "    val body = TextStyle(fontFamily = DmSans, fontSize = PlenixPlatform.textBodySize, lineHeight = PlenixPlatform.textBodyLineHeight)",
    "    val field = PlenixColors.controlBackground.current()",
    "    val content = PlenixColors.contentDefault.current()",
    "    val muted = PlenixColors.contentMuted.current()",
    "    ExposedDropdownMenuBox(expanded = expanded, onExpandedChange = { expanded = it }) {",
    "        // the focused border keeps 1 dp: a field built on OutlinedTextFieldDefaults.DecorationBox passes",
    "        // OutlinedTextFieldDefaults.Container(focusedBorderThickness = PlenixComponent.inputBorderWidth, unfocusedBorderThickness = PlenixComponent.inputBorderWidth)",
    "        OutlinedTextField(",
    "            value = text(selected),",
    "            onValueChange = {},",
    "            readOnly = true,",
    "            label = { Text(label) },",
    "            trailingIcon = { ExposedDropdownMenuDefaults.TrailingIcon(expanded = expanded) },",
    "            textStyle = body,",
    "            shape = RoundedCornerShape(PlenixRadius.radiusControl),",
    "            colors = OutlinedTextFieldDefaults.colors(",
    "                focusedContainerColor = field, unfocusedContainerColor = field,",
    "                unfocusedBorderColor = PlenixColors.controlBorder.current(),",
    "                focusedBorderColor = PlenixColors.focusRingColor.current(),",
    "                errorBorderColor = PlenixColors.feedbackDangerContent.current(),",
    "                focusedTextColor = content, unfocusedTextColor = content,",
    "                focusedLabelColor = content, unfocusedLabelColor = content,",
    "                focusedTrailingIconColor = muted, unfocusedTrailingIconColor = muted,",
    "                disabledContainerColor = PlenixColors.fillNeutral.current(),",
    "                disabledTextColor = PlenixColors.contentDisabled.current(),",
    "            ),",
    "            modifier = Modifier",
    "                .menuAnchor(ExposedDropdownMenuAnchorType.PrimaryNotEditable)",
    "                .fillMaxWidth()",
    "                .heightIn(min = PlenixPlatform.inputMinHeight),",
    "        )",
    "        ExposedDropdownMenu(",
    "            expanded = expanded,",
    "            onDismissRequest = { expanded = false },",
    "            shape = RoundedCornerShape(PlenixRadius.radiusSurface4px),",
    "            containerColor = PlenixColors.surfaceOverlay.current(),",
    "            border = BorderStroke(PlenixComponent.menuBorderWidth, PlenixColors.borderDefault.current()),",
    "            tonalElevation = 0.dp,",
    "            shadowElevation = MenuDefaults.ShadowElevation,",
    "        ) {",
    "            options.forEach { option ->",
    "                val chosen = option == selected",
    "                DropdownMenuItem(",
    "                    text = { Text(text(option), style = body, fontWeight = if (chosen) FontWeight.SemiBold else FontWeight.Normal) },",
    "                    onClick = { onSelect(option); expanded = false },",
    "                    colors = MenuDefaults.itemColors(textColor = if (chosen) PlenixColors.contentLink.current() else content),",
    "                    contentPadding = PaddingValues(horizontal = PlenixSpace.spaceInsetMd),",
    "                    modifier = Modifier",
    "                        .heightIn(min = PlenixPlatform.controlTargetMin)",
    "                        .then(if (chosen) Modifier.background(PlenixColors.stateSelected.current()) else Modifier),",
    "                )",
    "            }",
    "        }",
    "    }",
    "}",
    "",
    "// In a form",
    "PlenixSelect(label = \"Format\", options = listOf(\"PNG\", \"JPG\", \"WebP\"), selected = format, onSelect = { format = it })"
   ],
   "views": [
    "<!-- res/layout: Material’s exposed dropdown menu -->",
    "<com.google.android.material.textfield.TextInputLayout",
    "    android:id=\"@+id/format_layout\"",
    "    style=\"@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu\"",
    "    android:layout_width=\"match_parent\"",
    "    android:layout_height=\"wrap_content\"",
    "    android:hint=\"Format\"",
    "    app:boxStrokeWidth=\"1dp\"",
    "    app:boxStrokeWidthFocused=\"1dp\">",
    "    <com.google.android.material.textfield.MaterialAutoCompleteTextView",
    "        android:id=\"@+id/format\"",
    "        android:layout_width=\"match_parent\"",
    "        android:layout_height=\"wrap_content\"",
    "        android:inputType=\"none\"",
    "        app:simpleItems=\"@array/formats\" />",
    "</com.google.android.material.textfield.TextInputLayout>",
    "",
    "// Kotlin. Views take ARGB ints and pixels: a Plenix color for the current appearance, a Plenix dp in pixels",
    "fun Context.argb(light: Color, dark: Color): Int =",
    "    (if ((resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES) dark else light).toArgb()",
    "fun Context.px(dp: Dp): Float = dp.value * resources.displayMetrics.density",
    "",
    "val layout = findViewById<TextInputLayout>(R.id.format_layout)",
    "val field = findViewById<MaterialAutoCompleteTextView>(R.id.format)",
    "val r = px(PlenixRadius.radiusControl)",
    "layout.setBoxCornerRadii(r, r, r, r)",
    "layout.boxBackgroundColor = argb(PlenixColors.controlBackground.light, PlenixColors.controlBackground.dark)",
    "layout.setBoxStrokeColorStateList(ColorStateList(",
    "    arrayOf(intArrayOf(android.R.attr.state_focused), intArrayOf()),",
    "    intArrayOf(argb(PlenixColors.focusRingColor.light, PlenixColors.focusRingColor.dark), argb(PlenixColors.controlBorder.light, PlenixColors.controlBorder.dark))))",
    "layout.setBoxStrokeErrorColor(ColorStateList.valueOf(argb(PlenixColors.feedbackDangerContent.light, PlenixColors.feedbackDangerContent.dark)))",
    "val label = ColorStateList.valueOf(argb(PlenixColors.contentDefault.light, PlenixColors.contentDefault.dark))",
    "layout.defaultHintTextColor = label",
    "layout.hintTextColor = label",
    "layout.setEndIconTintList(ColorStateList.valueOf(argb(PlenixColors.contentMuted.light, PlenixColors.contentMuted.dark)))",
    "",
    "field.typeface = ResourcesCompat.getFont(this, R.font.dm_sans_regular)",
    "field.setTextSize(TypedValue.COMPLEX_UNIT_SP, PlenixPlatform.textBodySize.value)",
    "field.setTextColor(argb(PlenixColors.contentDefault.light, PlenixColors.contentDefault.dark))",
    "field.setDropDownBackgroundDrawable(MaterialShapeDrawable(",
    "    ShapeAppearanceModel.builder().setAllCornerSizes(px(PlenixRadius.radiusSurface4px)).build()).apply {",
    "    fillColor = ColorStateList.valueOf(argb(PlenixColors.surfaceOverlay.light, PlenixColors.surfaceOverlay.dark))",
    "    setStroke(px(PlenixComponent.menuBorderWidth), argb(PlenixColors.borderDefault.light, PlenixColors.borderDefault.dark))",
    "})",
    "field.setOnItemClickListener { _, _, position, _ -> onSelect(position) }"
   ]
  }
 }
}
