  "code": {
   "swiftui": [
    "import SwiftUI",
    "",
    "/// The Plenix menu on iOS: the system Menu. Plenix sets the content, order, roles and symbols;",
    "/// the system draws the surface (glass, radius, font).",
    "Menu {",
    "    Section {",
    "        Button(\"Duplicate\", systemImage: \"plus.square.on.square\", action: duplicate)",
    "        Button(\"Rename…\", systemImage: \"pencil\", action: rename)",
    "    }",
    "    Section(\"Sort By\") {",
    "        Picker(\"Sort By\", selection: $sort) {",
    "            Text(\"Name\").tag(Sort.name)",
    "            Text(\"Date\").tag(Sort.date)",
    "        }",
    "    }",
    "    Menu(\"Move To\", systemImage: \"folder\") {",
    "        ForEach(folders) { folder in Button(folder.name) { move(to: folder) } }",
    "    }",
    "    Button(\"Delete\", systemImage: \"trash\", role: .destructive, action: delete)",
    "} label: {",
    "    Label(\"More\", systemImage: \"ellipsis.circle\")",
    "}",
    "",
    "/// Where Plenix draws a menu itself (a custom popover list), each row uses the Plenix menu tokens.",
    "struct PlenixMenuRow: View {",
    "    let title: String, symbol: String?",
    "    var danger = false",
    "    let action: () -> Void",
    "    @Environment(\\.isEnabled) private var isEnabled",
    "    var body: some View {",
    "        Button(action: action) {",
    "            HStack(spacing: Plenix.Space.spaceInlineSm) {",
    "                if let symbol { Image(systemName: symbol).imageScale(.medium) }",
    "                Text(title).font(Plenix.Font.sans(Plenix.Platform.textBodySize, relativeTo: .body))",
    "                Spacer(minLength: 0)",
    "            }",
    "            .foregroundStyle(!isEnabled ? Plenix.Colors.contentDisabled : danger ? Plenix.Colors.feedbackDangerContent : Plenix.Colors.contentDefault)",
    "            .padding(.horizontal, Plenix.Space.spaceInsetSm)",
    "            .frame(minHeight: Plenix.Platform.controlTargetMin)",
    "            .contentShape(.rect)",
    "        }",
    "        .buttonStyle(.plain)",
    "    }",
    "}",
    "",
    "// The Plenix-drawn surface around the rows",
    "VStack(spacing: 0) { rows }",
    "    .padding(.vertical, Plenix.Space.spaceInsetXs)",
    "    .background(Plenix.Colors.surfaceOverlay, in: .rect(cornerRadius: Plenix.Radius.radiusMenu8px))",
    "    .overlay { RoundedRectangle(cornerRadius: Plenix.Radius.radiusMenu8px).strokeBorder(Plenix.Colors.borderDefault, lineWidth: Plenix.Component.menuBorderWidth) }"
   ],
   "uikit": [
    "import UIKit",
    "import SwiftUI",
    "",
    "/// The Plenix menu on iOS in UIKit: a system UIMenu on a button. The system draws the surface.",
    "let menu = UIMenu(children: [",
    "    UIMenu(options: .displayInline, children: [",
    "        UIAction(title: \"Duplicate\", image: UIImage(systemName: \"plus.square.on.square\")) { _ in duplicate() },",
    "        UIAction(title: \"Rename…\", image: UIImage(systemName: \"pencil\")) { _ in rename() }",
    "    ]),",
    "    UIMenu(title: \"Sort By\", options: [.displayInline, .singleSelection], children: [",
    "        UIAction(title: \"Name\", state: .on) { _ in sort(.name) },",
    "        UIAction(title: \"Date\") { _ in sort(.date) }",
    "    ]),",
    "    UIMenu(title: \"Move To\", image: UIImage(systemName: \"folder\"), children: folderActions),",
    "    UIAction(title: \"Delete\", image: UIImage(systemName: \"trash\"), attributes: .destructive) { _ in delete() }",
    "])",
    "moreButton.menu = menu",
    "moreButton.showsMenuAsPrimaryAction = true",
    "moreButton.tintColor = UIColor(Plenix.Colors.contentDefault)"
   ],
   "appkit": [
    "import AppKit",
    "import SwiftUI",
    "",
    "// The Plenix menu on the Mac: a system NSMenu. A Mac Catalyst app uses the UIKit code above. A native AppKit app",
    "// needs a macOS build of PlenixTokens.swift (it uses UIColor today; the macOS build is not generated yet).",
    "let menu = NSMenu()",
    "menu.addItem(withTitle: \"Duplicate\", action: #selector(duplicate(_:)), keyEquivalent: \"d\")",
    "menu.addItem(withTitle: \"Rename…\", action: #selector(rename(_:)), keyEquivalent: \"\")",
    "menu.addItem(.separator())",
    "menu.addItem(.sectionHeader(title: \"Sort By\"))",
    "let byName = menu.addItem(withTitle: \"Name\", action: #selector(sortByName(_:)), keyEquivalent: \"\")",
    "byName.state = .on",
    "menu.addItem(.separator())",
    "menu.addItem(withTitle: \"Move to Trash\", action: #selector(delete(_:)), keyEquivalent: \"\")",
    "NSMenu.popUpContextMenu(menu, with: event, for: view)"
   ]
  }
 }
