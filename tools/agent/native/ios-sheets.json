  "code": {
   "swiftui": [
    "import SwiftUI",
    "",
    "/// The Plenix sheet on iOS: the system sheet, styled with the Plenix tokens through the presentation modifiers.",
    "struct EditRecordSheet: View {",
    "    @Environment(\\.dismiss) private var dismiss",
    "    @State private var hasChanges = false",
    "    var body: some View {",
    "        NavigationStack {",
    "            Form { /* Plenix fields */ }",
    "                .scrollContentBackground(.hidden)",
    "                .padding(.horizontal, Plenix.Space.spaceInsetLg)",
    "                .toolbar {",
    "                    ToolbarItem(placement: .cancellationAction) {",
    "                        Button(\"Cancel\", role: .cancel) { dismiss() }.buttonStyle(PlenixButtonStyle())",
    "                    }",
    "                    ToolbarItem(placement: .principal) {",
    "                        Text(\"Edit record\").font(Plenix.Font.sans(Plenix.Platform.textHeadingSize, relativeTo: .headline).weight(.semibold))",
    "                    }",
    "                    ToolbarItem(placement: .confirmationAction) {",
    "                        Button(\"Done\", action: save).buttonStyle(PlenixButtonStyle(variant: .primary))",
    "                    }",
    "                }",
    "        }",
    "        .interactiveDismissDisabled(hasChanges)",
    "    }",
    "}",
    "",
    "// In a view",
    ".sheet(isPresented: $editing) {",
    "    EditRecordSheet()",
    "        .presentationDetents([.medium, .large])",
    "        .presentationDragIndicator(.visible)",
    "        .presentationBackground(Plenix.Colors.surfaceOverlay)",
    "        .presentationCornerRadius(Plenix.Radius.radiusDialog8px)",
    "}"
   ],
   "uikit": [
    "import UIKit",
    "import SwiftUI",
    "",
    "/// The Plenix sheet in UIKit: the system sheet presentation with Plenix styling.",
    "let edit = UINavigationController(rootViewController: EditRecordViewController())",
    "edit.view.backgroundColor = UIColor(Plenix.Colors.surfaceOverlay)",
    "if let sheet = edit.sheetPresentationController {",
    "    sheet.detents = [.medium(), .large()]",
    "    sheet.prefersGrabberVisible = true",
    "    sheet.preferredCornerRadius = Plenix.Radius.radiusDialog8px",
    "    sheet.largestUndimmedDetentIdentifier = nil",
    "}",
    "edit.isModalInPresentation = hasChanges   // guard swipe down; confirm in presentationControllerDidAttemptToDismiss",
    "",
    "let cancel = UIButton(configuration: .plenix(background: Plenix.Colors.controlBackground, content: Plenix.Colors.contentDefault, border: Plenix.Colors.controlBorder),",
    "                      primaryAction: UIAction(title: \"Cancel\") { _ in edit.dismiss(animated: true) })",
    "let done = UIButton(configuration: .plenix(background: Plenix.Colors.actionPrimaryBackground, content: Plenix.Colors.actionPrimaryContent),",
    "                    primaryAction: UIAction(title: \"Done\") { _ in save() })",
    "edit.topViewController?.navigationItem.leftBarButtonItem = UIBarButtonItem(customView: cancel)",
    "edit.topViewController?.navigationItem.rightBarButtonItem = UIBarButtonItem(customView: done)",
    "present(edit, animated: true)"
   ],
   "appkit": [
    "import AppKit",
    "import SwiftUI",
    "",
    "// The Plenix sheet on the Mac. A Mac Catalyst app uses the iOS tokens and the UIKit code above. A native AppKit app",
    "// needs a macOS build of PlenixTokens.swift (it uses UIColor today; the macOS build is not generated yet). With it:",
    "let sheet = NSWindow(contentViewController: EditRecordViewController())",
    "sheet.backgroundColor = NSColor(Plenix.Colors.surfaceOverlay)",
    "window.beginSheet(sheet) { response in if response == .OK { save() } }"
   ]
  }
 }
