  "code": {
   "swiftui": [
    "import SwiftUI",
    "",
    "/// The Plenix progress bar on iOS: the system ProgressView, styled with the Plenix tokens (PlenixTokens.swift).",
    "struct PlenixProgressStyle: ProgressViewStyle {",
    "    enum Tone { case info, success, warning, danger }",
    "    var tone: Tone = .info",
    "    var small = false",
    "    @Environment(\\.accessibilityReduceMotion) private var reduceMotion",
    "",
    "    func makeBody(configuration: Configuration) -> some View {",
    "        let fraction = configuration.fractionCompleted ?? 0",
    "        return VStack(alignment: .leading, spacing: Plenix.Space.spaceStackXs) {",
    "            HStack(spacing: Plenix.Space.spaceInlineSm) {",
    "                configuration.label",
    "                    .font(Plenix.Font.sans(Plenix.Platform.textLabelSize, relativeTo: .subheadline).weight(.semibold))",
    "                    .foregroundStyle(Plenix.Colors.contentDefault)",
    "                Spacer()",
    "                configuration.currentValueLabel",
    "                    .font(Plenix.Font.mono(Plenix.Platform.textDataSize, relativeTo: .footnote))",
    "                    .foregroundStyle(Plenix.Colors.contentMuted)",
    "            }",
    "            GeometryReader { proxy in",
    "                ZStack(alignment: .leading) {",
    "                    Capsule().fill(Plenix.Colors.fillNeutral)",
    "                    Capsule().fill(fill).frame(width: proxy.size.width * fraction)",
    "                }",
    "            }",
    "            .frame(height: small ? Plenix.Space.spaceInsetXs : Plenix.Component.progressBarTrackHeight)",
    "            .animation(reduceMotion ? nil : .easeInOut(duration: Plenix.Component.progressBarFillDuration), value: fraction)",
    "        }",
    "        .accessibilityElement(children: .combine)",
    "        .accessibilityValue(Text(fraction, format: .percent))",
    "    }",
    "",
    "    private var fill: Color {",
    "        switch tone {",
    "        case .info: Plenix.Colors.feedbackInfoSolid",
    "        case .success: Plenix.Colors.feedbackSuccessSolid",
    "        case .warning: Plenix.Colors.feedbackWarningSolid",
    "        case .danger: Plenix.Colors.feedbackDangerSolid",
    "        }",
    "    }",
    "}",
    "",
    "// In a view",
    "ProgressView(\"Uploading 12 photos\", value: done, total: 12) { } currentValueLabel: { Text(\"\\(Int(done)) of 12\") }",
    "    .progressViewStyle(PlenixProgressStyle())",
    "ProgressView().tint(Plenix.Colors.actionPrimaryBackground)          // unknown amount"
   ],
   "uikit": [
    "import UIKit",
    "import SwiftUI",
    "",
    "/// The Plenix progress bar and spinner on iOS in UIKit.",
    "let bar = UIProgressView(progressViewStyle: .default)",
    "bar.trackTintColor = UIColor(Plenix.Colors.fillNeutral)",
    "bar.progressTintColor = UIColor(Plenix.Colors.feedbackInfoSolid)",
    "bar.heightAnchor.constraint(equalToConstant: Plenix.Component.progressBarTrackHeight).isActive = true",
    "bar.layer.cornerRadius = Plenix.Component.progressBarTrackHeight / 2",
    "bar.clipsToBounds = true",
    "bar.subviews.forEach { $0.layer.cornerRadius = Plenix.Component.progressBarTrackHeight / 2; $0.clipsToBounds = true }",
    "bar.setProgress(0.6, animated: !UIAccessibility.isReduceMotionEnabled)",
    "",
    "let label = UILabel()",
    "label.text = \"Uploading 12 photos\"",
    "label.font = UIFontMetrics(forTextStyle: .subheadline).scaledFont(for: UIFont(name: \"DMSans-SemiBold\", size: Plenix.Platform.textLabelSize) ?? .preferredFont(forTextStyle: .subheadline))",
    "label.adjustsFontForContentSizeCategory = true",
    "label.textColor = UIColor(Plenix.Colors.contentDefault)",
    "let stack = UIStackView(arrangedSubviews: [label, bar])",
    "stack.axis = .vertical",
    "stack.spacing = Plenix.Space.spaceStackXs",
    "",
    "let spinner = UIActivityIndicatorView(style: .medium)",
    "spinner.color = UIColor(Plenix.Colors.actionPrimaryBackground)",
    "spinner.startAnimating()"
   ],
   "appkit": [
    "import AppKit",
    "import SwiftUI",
    "",
    "// The Plenix progress indicators on the Mac. A Mac Catalyst app uses the iOS tokens and the UIKit code above. A native",
    "// AppKit app needs a macOS build of PlenixTokens.swift (it uses UIColor today; the macOS build is not generated yet).",
    "let bar = NSProgressIndicator()",
    "bar.style = .bar",
    "bar.isIndeterminate = false",
    "bar.minValue = 0",
    "bar.maxValue = 12",
    "bar.doubleValue = 7",
    "",
    "let spinner = NSProgressIndicator()",
    "spinner.style = .spinning",
    "spinner.controlSize = .small                 // background work or a tight space; unlabeled",
    "spinner.startAnimation(nil)",
    "// The system draws both in the accent color; a bar in a Plenix tone color (NSColor(Plenix.Colors.feedbackInfoSolid))",
    "// is a custom-drawn NSView with two rounded rectangles."
   ]
  }
 }
