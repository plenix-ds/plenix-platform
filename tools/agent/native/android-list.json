  "code": {
   "compose": [
    "import androidx.compose.foundation.lazy.LazyColumn",
    "import androidx.compose.foundation.lazy.itemsIndexed",
    "import androidx.compose.foundation.selection.selectable",
    "import androidx.compose.material3.*",
    "import plenix.tokens.*",
    "",
    "// Sans: the DM Sans family (PlenixFonts.SANS), set once in the app theme, e.g.",
    "// val Sans = FontFamily(Font(GoogleFont(PlenixFonts.SANS), fontProvider, FontWeight.Normal), Font(GoogleFont(PlenixFonts.SANS), fontProvider, FontWeight.SemiBold), Font(GoogleFont(PlenixFonts.SANS), fontProvider, FontWeight.Bold))",
    "fun textRole(size: TextUnit, lineHeight: TextUnit, weight: Int) =",
    "    TextStyle(fontFamily = Sans, fontSize = size, lineHeight = lineHeight, fontWeight = FontWeight(weight))",
    "",
    "enum class Tone { Neutral, Success, Danger, Info, Warning }",
    "",
    "@Composable",
    "fun toneColor(tone: Tone): Color = when (tone) {",
    "    Tone.Neutral -> PlenixColors.contentMuted.current()",
    "    Tone.Success -> PlenixColors.feedbackSuccessContent.current()",
    "    Tone.Danger -> PlenixColors.feedbackDangerContent.current()",
    "    Tone.Info -> PlenixColors.feedbackInfoContent.current()",
    "    Tone.Warning -> PlenixColors.feedbackWarningContent.current()",
    "}",
    "",
    "/** The Plenix list row on Android: the Material 3 ListItem, styled with the Plenix tokens (package plenix.tokens). */",
    "@OptIn(ExperimentalMaterial3Api::class)",
    "@Composable",
    "fun PlenixListRow(",
    "    headline: String,",
    "    supporting: String? = null,",
    "    leading: (@Composable () -> Unit)? = null,",
    "    trailing: (@Composable () -> Unit)? = null,",
    "    selected: Boolean = false,",
    "    onClick: (() -> Unit)? = null,",
    ") {",
    "    val press = if (onClick != null) Modifier.selectable(selected = selected, onClick = onClick) else Modifier",
    "    CompositionLocalProvider(LocalRippleConfiguration provides RippleConfiguration(color = PlenixColors.statePressed.current())) {",
    "        ListItem(",
    "            headlineContent = { Text(headline, style = textRole(PlenixPlatform.textBodySize, PlenixPlatform.textBodyLineHeight, PlenixPlatform.textBodyWeight)) },",
    "            supportingContent = supporting?.let { { Text(it, style = textRole(PlenixPlatform.textSecondarySize, PlenixPlatform.textSecondaryLineHeight, PlenixPlatform.textSecondaryWeight)) } },",
    "            leadingContent = leading,",
    "            trailingContent = trailing,",
    "            modifier = press.heightIn(min = PlenixPlatform.controlTargetMin),",
    "            colors = ListItemDefaults.colors(",
    "                containerColor = if (selected) PlenixColors.stateSelected.current() else PlenixColors.surfaceDefault.current(),",
    "                headlineColor = if (selected) PlenixColors.selectedContent.current() else PlenixColors.contentDefault.current(),",
    "                supportingColor = PlenixColors.contentMuted.current(),",
    "                leadingIconColor = PlenixColors.contentMuted.current(),",
    "                trailingIconColor = PlenixColors.contentMuted.current(),",
    "                disabledHeadlineColor = PlenixColors.contentDisabled.current(),",
    "            ),",
    "        )",
    "    }",
    "}",
    "",
    "// A list of records that open",
    "LazyColumn {",
    "    itemsIndexed(records) { i, r ->",
    "        PlenixListRow(r.name, supporting = r.meta, selected = r.id == openId, onClick = { open(r) })",
    "        if (i < records.lastIndex) HorizontalDivider(thickness = PlenixComponent.activityListItemBorderBottomWidth, color = PlenixColors.borderDivider.current())",
    "    }",
    "}",
    "",
    "// A statement with a tone icon (not clickable)",
    "PlenixListRow(\"Use it for one record per row\", leading = {",
    "    Icon(Icons.Sharp.CheckCircle, contentDescription = null, Modifier.size(PlenixPlatform.controlIconStandard), tint = toneColor(Tone.Success))",
    "})"
   ],
   "views": [
    "import android.content.res.ColorStateList",
    "import android.graphics.drawable.*",
    "import com.google.android.material.divider.MaterialDividerItemDecoration",
    "import plenix.tokens.*",
    "",
    "// Views read the same values from the generated plenix.tokens package through three helpers:",
    "fun Context.argb(light: Color, dark: Color): Int {",
    "    val night = (resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES",
    "    return (if (night) dark else light).toArgb()",
    "}",
    "fun Context.px(dp: Dp): Int = (dp.value * resources.displayMetrics.density).roundToInt()",
    "fun TextView.textRole(size: TextUnit, lineHeight: TextUnit, @FontRes font: Int) {",
    "    typeface = ResourcesCompat.getFont(context, font)   // R.font.dm_sans_*: DM Sans (PlenixFonts.SANS) bundled with the app",
    "    setTextSize(TypedValue.COMPLEX_UNIT_SP, size.value)",
    "    TextViewCompat.setLineHeight(this, TypedValue.COMPLEX_UNIT_SP, lineHeight.value)",
    "}",
    "",
    "/** Styles one list row (res/layout/row.xml: headline, supporting and time TextViews) with the Plenix tokens. */",
    "fun styleRow(row: View, headline: TextView, supporting: TextView?) {",
    "    val c = row.context",
    "    row.minimumHeight = c.px(PlenixPlatform.controlTargetMin)",
    "    row.setPaddingRelative(c.px(PlenixSpace.spaceInsetLg), c.px(PlenixSpace.spaceInsetSm), c.px(PlenixSpace.spaceInsetLg), c.px(PlenixSpace.spaceInsetSm))",
    "    val fill = StateListDrawable().apply {",
    "        addState(intArrayOf(android.R.attr.state_activated), ColorDrawable(c.argb(PlenixColors.stateSelected.light, PlenixColors.stateSelected.dark)))",
    "        addState(intArrayOf(android.R.attr.state_hovered), ColorDrawable(c.argb(PlenixColors.stateHover.light, PlenixColors.stateHover.dark)))",
    "        addState(intArrayOf(), ColorDrawable(c.argb(PlenixColors.surfaceDefault.light, PlenixColors.surfaceDefault.dark)))",
    "    }",
    "    row.background = RippleDrawable(ColorStateList.valueOf(c.argb(PlenixColors.statePressed.light, PlenixColors.statePressed.dark)), fill, null)",
    "    headline.textRole(PlenixPlatform.textBodySize, PlenixPlatform.textBodyLineHeight, R.font.dm_sans_regular)",
    "    headline.setTextColor(ColorStateList(",
    "        arrayOf(intArrayOf(android.R.attr.state_activated), intArrayOf(-android.R.attr.state_enabled), intArrayOf()),",
    "        intArrayOf(c.argb(PlenixColors.selectedContent.light, PlenixColors.selectedContent.dark),",
    "            c.argb(PlenixColors.contentDisabled.light, PlenixColors.contentDisabled.dark),",
    "            c.argb(PlenixColors.contentDefault.light, PlenixColors.contentDefault.dark))))",
    "    supporting?.textRole(PlenixPlatform.textSecondarySize, PlenixPlatform.textSecondaryLineHeight, R.font.dm_sans_regular)",
    "    supporting?.setTextColor(c.argb(PlenixColors.contentMuted.light, PlenixColors.contentMuted.dark))",
    "}",
    "",
    "// In the adapter: styleRow(itemView, headline, supporting); itemView.isActivated = item.id == openId",
    "recycler.addItemDecoration(MaterialDividerItemDecoration(context, LinearLayoutManager.VERTICAL).apply {",
    "    dividerColor = context.argb(PlenixColors.borderDivider.light, PlenixColors.borderDivider.dark)",
    "    dividerThickness = context.px(PlenixComponent.activityListItemBorderBottomWidth)",
    "    isLastItemDecorated = false",
    "})"
   ]
  }
 }
