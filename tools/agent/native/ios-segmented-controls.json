  "code": {
   "swiftui": [
    "import SwiftUI",
    "",
    "/// The Plenix segmented control on iOS: the system segmented Picker with the Plenix appearance (PlenixTokens.swift).",
    "enum PlenixSegmented {",
    "    /// Call once at launch; SwiftUI’s segmented Picker is drawn by UISegmentedControl.",
    "    static func applyAppearance() {",
    "        let control = UISegmentedControl.appearance()",
    "        control.backgroundColor = UIColor(Plenix.Colors.fillNeutral)",
    "        control.selectedSegmentTintColor = UIColor(Plenix.Colors.surfaceRaised)",
    "        let base = UIFont(name: \"DMSans-Medium\", size: Plenix.Platform.textLabelSize) ?? .preferredFont(forTextStyle: .subheadline)",
    "        let font = UIFontMetrics(forTextStyle: .subheadline).scaledFont(for: base)",
    "        control.setTitleTextAttributes([.font: font, .foregroundColor: UIColor(Plenix.Colors.contentMuted)], for: .normal)",
    "        control.setTitleTextAttributes([.font: font, .foregroundColor: UIColor(Plenix.Colors.contentDefault)], for: .selected)",
    "        control.setTitleTextAttributes([.foregroundColor: UIColor(Plenix.Colors.contentDisabled)], for: .disabled)",
    "    }",
    "}",
    "",
    "// In a view",
    "Picker(\"View\", selection: $view) {",
    "    Text(\"Grid\").tag(LibraryView.grid)",
    "    Text(\"List\").tag(LibraryView.list)",
    "    Text(\"Map\").tag(LibraryView.map)",
    "}",
    ".pickerStyle(.segmented)",
    ".controlSize(.large)",
    ".frame(minHeight: Plenix.Platform.controlTargetMin)"
   ],
   "uikit": [
    "import UIKit",
    "import SwiftUI",
    "",
    "/// The Plenix segmented control in UIKit.",
    "let control = UISegmentedControl(items: [\"Grid\", \"List\", \"Map\"])",
    "control.selectedSegmentIndex = 0",
    "control.apportionsSegmentWidthsByContent = false",
    "control.backgroundColor = UIColor(Plenix.Colors.fillNeutral)",
    "control.selectedSegmentTintColor = UIColor(Plenix.Colors.surfaceRaised)",
    "let font = UIFontMetrics(forTextStyle: .subheadline)",
    "    .scaledFont(for: UIFont(name: \"DMSans-Medium\", size: Plenix.Platform.textLabelSize) ?? .preferredFont(forTextStyle: .subheadline))",
    "control.setTitleTextAttributes([.font: font, .foregroundColor: UIColor(Plenix.Colors.contentMuted)], for: .normal)",
    "control.setTitleTextAttributes([.font: font, .foregroundColor: UIColor(Plenix.Colors.contentDefault)], for: .selected)",
    "control.heightAnchor.constraint(greaterThanOrEqualToConstant: Plenix.Platform.controlTargetMin).isActive = true",
    "control.addAction(UIAction { _ in show(control.selectedSegmentIndex) }, for: .valueChanged)"
   ],
   "appkit": [
    "import AppKit",
    "import SwiftUI",
    "",
    "// The Plenix segmented control on the Mac. A Mac Catalyst app uses the iOS tokens and the UIKit code above.",
    "// A native AppKit app needs a macOS build of PlenixTokens.swift (it uses UIColor today; the macOS build is not generated yet). With it:",
    "let control = NSSegmentedControl(labels: [\"Grid\", \"List\", \"Map\"], trackingMode: .selectOne, target: self, action: #selector(viewChanged(_:)))",
    "control.segmentDistribution = .fillEqually",
    "control.controlSize = .large",
    "control.font = NSFont(name: \"DMSans-Medium\", size: NSFont.systemFontSize)",
    "control.selectedSegmentBezelColor = NSColor(Plenix.Colors.surfaceRaised)"
   ]
  }
 }
