  "code": {
   "compose": [
    "import androidx.compose.foundation.layout.heightIn",
    "import androidx.compose.foundation.shape.RoundedCornerShape",
    "import androidx.compose.material3.*",
    "import androidx.compose.runtime.Composable",
    "import androidx.compose.ui.Modifier",
    "import androidx.compose.ui.text.TextStyle",
    "import androidx.compose.ui.text.font.*",
    "import androidx.compose.ui.unit.dp",
    "import plenix.tokens.*",
    "",
    "// DM Sans (PlenixFonts.SANS), bundled in res/font",
    "val DmSans = FontFamily(Font(R.font.dm_sans_regular), Font(R.font.dm_sans_medium, FontWeight.Medium), Font(R.font.dm_sans_semibold, FontWeight.SemiBold), Font(R.font.dm_sans_bold, FontWeight.Bold))",
    "",
    "fun labelStyle(weight: FontWeight) = TextStyle(fontFamily = DmSans, fontSize = PlenixPlatform.textLabelSize, lineHeight = PlenixPlatform.textLabelLineHeight, fontWeight = weight)",
    "",
    "/** Plenix tabs on Android: Material 3’s primary tabs, styled with the generated Plenix tokens. */",
    "@OptIn(ExperimentalMaterial3Api::class)",
    "@Composable",
    "fun PlenixTabs(titles: List<String>, selected: Int, onSelect: (Int) -> Unit) {",
    "    PrimaryTabRow(",
    "        selectedTabIndex = selected,",
    "        containerColor = PlenixColors.surfaceDefault.current(),",
    "        indicator = {",
    "            TabRowDefaults.PrimaryIndicator(",
    "                Modifier.tabIndicatorOffset(selected, matchContentSize = true),",
    "                color = PlenixColors.selectedContent.current(),",
    "            )",
    "        },",
    "        divider = { HorizontalDivider(thickness = PlenixBorder.borderWidthThin, color = PlenixColors.borderDivider.current()) },",
    "    ) {",
    "        titles.forEachIndexed { i, title ->",
    "            Tab(",
    "                selected = i == selected,",
    "                onClick = { onSelect(i) },",
    "                selectedContentColor = PlenixColors.contentDefault.current(),",
    "                unselectedContentColor = PlenixColors.contentMuted.current(),",
    "                modifier = Modifier.heightIn(min = PlenixPlatform.controlTargetMin),",
    "                text = { Text(title, maxLines = 1, style = labelStyle(if (i == selected) FontWeight.SemiBold else FontWeight.Medium)) },",
    "            )",
    "        }",
    "    }",
    "}",
    "",
    "/** The Plenix segmented control on Android: Material 3’s single-choice segmented buttons. */",
    "@OptIn(ExperimentalMaterial3Api::class)",
    "@Composable",
    "fun PlenixSegmentedControl(options: List<String>, selected: Int, onSelect: (Int) -> Unit) {",
    "    val border = PlenixColors.controlBorder.current()",
    "    SingleChoiceSegmentedButtonRow {",
    "        options.forEachIndexed { i, option ->",
    "            SegmentedButton(",
    "                selected = i == selected,",
    "                onClick = { onSelect(i) },",
    "                shape = SegmentedButtonDefaults.itemShape(index = i, count = options.size, baseShape = RoundedCornerShape(PlenixRadius.radiusControl)),",
    "                colors = SegmentedButtonDefaults.colors(",
    "                    activeContainerColor = PlenixColors.surfaceRaised.current(),",
    "                    activeContentColor = PlenixColors.contentDefault.current(),",
    "                    activeBorderColor = border,",
    "                    inactiveContainerColor = PlenixColors.fillNeutral.current(),",
    "                    inactiveContentColor = PlenixColors.contentMuted.current(),",
    "                    inactiveBorderColor = border,",
    "                ),",
    "                icon = {},",
    "                label = { Text(option, style = labelStyle(FontWeight.Medium)) },",
    "            )",
    "        }",
    "    }",
    "}"
   ],
   "views": [
    "<!-- res/layout: tabs over a ViewPager2 -->",
    "<com.google.android.material.tabs.TabLayout",
    "    android:id=\"@+id/tabs\"",
    "    android:layout_width=\"match_parent\"",
    "    android:layout_height=\"wrap_content\"",
    "    app:tabMode=\"fixed\"",
    "    app:tabIndicatorFullWidth=\"false\"",
    "    app:tabTextAppearance=\"@style/TextAppearance.App.PlenixTab\"",
    "    app:tabSelectedTextAppearance=\"@style/TextAppearance.App.PlenixTabSelected\" />",
    "<com.google.android.material.divider.MaterialDivider",
    "    android:id=\"@+id/tabs_line\"",
    "    android:layout_width=\"match_parent\"",
    "    android:layout_height=\"wrap_content\" />",
    "<androidx.viewpager2.widget.ViewPager2",
    "    android:id=\"@+id/pager\"",
    "    android:layout_width=\"match_parent\"",
    "    android:layout_height=\"0dp\"",
    "    android:layout_weight=\"1\" />",
    "",
    "<!-- the segmented control -->",
    "<com.google.android.material.button.MaterialButtonToggleGroup",
    "    android:id=\"@+id/view_mode\"",
    "    android:layout_width=\"wrap_content\"",
    "    android:layout_height=\"wrap_content\"",
    "    app:singleSelection=\"true\"",
    "    app:selectionRequired=\"true\"",
    "    app:checkedButton=\"@id/view_list\">",
    "    <com.google.android.material.button.MaterialButton",
    "        android:id=\"@+id/view_list\"",
    "        style=\"?attr/materialButtonOutlinedStyle\"",
    "        android:layout_width=\"wrap_content\"",
    "        android:layout_height=\"wrap_content\"",
    "        android:text=\"List\" />",
    "    <com.google.android.material.button.MaterialButton",
    "        android:id=\"@+id/view_grid\"",
    "        style=\"?attr/materialButtonOutlinedStyle\"",
    "        android:layout_width=\"wrap_content\"",
    "        android:layout_height=\"wrap_content\"",
    "        android:text=\"Grid\" />",
    "</com.google.android.material.button.MaterialButtonToggleGroup>",
    "",
    "<!-- res/values/styles.xml: the label role, 14 sp = PlenixPlatform.textLabelSize -->",
    "<style name=\"TextAppearance.App.PlenixTab\" parent=\"TextAppearance.Material3.TitleSmall\">",
    "    <item name=\"fontFamily\">@font/dm_sans_medium</item>",
    "    <!-- textSize: from the Material 3 parent (TitleSmall), the size PlenixPlatform.textLabelSize names -->",
    "</style>",
    "<style name=\"TextAppearance.App.PlenixTabSelected\" parent=\"TextAppearance.App.PlenixTab\">",
    "    <item name=\"fontFamily\">@font/dm_sans_semibold</item>",
    "</style>",
    "",
    "// Kotlin. Views take ARGB ints and pixels: a Plenix color for the current appearance, a Plenix dp in pixels",
    "fun Context.argb(light: Color, dark: Color): Int =",
    "    (if ((resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES) dark else light).toArgb()",
    "fun Context.px(dp: Dp): Float = dp.value * resources.displayMetrics.density",
    "",
    "tabs.setBackgroundColor(argb(PlenixColors.surfaceDefault.light, PlenixColors.surfaceDefault.dark))",
    "tabs.setTabTextColors(argb(PlenixColors.contentMuted.light, PlenixColors.contentMuted.dark), argb(PlenixColors.contentDefault.light, PlenixColors.contentDefault.dark))",
    "tabs.setSelectedTabIndicatorColor(argb(PlenixColors.selectedContent.light, PlenixColors.selectedContent.dark))",
    "tabsLine.dividerColor = argb(PlenixColors.borderDivider.light, PlenixColors.borderDivider.dark)",
    "TabLayoutMediator(tabs, pager) { tab, i -> tab.text = titles[i] }.attach()",
    "",
    "val checked = intArrayOf(android.R.attr.state_checked)",
    "val dmSans = ResourcesCompat.getFont(this, R.font.dm_sans_medium)",
    "listOf(viewList, viewGrid).forEach { b ->",
    "    b.backgroundTintList = ColorStateList(arrayOf(checked, intArrayOf()),",
    "        intArrayOf(argb(PlenixColors.surfaceRaised.light, PlenixColors.surfaceRaised.dark), argb(PlenixColors.fillNeutral.light, PlenixColors.fillNeutral.dark)))",
    "    b.setTextColor(ColorStateList(arrayOf(checked, intArrayOf()),",
    "        intArrayOf(argb(PlenixColors.contentDefault.light, PlenixColors.contentDefault.dark), argb(PlenixColors.contentMuted.light, PlenixColors.contentMuted.dark))))",
    "    b.strokeColor = ColorStateList.valueOf(argb(PlenixColors.controlBorder.light, PlenixColors.controlBorder.dark))",
    "    b.shapeAppearanceModel = b.shapeAppearanceModel.withCornerSize(px(PlenixRadius.radiusControl))",
    "    b.typeface = dmSans",
    "    b.setTextSize(TypedValue.COMPLEX_UNIT_SP, PlenixPlatform.textLabelSize.value)",
    "}",
    "viewMode.addOnButtonCheckedListener { _, id, isChecked -> if (isChecked) showMode(id) }"
   ]
  }
 }
}
