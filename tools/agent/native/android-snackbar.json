  "code": {
   "compose": [
    "import androidx.compose.material3.*",
    "import plenix.tokens.*",
    "",
    "// Sans: the DM Sans family (PlenixFonts.SANS), set once in the app theme, e.g.",
    "// val Sans = FontFamily(Font(GoogleFont(PlenixFonts.SANS), fontProvider, FontWeight.Normal), Font(GoogleFont(PlenixFonts.SANS), fontProvider, FontWeight.SemiBold), Font(GoogleFont(PlenixFonts.SANS), fontProvider, FontWeight.Bold))",
    "fun textRole(size: TextUnit, lineHeight: TextUnit, weight: Int) =",
    "    TextStyle(fontFamily = Sans, fontSize = size, lineHeight = lineHeight, fontWeight = FontWeight(weight))",
    "",
    "enum class Tone { Info, Success, Warning, Danger }",
    "",
    "/** What a Plenix snackbar shows: Material’s SnackbarVisuals with a tone. */",
    "class PlenixSnackbarVisuals(",
    "    override val message: String,",
    "    val tone: Tone = Tone.Info,",
    "    override val actionLabel: String? = null,",
    ") : SnackbarVisuals {",
    "    override val withDismissAction = tone == Tone.Danger",
    "    override val duration = if (tone == Tone.Danger) SnackbarDuration.Indefinite else SnackbarDuration.Short",
    "}",
    "",
    "@Composable",
    "private fun toneEdge(tone: Tone): Color = when (tone) {",
    "    Tone.Info -> PlenixColors.feedbackInfoSolid.current()",
    "    Tone.Success -> PlenixColors.feedbackSuccessSolid.current()",
    "    Tone.Warning -> PlenixColors.feedbackWarningSolid.current()",
    "    Tone.Danger -> PlenixColors.feedbackDangerSolid.current()",
    "}",
    "private fun toneIcon(tone: Tone) = when (tone) {",
    "    Tone.Info -> Icons.Sharp.Info; Tone.Success -> Icons.Sharp.CheckCircle",
    "    Tone.Warning -> Icons.Sharp.Warning; Tone.Danger -> Icons.Sharp.Error",
    "}",
    "",
    "/** The Plenix snackbar host: Material 3 Snackbars styled with the Plenix toast tokens (package plenix.tokens). */",
    "@Composable",
    "fun PlenixSnackbarHost(hostState: SnackbarHostState) {",
    "    SnackbarHost(hostState) { data ->",
    "        val tone = (data.visuals as? PlenixSnackbarVisuals)?.tone ?: Tone.Info",
    "        val shape = RoundedCornerShape(PlenixRadius.radiusSurface4px)",
    "        val edge = toneEdge(tone)",
    "        val content = PlenixColors.toastContent.current()",
    "        Snackbar(",
    "            modifier = Modifier.padding(PlenixSpace.spaceInsetLg).clip(shape)",
    "                .drawWithContent {",
    "                    drawContent()",
    "                    val w = PlenixComponent.toastBorderInlineStartWidth.toPx()",
    "                    drawRect(edge, topLeft = Offset(if (layoutDirection == LayoutDirection.Rtl) size.width - w else 0f, 0f), size = Size(w, size.height))",
    "                }",
    "                .semantics { if (tone == Tone.Danger) liveRegion = LiveRegionMode.Assertive },",
    "            action = data.visuals.actionLabel?.let { label -> {",
    "                TextButton(onClick = { data.performAction() }, colors = ButtonDefaults.textButtonColors(contentColor = content)) {",
    "                    Text(label, style = textRole(PlenixPlatform.textLabelSize, PlenixPlatform.textLabelLineHeight, PlenixPlatform.textLabelWeight))",
    "                }",
    "            } },",
    "            dismissAction = if (data.visuals.withDismissAction) { {",
    "                IconButton(onClick = { data.dismiss() }) { Icon(Icons.Sharp.Close, contentDescription = \"Dismiss\", tint = content.copy(alpha = PlenixComponent.toastCloseOpacity)) }",
    "            } } else null,",
    "            shape = shape,",
    "            containerColor = PlenixColors.toastBackground.current(),",
    "            contentColor = content,",
    "        ) {",
    "            Row(horizontalArrangement = Arrangement.spacedBy(PlenixSpace.spaceInlineMd), verticalAlignment = Alignment.CenterVertically) {",
    "                Icon(toneIcon(tone), contentDescription = null, Modifier.size(PlenixPlatform.controlIconStandard))",
    "                Text(data.visuals.message, style = textRole(PlenixPlatform.textSecondarySize, PlenixPlatform.textSecondaryLineHeight, PlenixPlatform.textSecondaryWeight))",
    "            }",
    "        }",
    "    }",
    "}",
    "",
    "// In a screen",
    "val hostState = remember { SnackbarHostState() }",
    "Scaffold(snackbarHost = { PlenixSnackbarHost(hostState) }) { … }",
    "scope.launch {",
    "    val result = hostState.showSnackbar(PlenixSnackbarVisuals(\"3 assets deleted\", actionLabel = \"Undo\"))",
    "    if (result == SnackbarResult.ActionPerformed) undoDelete()",
    "}"
   ],
   "views": [
    "import android.content.res.ColorStateList",
    "import android.graphics.drawable.*",
    "import com.google.android.material.shape.*",
    "import com.google.android.material.snackbar.Snackbar",
    "import plenix.tokens.*",
    "",
    "// Views read the same values from the generated plenix.tokens package through three helpers:",
    "fun Context.argb(light: Color, dark: Color): Int {",
    "    val night = (resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES",
    "    return (if (night) dark else light).toArgb()",
    "}",
    "fun Context.px(dp: Dp): Int = (dp.value * resources.displayMetrics.density).roundToInt()",
    "fun TextView.textRole(size: TextUnit, lineHeight: TextUnit, @FontRes font: Int) {",
    "    typeface = ResourcesCompat.getFont(context, font)   // R.font.dm_sans_*: DM Sans (PlenixFonts.SANS) bundled with the app",
    "    setTextSize(TypedValue.COMPLEX_UNIT_SP, size.value)",
    "    TextViewCompat.setLineHeight(this, TypedValue.COMPLEX_UNIT_SP, lineHeight.value)",
    "}",
    "",
    "enum class Tone { Info, Success, Warning, Danger }",
    "",
    "/** A Material Snackbar styled with the Plenix toast tokens. */",
    "fun plenixSnackbar(root: View, message: String, tone: Tone = Tone.Info, action: String? = null, onAction: () -> Unit = {}): Snackbar {",
    "    val c = root.context",
    "    val danger = tone == Tone.Danger",
    "    val bar = Snackbar.make(root, message, if (danger) Snackbar.LENGTH_INDEFINITE else PlenixComponent.toastDuration)",
    "    val content = c.argb(PlenixColors.toastContent.light, PlenixColors.toastContent.dark)",
    "    val shape = MaterialShapeDrawable(ShapeAppearanceModel.builder().setAllCornerSizes(c.px(PlenixRadius.radiusSurface4px).toFloat()).build()).apply {",
    "        fillColor = ColorStateList.valueOf(c.argb(PlenixColors.toastBackground.light, PlenixColors.toastBackground.dark))",
    "    }",
    "    val edgeColor = when (tone) {",
    "        Tone.Info -> PlenixColors.feedbackInfoSolid.light",
    "        Tone.Success -> PlenixColors.feedbackSuccessSolid.light",
    "        Tone.Warning -> PlenixColors.feedbackWarningSolid.light",
    "        Tone.Danger -> PlenixColors.feedbackDangerSolid.light",
    "    }   // the solid tone colors are the same in light and dark",
    "    bar.view.background = LayerDrawable(arrayOf(shape, ColorDrawable(edgeColor.toArgb()))).apply {",
    "        setLayerWidth(1, c.px(PlenixComponent.toastBorderInlineStartWidth))",
    "        setLayerGravity(1, Gravity.START or Gravity.FILL_VERTICAL)",
    "    }",
    "    bar.view.findViewById<TextView>(com.google.android.material.R.id.snackbar_text).apply {",
    "        textRole(PlenixPlatform.textSecondarySize, PlenixPlatform.textSecondaryLineHeight, R.font.dm_sans_regular)",
    "        setCompoundDrawablesRelativeWithIntrinsicBounds(toneIconRes(tone), 0, 0, 0)   // 20 dp Material Symbols Sharp drawables",
    "        compoundDrawablePadding = c.px(PlenixSpace.spaceInlineMd)",
    "        TextViewCompat.setCompoundDrawableTintList(this, ColorStateList.valueOf(content))",
    "    }",
    "    bar.setTextColor(content)",
    "    bar.setActionTextColor(content)",
    "    when {",
    "        action != null -> bar.setAction(action) { onAction() }",
    "        danger -> bar.setAction(\"Dismiss\") { bar.dismiss() }",
    "    }",
    "    if (danger) bar.view.accessibilityLiveRegion = View.ACCESSIBILITY_LIVE_REGION_ASSERTIVE",
    "    return bar",
    "}",
    "",
    "plenixSnackbar(root, \"3 assets deleted\", action = \"Undo\") { undoDelete() }.show()"
   ]
  }
 }
}
