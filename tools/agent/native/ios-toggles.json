  "code": {
   "swiftui": [
    "import SwiftUI",
    "",
    "/// The Plenix switch on iOS: the system Toggle in a list row, with the Plenix accent and label (PlenixTokens.swift).",
    "struct PlenixSwitchRow: View {",
    "    let title: String",
    "    @Binding var isOn: Bool",
    "",
    "    var body: some View {",
    "        Toggle(isOn: $isOn) {",
    "            Text(title)",
    "                .font(Plenix.Font.sans(Plenix.Platform.textBodySize, relativeTo: .body))",
    "                .foregroundStyle(Plenix.Colors.contentDefault)",
    "        }",
    "        .toggleStyle(.switch)",
    "        .tint(Plenix.Colors.actionPrimaryBackground)",
    "        .frame(minHeight: Plenix.Platform.switchMinHeight)",
    "    }",
    "}",
    "",
    "// In a view",
    "Form { PlenixSwitchRow(title: \"Sync over cellular\", isOn: $syncOverCellular) }"
   ],
   "uikit": [
    "import UIKit",
    "import SwiftUI",
    "",
    "/// The Plenix switch in UIKit: a UISwitch as the accessory of a list row.",
    "let toggle = UISwitch()",
    "toggle.onTintColor = UIColor(Plenix.Colors.actionPrimaryBackground)",
    "toggle.addAction(UIAction { action in",
    "    settings.syncOverCellular = (action.sender as? UISwitch)?.isOn ?? false",
    "}, for: .valueChanged)",
    "",
    "var content = cell.defaultContentConfiguration()",
    "content.text = \"Sync over cellular\"",
    "content.textProperties.font = UIFontMetrics(forTextStyle: .body)",
    "    .scaledFont(for: UIFont(name: \"DMSans-Regular\", size: Plenix.Platform.textBodySize) ?? .preferredFont(forTextStyle: .body))",
    "content.textProperties.color = UIColor(Plenix.Colors.contentDefault)",
    "cell.contentConfiguration = content",
    "cell.accessoryView = toggle"
   ],
   "appkit": [
    "import AppKit",
    "import SwiftUI",
    "",
    "// The Plenix switch on the Mac. A Mac Catalyst app uses the iOS tokens and the UIKit code above.",
    "// A native AppKit app needs a macOS build of PlenixTokens.swift (it uses UIColor today; the macOS build is not generated yet). With it:",
    "let toggle = NSSwitch()",
    "toggle.state = .on",
    "toggle.target = self",
    "toggle.action = #selector(syncChanged(_:))",
    "let label = NSTextField(labelWithString: \"Sync over cellular\")",
    "label.font = NSFont(name: \"DMSans-Regular\", size: NSFont.systemFontSize)",
    "label.textColor = NSColor(Plenix.Colors.contentDefault)",
    "// NSSwitch draws the system accent color; a checkbox suits single rows in a grouped form:",
    "let check = NSButton(checkboxWithTitle: \"Sync over cellular\", target: self, action: #selector(syncChanged(_:)))"
   ]
  }
 }
