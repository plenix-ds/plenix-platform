  "code": {
   "swiftui": [
    "import SwiftUI",
    "",
    "/// The Plenix toolbar on iOS: the system toolbar with Plenix type and item colors.",
    "AssetDetail(asset: asset)",
    "    .navigationBarTitleDisplayMode(.inline)",
    "    .toolbar {",
    "        ToolbarItem(placement: .principal) {",
    "            Text(asset.name)",
    "                .font(Plenix.Font.sans(Plenix.Platform.textHeadingSize, relativeTo: .headline).weight(.semibold))",
    "                .foregroundStyle(Plenix.Colors.contentDefault)",
    "        }",
    "        ToolbarItemGroup(placement: .topBarTrailing) {",
    "            Button(\"Share\", systemImage: \"square.and.arrow.up\", action: share)",
    "            Menu(\"More\", systemImage: \"ellipsis\") { moreActions }",
    "        }",
    "        ToolbarItemGroup(placement: .bottomBar) {",
    "            Button(\"Favorite\", systemImage: \"heart\", action: favorite)",
    "            ToolbarSpacer(.flexible, placement: .bottomBar)",
    "            Button(\"Delete\", systemImage: \"trash\", role: .destructive, action: delete)",
    "        }",
    "    }",
    "    .tint(Plenix.Colors.contentDefault)"
   ],
   "uikit": [
    "import UIKit",
    "import SwiftUI",
    "",
    "/// The Plenix toolbar on iOS in UIKit: the system bars with Plenix type and item colors.",
    "let appearance = UINavigationBarAppearance()",
    "appearance.configureWithDefaultBackground()",
    "let heading = UIFont(name: \"DMSans-SemiBold\", size: Plenix.Platform.textHeadingSize) ?? .preferredFont(forTextStyle: .headline)",
    "let title = UIFont(name: \"DMSans-Bold\", size: Plenix.Platform.textTitleSize) ?? .preferredFont(forTextStyle: .largeTitle)",
    "appearance.titleTextAttributes = [.font: UIFontMetrics(forTextStyle: .headline).scaledFont(for: heading),",
    "                                  .foregroundColor: UIColor(Plenix.Colors.contentDefault)]",
    "appearance.largeTitleTextAttributes = [.font: UIFontMetrics(forTextStyle: .largeTitle).scaledFont(for: title),",
    "                                       .foregroundColor: UIColor(Plenix.Colors.contentDefault)]",
    "navigationController.navigationBar.standardAppearance = appearance",
    "navigationController.navigationBar.tintColor = UIColor(Plenix.Colors.contentDefault)",
    "",
    "navigationItem.rightBarButtonItems = [",
    "    UIBarButtonItem(image: UIImage(systemName: \"ellipsis\"), menu: moreMenu),",
    "    UIBarButtonItem(systemItem: .action, primaryAction: UIAction { _ in share() })",
    "]",
    "setToolbarItems([",
    "    UIBarButtonItem(image: UIImage(systemName: \"heart\"), primaryAction: UIAction { _ in favorite() }),",
    "    .flexibleSpace(),",
    "    UIBarButtonItem(systemItem: .trash, primaryAction: UIAction { _ in delete() })",
    "], animated: false)",
    "navigationController.isToolbarHidden = false"
   ],
   "appkit": [
    "import AppKit",
    "import SwiftUI",
    "",
    "// The Plenix toolbar on the Mac: the window’s NSToolbar, every command also in the menu bar. A Mac Catalyst app uses",
    "// the UIKit code above. A native AppKit app needs a macOS build of PlenixTokens.swift (not generated yet).",
    "let toolbar = NSToolbar(identifier: \"asset\")",
    "toolbar.delegate = self",
    "toolbar.displayMode = .iconOnly",
    "toolbar.allowsUserCustomization = true",
    "window.toolbar = toolbar",
    "window.toolbarStyle = .unified"
   ]
  }
 }
