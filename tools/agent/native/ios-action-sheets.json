  "code": {
   "swiftui": [
    "import SwiftUI",
    "",
    "/// The system action sheet with the Plenix tint (its look is otherwise fixed).",
    "Button(\"Discard draft\") { confirming = true }",
    "    .confirmationDialog(\"Discard this draft?\", isPresented: $confirming, titleVisibility: .visible) {",
    "        Button(\"Discard\", role: .destructive, action: discard)",
    "        Button(\"Cancel\", role: .cancel) {}",
    "    }",
    "    .tint(Plenix.Colors.actionPrimaryBackground)",
    "",
    "/// The Plenix action sheet: a short bottom sheet drawn with the Plenix menu tokens.",
    "struct PlenixActionRow: ButtonStyle {",
    "    var destructive = false",
    "    func makeBody(configuration: Configuration) -> some View {",
    "        configuration.label",
    "            .font(Plenix.Font.sans(Plenix.Platform.textBodySize, relativeTo: .body))",
    "            .foregroundStyle(destructive ? Plenix.Colors.feedbackDangerContent : Plenix.Colors.contentDefault)",
    "            .frame(maxWidth: .infinity, minHeight: Plenix.Platform.controlTargetMin)",
    "            .background(configuration.isPressed ? Plenix.Colors.statePressed : .clear)",
    "            .contentShape(.rect)",
    "    }",
    "}",
    "",
    ".sheet(isPresented: $choosing) {",
    "    VStack(spacing: 0) {",
    "        Button(\"Discard\", role: .destructive, action: discard).buttonStyle(PlenixActionRow(destructive: true))",
    "        Divider().overlay(Plenix.Colors.borderDivider)",
    "        Button(\"Save as draft\", action: save).buttonStyle(PlenixActionRow())",
    "        Divider().overlay(Plenix.Colors.borderDivider)",
    "        Button(\"Cancel\", role: .cancel) { choosing = false }.buttonStyle(PlenixActionRow())",
    "    }",
    "    .padding(Plenix.Space.spaceInsetSm)",
    "    .presentationDetents([.height(Plenix.Platform.controlTargetMin * 3 + Plenix.Space.spaceInsetSm * 2)])",
    "    .presentationBackground(Plenix.Colors.surfaceOverlay)",
    "    .presentationCornerRadius(Plenix.Radius.radiusMenu8px)",
    "}"
   ],
   "uikit": [
    "import UIKit",
    "import SwiftUI",
    "",
    "/// The system action sheet with the Plenix tint.",
    "let sheet = UIAlertController(title: \"Discard this draft?\", message: nil, preferredStyle: .actionSheet)",
    "sheet.addAction(UIAlertAction(title: \"Discard\", style: .destructive) { _ in discard() })",
    "sheet.addAction(UIAlertAction(title: \"Save as draft\", style: .default) { _ in save() })",
    "sheet.addAction(UIAlertAction(title: \"Cancel\", style: .cancel))",
    "sheet.view.tintColor = UIColor(Plenix.Colors.actionPrimaryBackground)",
    "sheet.popoverPresentationController?.sourceItem = sender   // iPad: a popover from the control",
    "present(sheet, animated: true)",
    "",
    "/// The Plenix action sheet: a short custom sheet.",
    "let choices = PlenixActionSheetController(actions: actions)   // rows: UIButton.Configuration.plenix(background: nil, content: Plenix.Colors.contentDefault)",
    "choices.view.backgroundColor = UIColor(Plenix.Colors.surfaceOverlay)",
    "if let s = choices.sheetPresentationController {",
    "    s.detents = [.custom { _ in Plenix.Platform.controlTargetMin * 3 + Plenix.Space.spaceInsetSm * 2 }]",
    "    s.preferredCornerRadius = Plenix.Radius.radiusMenu8px",
    "}",
    "present(choices, animated: true)"
   ],
   "appkit": [
    "import AppKit",
    "import SwiftUI",
    "",
    "// The Mac has no action sheet; the same choices are a menu from the control. A Mac Catalyst app uses the iOS tokens",
    "// and the UIKit code above. A native AppKit app needs a macOS build of PlenixTokens.swift (it uses UIColor today;",
    "// the macOS build is not generated yet).",
    "let menu = NSMenu()",
    "menu.addItem(NSMenuItem.sectionHeader(title: \"Discard this draft?\"))",
    "menu.addItem(withTitle: \"Discard\", action: #selector(discard(_:)), keyEquivalent: \"\")",
    "menu.addItem(withTitle: \"Save as draft\", action: #selector(save(_:)), keyEquivalent: \"\")",
    "menu.popUp(positioning: nil, at: NSPoint(x: 0, y: sender.bounds.height), in: sender)"
   ]
  }
 }
