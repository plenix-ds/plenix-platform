  "code": {
   "swiftui": [
    "import SwiftUI",
    "",
    "/// The Plenix list on iOS: the system List, styled with the Plenix tokens (PlenixTokens.swift).",
    "struct PlenixListRow: ViewModifier {",
    "    var selected = false",
    "    func body(content: Content) -> some View {",
    "        content",
    "            .font(Plenix.Font.sans(Plenix.Platform.textBodySize, relativeTo: .body).monospacedDigit())",
    "            .foregroundStyle(selected ? Plenix.Colors.dataTableRowSelectedText : Plenix.Colors.tableText)",
    "            .listRowBackground(selected ? Plenix.Colors.dataTableRowSelected : Plenix.Colors.tableSurface)",
    "            .listRowSeparatorTint(Plenix.Colors.tableLine)",
    "            .alignmentGuide(.listRowSeparatorLeading) { _ in 0 }   // Plenix table lines run the full width",
    "            .listRowInsets(EdgeInsets(top: 0, leading: Plenix.Space.spaceInsetLg, bottom: 0, trailing: Plenix.Space.spaceInsetLg))",
    "    }",
    "}",
    "",
    "struct FilesList: View {",
    "    @State private var files: [File]",
    "    var body: some View {",
    "        List {",
    "            Section {",
    "                ForEach(files) { file in",
    "                    NavigationLink(value: file) {",
    "                        VStack(alignment: .leading) {",
    "                            Text(file.name).truncationMode(.middle)",
    "                            Text(file.detail)",
    "                                .font(Plenix.Font.sans(Plenix.Platform.textSecondarySize, relativeTo: .footnote))",
    "                                .foregroundStyle(Plenix.Colors.tableTextMuted)",
    "                        }",
    "                        .frame(minHeight: Plenix.Platform.controlTargetMin, alignment: .leading)",
    "                    }",
    "                    .modifier(PlenixListRow())",
    "                    .swipeActions { Button(\"Delete\", role: .destructive) { delete(file) } }",
    "                }",
    "                .onMove { files.move(fromOffsets: $0, toOffset: $1) }",
    "            } header: {",
    "                Text(\"Recent files\")",
    "                    .font(Plenix.Font.sans(Plenix.Platform.textSecondarySize, relativeTo: .footnote).weight(.semibold))",
    "                    .foregroundStyle(Plenix.Colors.tableTextMuted)",
    "            }",
    "            Section {",
    "                Button(\"Delete all\", role: .destructive, action: deleteAll)",
    "                    .modifier(PlenixListRow())",
    "                    .foregroundStyle(Plenix.Colors.feedbackDangerContent)",
    "            }",
    "        }",
    "        .listStyle(.insetGrouped)",
    "        .scrollContentBackground(.hidden)",
    "        .background(Plenix.Colors.surfaceCanvas)",
    "        .environment(\\.defaultMinListRowHeight, Plenix.Platform.controlTargetMin)",
    "    }",
    "}"
   ],
   "uikit": [
    "import UIKit",
    "import SwiftUI",
    "",
    "/// The Plenix list on iOS in UIKit: a list layout with Plenix cell configurations.",
    "var config = UICollectionLayoutListConfiguration(appearance: .insetGrouped)",
    "config.backgroundColor = UIColor(Plenix.Colors.surfaceCanvas)",
    "config.headerMode = .supplementary",
    "config.separatorConfiguration.color = UIColor(Plenix.Colors.tableLine)",
    "config.separatorConfiguration.bottomSeparatorInsets = .zero   // Plenix table lines run the full width",
    "config.trailingSwipeActionsConfigurationProvider = { indexPath in",
    "    let delete = UIContextualAction(style: .destructive, title: \"Delete\") { _, _, done in remove(at: indexPath); done(true) }",
    "    delete.backgroundColor = UIColor(Plenix.Colors.actionDangerBackground)",
    "    return UISwipeActionsConfiguration(actions: [delete])",
    "}",
    "let layout = UICollectionViewCompositionalLayout.list(using: config)",
    "",
    "let title = UIFontMetrics(forTextStyle: .body).scaledFont(for: UIFont(name: \"DMSans-Regular\", size: Plenix.Platform.textBodySize) ?? .preferredFont(forTextStyle: .body))",
    "let subtitle = UIFontMetrics(forTextStyle: .footnote).scaledFont(for: UIFont(name: \"DMSans-Regular\", size: Plenix.Platform.textSecondarySize) ?? .preferredFont(forTextStyle: .footnote))",
    "let rows = UICollectionView.CellRegistration<UICollectionViewListCell, File> { cell, _, file in",
    "    cell.accessories = [.disclosureIndicator(options: .init(tintColor: UIColor(Plenix.Colors.tableTextMuted))), .reorder()]",
    "    cell.configurationUpdateHandler = { cell, state in",
    "        var content = UIListContentConfiguration.subtitleCell()",
    "        content.text = file.name",
    "        content.secondaryText = file.detail",
    "        content.textProperties.font = title",
    "        content.textProperties.lineBreakMode = .byTruncatingMiddle",
    "        content.textProperties.color = UIColor(state.isSelected ? Plenix.Colors.dataTableRowSelectedText : Plenix.Colors.tableText)",
    "        content.secondaryTextProperties.font = subtitle",
    "        content.secondaryTextProperties.color = UIColor(Plenix.Colors.tableTextMuted)",
    "        cell.contentConfiguration = content",
    "        var background = UIBackgroundConfiguration.listGroupedCell().updated(for: state)",
    "        background.backgroundColor = UIColor(state.isSelected ? Plenix.Colors.dataTableRowSelected : (state.isHighlighted ? Plenix.Colors.dataTableRowHover : Plenix.Colors.tableSurface))",
    "        cell.backgroundConfiguration = background",
    "    }",
    "}"
   ],
   "appkit": [
    "import AppKit",
    "import SwiftUI",
    "",
    "// The Plenix table on the Mac. A Mac Catalyst app uses the iOS tokens and the UIKit code above. A native AppKit app",
    "// needs a macOS build of PlenixTokens.swift (it uses UIColor today; the macOS build is not generated yet). With it:",
    "let table = NSTableView()",
    "table.style = .inset",
    "table.backgroundColor = NSColor(Plenix.Colors.tableSurface)",
    "table.gridColor = NSColor(Plenix.Colors.tableLine)",
    "table.gridStyleMask = [.solidHorizontalGridLineMask, .solidVerticalGridLineMask]",
    "table.usesAlternatingRowBackgroundColors = false",
    "table.allowsColumnResizing = true",
    "let name = NSTableColumn(identifier: .init(\"name\"))",
    "name.title = \"Name\"                          // short noun headings, no ending punctuation",
    "name.sortDescriptorPrototype = NSSortDescriptor(key: \"name\", ascending: true)",
    "table.addTableColumn(name)",
    "",
    "final class PlenixRowView: NSTableRowView {",
    "    override func drawSelection(in dirtyRect: NSRect) {",
    "        NSColor(Plenix.Colors.dataTableRowSelected).setFill()",
    "        bounds.fill()",
    "    }",
    "}"
   ]
  }
 }
