  "code": {
   "swiftui": [
    "import SwiftUI",
    "",
    "/// The Plenix slider on iOS: the system Slider with the Plenix accent, label and value (PlenixTokens.swift).",
    "struct PlenixSlider: View {",
    "    let title: String",
    "    @Binding var value: Double",
    "    var range: ClosedRange<Double> = 0...100",
    "    var step: Double = 1",
    "    var unit = \"%\"",
    "    var onCommit: (Double) -> Void = { _ in }",
    "",
    "    var body: some View {",
    "        VStack(alignment: .leading, spacing: Plenix.Space.spaceStackXs) {",
    "            HStack(spacing: Plenix.Space.spaceInlineSm) {",
    "                Text(title)",
    "                    .font(Plenix.Font.sans(Plenix.Platform.textLabelSize, relativeTo: .subheadline).weight(.semibold))",
    "                    .foregroundStyle(Plenix.Colors.contentDefault)",
    "                Spacer()",
    "                Text(\"\\(Int(value))\\(unit)\")",
    "                    .font(Plenix.Font.mono(Plenix.Platform.textDataSize, relativeTo: .footnote))",
    "                    .foregroundStyle(Plenix.Colors.contentMuted)",
    "            }",
    "            Slider(value: $value, in: range, step: step) { Text(title) } onEditingChanged: { editing in",
    "                if !editing { onCommit(value) }",
    "            }",
    "            .tint(Plenix.Colors.actionPrimaryBackground)",
    "            .frame(minHeight: Plenix.Platform.controlTargetMin)",
    "            .accessibilityValue(\"\\(Int(value))\\(unit)\")",
    "        }",
    "    }",
    "}"
   ],
   "uikit": [
    "import UIKit",
    "import SwiftUI",
    "",
    "/// The Plenix slider in UIKit: a UISlider with the Plenix track colors.",
    "let slider = UISlider()",
    "slider.minimumValue = 0",
    "slider.maximumValue = 100",
    "slider.minimumTrackTintColor = UIColor(Plenix.Colors.actionPrimaryBackground)",
    "slider.maximumTrackTintColor = UIColor(Plenix.Colors.borderDefault)",
    "slider.heightAnchor.constraint(greaterThanOrEqualToConstant: Plenix.Platform.controlTargetMin).isActive = true",
    "slider.addAction(UIAction { _ in valueLabel.text = \"\\(Int(slider.value))%\" }, for: .valueChanged)",
    "slider.addAction(UIAction { _ in commit(slider.value) }, for: [.touchUpInside, .touchUpOutside])",
    "",
    "let stack = UIStackView(arrangedSubviews: [header, slider])",
    "stack.axis = .vertical",
    "stack.spacing = Plenix.Space.spaceStackXs"
   ],
   "appkit": [
    "import AppKit",
    "import SwiftUI",
    "",
    "// The Plenix slider on the Mac. A Mac Catalyst app uses the iOS tokens and the UIKit code above.",
    "// A native AppKit app needs a macOS build of PlenixTokens.swift (it uses UIColor today; the macOS build is not generated yet). With it:",
    "let slider = NSSlider(value: 50, minValue: 0, maxValue: 100, target: self, action: #selector(valueChanged(_:)))",
    "slider.trackFillColor = NSColor(Plenix.Colors.actionPrimaryBackground)",
    "slider.isContinuous = true",
    "slider.numberOfTickMarks = 11   // sparse ticks for precision",
    "let label = NSTextField(labelWithString: \"Brightness\")",
    "label.font = NSFont(name: \"DMSans-SemiBold\", size: NSFont.systemFontSize)"
   ]
  }
 }
