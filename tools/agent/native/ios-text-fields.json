  "code": {
   "swiftui": [
    "import SwiftUI",
    "",
    "/// The Plenix text field on iOS: the system TextField in a Plenix frame (PlenixTokens.swift).",
    "struct PlenixTextFieldStyle: TextFieldStyle {",
    "    var isFocused = false",
    "    var isInvalid = false",
    "    @Environment(\\.isEnabled) private var isEnabled",
    "",
    "    func _body(configuration: TextField<Self._Label>) -> some View {",
    "        let shape = RoundedRectangle(cornerRadius: Plenix.Radius.radiusControl)",
    "        return configuration",
    "            .font(Plenix.Font.sans(Plenix.Platform.textBodySize, relativeTo: .body))",
    "            .foregroundStyle(isEnabled ? Plenix.Colors.contentDefault : Plenix.Colors.contentDisabled)",
    "            .padding(.horizontal, Plenix.Space.spaceInsetMd)",
    "            .frame(minHeight: Plenix.Platform.controlTargetMin)",
    "            .background(isEnabled ? Plenix.Colors.controlBackground : Plenix.Colors.fillNeutral, in: shape)",
    "            .overlay { shape.strokeBorder(border, lineWidth: Plenix.Component.inputBorderWidth) }",
    "    }",
    "    private var border: Color {",
    "        isInvalid ? Plenix.Colors.feedbackDangerContent : isFocused ? Plenix.Colors.focusRingColor : Plenix.Colors.controlBorder",
    "    }",
    "}",
    "",
    "/// A labeled field: the label stays visible above it.",
    "struct PlenixField: View {",
    "    let label: String",
    "    @Binding var text: String",
    "    var prompt = \"\"",
    "    @FocusState private var focused: Bool",
    "",
    "    var body: some View {",
    "        VStack(alignment: .leading, spacing: Plenix.Space.spaceStackSm) {",
    "            Text(label)",
    "                .font(Plenix.Font.sans(Plenix.Platform.textLabelSize, relativeTo: .subheadline).weight(.semibold))",
    "                .foregroundStyle(Plenix.Colors.contentDefault)",
    "            TextField(label, text: $text, prompt: Text(prompt).foregroundStyle(Plenix.Colors.fieldPlaceholder))",
    "                .focused($focused)",
    "                .textFieldStyle(PlenixTextFieldStyle(isFocused: focused))",
    "        }",
    "    }",
    "}",
    "",
    "// In a view",
    "PlenixField(label: \"Email\", text: $email, prompt: \"name@example.com\")",
    "    .keyboardType(.emailAddress)",
    "    .textContentType(.emailAddress)",
    "    .textInputAutocapitalization(.never)"
   ],
   "uikit": [
    "import UIKit",
    "import SwiftUI",
    "",
    "/// The Plenix text field in UIKit: a UITextField with a Plenix frame.",
    "final class PlenixTextField: UITextField {",
    "    var isInvalid = false { didSet { updateBorder() } }",
    "",
    "    override init(frame: CGRect) {",
    "        super.init(frame: frame)",
    "        borderStyle = .none",
    "        backgroundColor = UIColor(Plenix.Colors.controlBackground)",
    "        textColor = UIColor(Plenix.Colors.contentDefault)",
    "        layer.cornerRadius = Plenix.Radius.radiusControl",
    "        layer.cornerCurve = .continuous",
    "        layer.borderWidth = Plenix.Component.inputBorderWidth",
    "        font = UIFontMetrics(forTextStyle: .body)",
    "            .scaledFont(for: UIFont(name: \"DMSans-Regular\", size: Plenix.Platform.textBodySize) ?? .preferredFont(forTextStyle: .body))",
    "        adjustsFontForContentSizeCategory = true",
    "        clearButtonMode = .whileEditing",
    "        heightAnchor.constraint(greaterThanOrEqualToConstant: Plenix.Platform.controlTargetMin).isActive = true",
    "        addAction(UIAction { [weak self] _ in self?.updateBorder() }, for: [.editingDidBegin, .editingDidEnd])",
    "        updateBorder()",
    "    }",
    "    required init?(coder: NSCoder) { fatalError(\"init(coder:) is not used\") }",
    "",
    "    override func textRect(forBounds bounds: CGRect) -> CGRect { bounds.insetBy(dx: Plenix.Space.spaceInsetMd, dy: 0) }",
    "    override func editingRect(forBounds bounds: CGRect) -> CGRect { textRect(forBounds: bounds) }",
    "",
    "    func setPlaceholder(_ text: String) {",
    "        attributedPlaceholder = NSAttributedString(string: text, attributes: [.foregroundColor: UIColor(Plenix.Colors.fieldPlaceholder)])",
    "    }",
    "    private func updateBorder() {",
    "        let color = isInvalid ? Plenix.Colors.feedbackDangerContent : isEditing ? Plenix.Colors.focusRingColor : Plenix.Colors.controlBorder",
    "        layer.borderColor = UIColor(color).cgColor",
    "    }",
    "}"
   ],
   "appkit": [
    "import AppKit",
    "import SwiftUI",
    "",
    "// The Plenix text field on the Mac. A Mac Catalyst app uses the iOS tokens and the UIKit code above.",
    "// A native AppKit app needs a macOS build of PlenixTokens.swift (it uses UIColor today; the macOS build is not generated yet). With it:",
    "let field = NSTextField(string: \"\")",
    "field.placeholderString = \"name@example.com\"",
    "field.font = NSFont(name: \"DMSans-Regular\", size: NSFont.systemFontSize)",
    "field.isBezeled = false",
    "field.drawsBackground = true",
    "field.backgroundColor = NSColor(Plenix.Colors.controlBackground)",
    "field.focusRingType = .none   // focus changes the border color only",
    "field.wantsLayer = true",
    "field.layer?.cornerRadius = Plenix.Radius.radiusControl",
    "field.layer?.borderWidth = Plenix.Component.inputBorderWidth",
    "field.layer?.borderColor = NSColor(Plenix.Colors.controlBorder).cgColor",
    "field.contentType = .emailAddress"
   ]
  }
 }
