{
  "sheet-background": { "$value": "{plx-sys.surface-overlay}", "$type": "color" },
  "sheet-text": { "$value": "{plx-sys.content-default}", "$type": "color" },
  "sheet-radius": { "$value": "{plx-sys.radius-dialog-6px}", "$type": "dimension", "$description": "The top corners of the bottom sheet (the dialog radius)" },
  "sheet-shadow": { "$value": "{plx-sys.elevation-overlay-shadow}", "$type": "shadow" },
  "sheet-medium-height": { "$value": "50dvh", "$type": "dimension", "$description": "The medium height of the bottom sheet: about half the window (Platforms Standard 5.3; HIG › Sheets, medium detent)" },
  "sheet-large-height": { "$value": "calc(100dvh - {plx-sys.space-layout-xl})", "$type": "dimension", "$description": "The large height of the bottom sheet: the window, less a strip of the screen behind it at the top (HIG › Sheets, large detent)" },
  "sheet-padding-block-end": { "$value": "{plx-sys.safe-area-bottom}", "$type": "dimension", "$description": "The bottom sheet keeps clear of the bottom safe area (Platforms Standard 3.5)" },
  "sheet-animation-duration": { "$value": "{plx-sys.motion-duration-base}", "$type": "duration" },
  "sheet-animation-timing-function": { "$value": "{plx-sys.motion-ease-standard}", "$type": "dimension" },
  "sheet-band-height": { "$value": "{plx-ref.size-12px}", "$type": "dimension", "$description": "The band at the top of the bottom sheet that holds the grabber's bar" },
  "sheet-grabber-width": { "$value": "{plx-ref.size-36px}", "$type": "dimension" },
  "sheet-grabber-height": { "$value": "{plx-ref.size-4px}", "$type": "dimension" },
  "sheet-grabber-inset-block-start": { "$value": "{plx-ref.space-4px}", "$type": "dimension", "$description": "The bar's place in the band: (band - bar) / 2" },
  "sheet-grabber-color": { "$value": "{plx-sys.border-strong}", "$type": "color" },
  "sheet-grabber-radius": { "$value": "{plx-sys.shape-pill}", "$type": "dimension" },
  "sheet-grabber-target-height": { "$value": "{plx-sys.control-target-min}", "$type": "dimension", "$description": "The grabber's target: the minimum target tall (Platforms Standard 3.1), over the band and the header's middle" },
  "sheet-grabber-target-width": { "$value": "calc({plx-sys.control-target-min} * 2)", "$type": "dimension" },
  "sheet-grabber-focus-outline-color": { "$value": "{plx-sys.focus-ring-color}", "$type": "color" },
  "sheet-grabber-focus-outline-offset": { "$value": "{plx-sys.focus-ring-offset}", "$type": "dimension" },
  "sheet-grabber-focus-outline-width": { "$value": "{plx-sys.border-width-medium}", "$type": "dimension" },
  "sheet-header-min-height": { "$value": "{plx-ref.size-48px}", "$type": "dimension" },
  "sheet-header-gap": { "$value": "{plx-sys.space-inline-sm}", "$type": "dimension" },
  "sheet-header-padding-inline": { "$value": "{plx-sys.space-inset-sm}", "$type": "dimension" },
  "sheet-header-border-bottom-color": { "$value": "{plx-sys.border-dialog-chrome}", "$type": "color" },
  "sheet-header-border-bottom-width": { "$value": "{plx-sys.border-width-thin}", "$type": "dimension" },
  "sheet-title-font-family": { "$value": "{plx-sys.font-heading}", "$type": "fontFamily" },
  "sheet-title-font-size": { "$value": "{plx-ref.font-size-15}", "$type": "dimension" },
  "sheet-title-font-weight": { "$value": "{plx-sys.font-weight-bold}", "$type": "fontWeight" },
  "sheet-body-padding-block": { "$value": "{plx-sys.space-inset-lg}", "$type": "dimension" },
  "sheet-body-padding-inline": { "$value": "{plx-sys.space-inset-lg}", "$type": "dimension" },
  "sheet-footer-border-top-color": { "$value": "{plx-sys.border-dialog-chrome}", "$type": "color" },
  "sheet-footer-border-top-width": { "$value": "{plx-sys.border-width-thin}", "$type": "dimension" },
  "sheet-footer-gap": { "$value": "{plx-comp.dialog-action-gap}", "$type": "dimension" },
  "sheet-footer-padding-block": { "$value": "{plx-sys.space-inset-md}", "$type": "dimension" },
  "sheet-footer-padding-inline": { "$value": "{plx-sys.space-inset-lg}", "$type": "dimension" },
  "sheet-actions-margin-block-end": { "$value": "{plx-sys.space-stack-md}", "$type": "dimension" }
}
