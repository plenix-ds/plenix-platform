{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "platform/index.js",
    "*/main.jsx",
    "dam/app/assets.jsx",
    "build-*.js",
    "build-packages.d/*.js",
    "check-*.js",
    "tokenize-component.js",
    "tests/**/*.js",
    "tools/**/*.js",
    "services/**/*.js"
  ],
  "project": ["**/*.{js,jsx,mjs,cjs}"],
  "ignoreDependencies": ["plenix-platform", "react", "react-dom"],
  "ignore": [
    "platform/dist/**",
    "*/app.js",
    "dam/app/assets.js",
    "platform/components/Icon/glyphs.js",
    "platform/vendor/**",
    "platform/design-system/**",
    "node_modules/**",
    "Archived/**"
  ]
}
