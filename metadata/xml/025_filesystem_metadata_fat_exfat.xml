<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="025" name="Filesystem Metadata FAT exFAT" category="OS" category_label="Operating System / File System" used_for="USB drives, SD cards, EFI System partitions" spec_source="Microsoft FAT specification; exFAT specification (2019)" completeness="comprehensive" record_count="28">
  <description>FAT12/16/32 directory entries are 32 bytes each; exFAT uses extensible 32-byte entry types.</description>
  <attributes>
    <attribute>
      <name>Filename (8.3)</name>
      <data_type>ASCII 11 bytes</data_type>
      <group>FAT</group>
      <description>8-char name + 3-char extension, space-padded</description>
    </attribute>
    <attribute>
      <name>Long Filename (LFN)</name>
      <data_type>UCS-2</data_type>
      <group>FAT</group>
      <description>VFAT extension — up to 255 UCS-2 chars across multiple entries</description>
    </attribute>
    <attribute>
      <name>File Attributes</name>
      <data_type>UInt8</data_type>
      <group>FAT</group>
      <description>Read-only (0x01), Hidden (0x02), System (0x04), Volume ID (0x08), Directory (0x10), Archive (0x20), LFN (0x0F)</description>
    </attribute>
    <attribute>
      <name>Creation Time</name>
      <data_type>UInt16 (DOS time, 2-sec resolution)</data_type>
      <group>FAT</group>
      <description>HH:MM:SS/2</description>
    </attribute>
    <attribute>
      <name>Creation Time Tenths</name>
      <data_type>UInt8</data_type>
      <group>FAT</group>
      <description>Tenths of a second 0-199</description>
    </attribute>
    <attribute>
      <name>Creation Date</name>
      <data_type>UInt16 (DOS date)</data_type>
      <group>FAT</group>
      <description>Year-1980 (7), month (4), day (5)</description>
    </attribute>
    <attribute>
      <name>Last Access Date</name>
      <data_type>UInt16</data_type>
      <group>FAT</group>
      <description>Date only (no time)</description>
    </attribute>
    <attribute>
      <name>Last Modified Time</name>
      <data_type>UInt16</data_type>
      <group>FAT</group>
      <description>HH:MM:SS/2</description>
    </attribute>
    <attribute>
      <name>Last Modified Date</name>
      <data_type>UInt16</data_type>
      <group>FAT</group>
      <description>Year-1980, month, day</description>
    </attribute>
    <attribute>
      <name>First Cluster (high + low)</name>
      <data_type>UInt16 × 2</data_type>
      <group>FAT</group>
      <description>Starting cluster (FAT32 splits across high and low UInt16)</description>
    </attribute>
    <attribute>
      <name>File Size</name>
      <data_type>UInt32</data_type>
      <group>FAT</group>
      <description>Size in bytes (max 4 GiB - 1)</description>
    </attribute>
    <attribute>
      <name>Volume Label</name>
      <data_type>ASCII 11 bytes</data_type>
      <group>FAT</group>
      <description>From boot sector or volume-id directory entry</description>
    </attribute>
    <attribute>
      <name>OEM Name</name>
      <data_type>ASCII 8 bytes</data_type>
      <group>FAT</group>
      <description>Boot sector OEM name (e.g., 'MSDOS5.0')</description>
    </attribute>
    <attribute>
      <name>Volume Serial Number</name>
      <data_type>UInt32 hex</data_type>
      <group>FAT</group>
      <description>From boot sector</description>
    </attribute>
    <attribute>
      <name>Filesystem Type</name>
      <data_type>ASCII 8 bytes</data_type>
      <group>FAT</group>
      <description>'FAT12   ', 'FAT16   ', 'FAT32   '</description>
    </attribute>
    <attribute>
      <name>BPB Bytes per Sector</name>
      <data_type>UInt16</data_type>
      <group>FAT</group>
      <description>512, 1024, 2048, or 4096</description>
    </attribute>
    <attribute>
      <name>BPB Sectors per Cluster</name>
      <data_type>UInt8</data_type>
      <group>FAT</group>
      <description>1, 2, 4, 8, 16, 32, 64, 128</description>
    </attribute>
    <attribute>
      <name>Reserved Sectors</name>
      <data_type>UInt16</data_type>
      <group>FAT</group>
      <description>Including boot sector</description>
    </attribute>
    <attribute>
      <name>Number of FATs</name>
      <data_type>UInt8</data_type>
      <group>FAT</group>
      <description>Usually 2</description>
    </attribute>
    <attribute>
      <name>Stream Extension Entry</name>
      <data_type>32 bytes</data_type>
      <group>exFAT</group>
      <description>exFAT 0xC0 type — flags, name length, hash, valid size, data length, first cluster</description>
    </attribute>
    <attribute>
      <name>File Directory Entry</name>
      <data_type>32 bytes</data_type>
      <group>exFAT</group>
      <description>exFAT 0x85 type — secondary count, set checksum, attributes, timestamps, timezone offsets</description>
    </attribute>
    <attribute>
      <name>File Name Entry</name>
      <data_type>32 bytes</data_type>
      <group>exFAT</group>
      <description>exFAT 0xC1 — 15 UTF-16 chars per entry</description>
    </attribute>
    <attribute>
      <name>Volume GUID</name>
      <data_type>GUID</data_type>
      <group>exFAT</group>
      <description>Optional 0xA0 entry</description>
    </attribute>
    <attribute>
      <name>Texture (Allocation Bitmap)</name>
      <data_type>32 bytes</data_type>
      <group>exFAT</group>
      <description>0x81 — bitmap of cluster allocation</description>
    </attribute>
    <attribute>
      <name>Up-case Table</name>
      <data_type>32 bytes</data_type>
      <group>exFAT</group>
      <description>0x82 — Unicode case folding table</description>
    </attribute>
    <attribute>
      <name>Timezone Offset</name>
      <data_type>UInt8 (15-min units)</data_type>
      <group>exFAT</group>
      <description>Per-timestamp tz offset (FAT was always local)</description>
    </attribute>
    <attribute>
      <name>Allocation Possible Flag</name>
      <data_type>Bit</data_type>
      <group>exFAT</group>
      <description>In stream entry general flags</description>
    </attribute>
    <attribute>
      <name>No FAT Chain Flag</name>
      <data_type>Bit</data_type>
      <group>exFAT</group>
      <description>Contiguous allocation marker</description>
    </attribute>
  </attributes>
</metadata_system>