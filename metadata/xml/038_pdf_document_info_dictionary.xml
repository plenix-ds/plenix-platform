<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="038" name="PDF Document Info Dictionary" category="DOC" category_label="Documents" used_for="Older/basic PDF metadata (/Info dictionary in trailer)" spec_source="ISO 32000-2 §14.3.3; ISO 32000-1 §14.3.3" completeness="comprehensive" record_count="12">
  <description>Pre-XMP metadata mechanism: a dictionary referenced from the trailer /Info entry. Deprecated in PDF 2.0 in favor of XMP. Many tools still write both for compatibility.</description>
  <attributes>
    <attribute>
      <name>/Title</name>
      <data_type>text string</data_type>
      <description>Document title</description>
    </attribute>
    <attribute>
      <name>/Author</name>
      <data_type>text string</data_type>
      <description>Author</description>
    </attribute>
    <attribute>
      <name>/Subject</name>
      <data_type>text string</data_type>
      <description>Subject</description>
    </attribute>
    <attribute>
      <name>/Keywords</name>
      <data_type>text string</data_type>
      <description>Keywords (comma or space separated)</description>
    </attribute>
    <attribute>
      <name>/Creator</name>
      <data_type>text string</data_type>
      <description>Application that created original (e.g., 'Microsoft Word')</description>
    </attribute>
    <attribute>
      <name>/Producer</name>
      <data_type>text string</data_type>
      <description>Library/app that converted to PDF (e.g., 'Adobe PDF Library 15.0')</description>
    </attribute>
    <attribute>
      <name>/CreationDate</name>
      <data_type>date string D:YYYYMMDDHHmmSSOHH'mm'</data_type>
      <description>Original creation date</description>
    </attribute>
    <attribute>
      <name>/ModDate</name>
      <data_type>date string</data_type>
      <description>Last modification date</description>
    </attribute>
    <attribute>
      <name>/Trapped</name>
      <data_type>Name (/True /False /Unknown)</data_type>
      <description>Whether trapping has been applied</description>
    </attribute>
    <attribute>
      <name>/PTEX.Fullbanner</name>
      <data_type>text string</data_type>
      <description>pdfTeX banner (when produced by pdfTeX)</description>
    </attribute>
    <attribute>
      <name>Custom keys</name>
      <data_type>any</data_type>
      <description>Producers may add arbitrary additional /KeyName entries — historically used for app-specific data</description>
    </attribute>
    <attribute>
      <name>/ID array (trailer)</name>
      <data_type>Array of 2 byte strings</data_type>
      <description>Two file identifiers — first is permanent (CreationDate), second is updated each save</description>
    </attribute>
  </attributes>
</metadata_system>