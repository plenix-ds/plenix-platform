<metadata_system id="070" name="MIDI Metadata" category="AUD" category_label="Audio" used_for="MIDI music files (.mid / .midi)" spec_source="MIDI 1.0 Specification (MMA) + Standard MIDI File 1.0" completeness="comprehensive" record_count="90">
  <description>Standard MIDI File (SMF) format. Header chunk + one or more track chunks. Events are messages with delta-time. MIDI 2.0 adds higher resolution but SMF 1.0 dominates.</description>
  <attributes>
    <attribute>
