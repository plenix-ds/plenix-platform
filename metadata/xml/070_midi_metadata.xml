      <data_type>UInt32 BE = 6</data_type>
      <group>Header</group>
      <description>Always 6</description>
    </attribute>
    <attribute>
      <name>Format type</name>
      <data_type>UInt16 BE</data_type>
      <group>Header</group>
      <description>0=single track, 1=multi-track simultaneous, 2=multi-track sequential</description>
      <values>
        <value key="0">Single multi-channel track</value>
        <value key="1">Simultaneous multi-track</value>
        <value key="2">Sequential independent tracks</value>
