<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="017" name="macOS Finder Info" category="OS" category_label="Operating System / File System" used_for="Finder-specific file information (FinderInfo struct)" spec_source="Apple Inside Macintosh: Files Ch. 2; FileInfo/FolderInfo structures" completeness="comprehensive" record_count="11">
  <description>32-byte fixed structure historically stored in HFS+ catalog, now in com.apple.FinderInfo xattr. Differs slightly between files (FileInfo) and folders (FolderInfo).</description>
  <attributes>
    <attribute>
      <name>File Type Code</name>
      <data_type>OSType (4 chars)</data_type>
      <description>Legacy 4-char type code (TEXT, JPEG, PDF , APPL, etc.)</description>
    </attribute>
    <attribute>
      <name>Creator Code</name>
      <data_type>OSType (4 chars)</data_type>
      <description>Application creator code (e.g., 'MSWD' = MS Word)</description>
    </attribute>
    <attribute>
      <name>Finder Flags</name>
      <data_type>UInt16 bitfield</data_type>
      <description>kIsOnDesk, kColor, kIsShared, kHasNoINITs, kHasBeenInited, kHasCustomIcon, kIsStationary, kNameLocked, kHasBundle, kIsInvisible, kIsAlias</description>
    </attribute>
    <attribute>
      <name>Color Label</name>
      <data_type>3 bits</data_type>
      <description>Finder color label index 0-7</description>
      <values>
        <value key="0">No label</value>
        <value key="1">Gray</value>
        <value key="2">Green</value>
        <value key="3">Purple</value>
        <value key="4">Blue</value>
        <value key="5">Yellow</value>
        <value key="6">Red</value>
        <value key="7">Orange</value>
      </values>
    </attribute>
    <attribute>
      <name>Icon Position</name>
      <data_type>Point (2× Int16)</data_type>
      <description>X,Y position in icon view</description>
    </attribute>
    <attribute>
      <name>Folder Window Position (FolderInfo)</name>
      <data_type>Rect</data_type>
      <description>Window bounds when folder opened</description>
    </attribute>
    <attribute>
      <name>Folder View (FolderInfo)</name>
      <data_type>UInt16</data_type>
      <description>Icon, list, column view</description>
    </attribute>
    <attribute>
      <name>Folder Scroll Position (FolderInfo)</name>
      <data_type>Point</data_type>
      <description>Scroll offset</description>
    </attribute>
    <attribute>
      <name>Extended Finder Flags</name>
      <data_type>UInt16</data_type>
      <description>kExtendedFlagHasCustomBadge, kExtendedFlagHasRoutingInfo, kExtendedFlagObjectIsBusy</description>
    </attribute>
    <attribute>
      <name>Reserved (4 bytes)</name>
      <data_type>UInt32</data_type>
      <description>Reserved space</description>
    </attribute>
    <attribute>
      <name>Put Away Folder ID</name>
      <data_type>UInt32</data_type>
      <description>Original folder ID for trashed items</description>
    </attribute>
  </attributes>
</metadata_system>