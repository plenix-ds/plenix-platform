<metadata_system id="020" name="Unix / Linux Extended Attributes" category="OS" category_label="Operating System / File System" used_for="Extra file metadata (xattrs)" spec_source="Linux attr(5); xattr(7); getxattr(2)" completeness="comprehensive" record_count="27">
  <description>Key/value pairs in namespaces. Inspect with `getfattr -d -m '.*' file`. Stored as filesystem-specific extended attributes (ext4 ea blocks, XFS attr fork, Btrfs xattrs, etc.).</description>
