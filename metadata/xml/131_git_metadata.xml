      <group>Index Entry</group>
      <description>Owner UID/GID</description>
    </attribute>
    <attribute>
      <name>Index entry: file size</name>
      <data_type>UInt32</data_type>
      <group>Index Entry</group>
      <description>On-disk size</description>
    </attribute>
    <attribute>
      <name>Index entry: SHA</name>
