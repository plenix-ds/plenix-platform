<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="131" name="Git Metadata" category="CLD" category_label="Cloud / Versioning" used_for="Code repositories (Git internals)" spec_source="https://git-scm.com/docs/gitformat-* (gitformat-pack, gitformat-index, gitformat-commit-graph)" completeness="comprehensive" record_count="77">
  <description>Git is a content-addressed object store. Four object types (blob, tree, commit, tag) are hashed by their content (SHA-1 by default; SHA-256 in newer repos). Refs name commits; the index stages changes; pack files efficiently store many objects. Hooks, attributes, configs, and signatures provide the operational metadata.</description>
  <attributes>
    <attribute>
      <name>Blob object</name>
      <data_type>Object</data_type>
      <group>Object Types</group>
      <description>Stores file content (no name, no metadata)</description>
    </attribute>
    <attribute>
      <name>Tree object</name>
      <data_type>Object</data_type>
      <group>Object Types</group>
      <description>Directory listing: mode, type, hash, name entries</description>
    </attribute>
    <attribute>
      <name>Commit object</name>
      <data_type>Object</data_type>
      <group>Object Types</group>
      <description>Pointer to tree + parent commits + author + committer + message</description>
    </attribute>
    <attribute>
      <name>Tag object (annotated)</name>
      <data_type>Object</data_type>
      <group>Object Types</group>
      <description>Pointer to object + tagger + message + signature</description>
    </attribute>
    <attribute>
      <name>Object SHA-1 / SHA-256</name>
      <data_type>Hash</data_type>
      <group>Object Header</group>
      <description>Cryptographic content-addressed identifier</description>
    </attribute>
    <attribute>
      <name>tree</name>
      <data_type>Hash ref</data_type>
      <group>Commit</group>
      <description>Root tree object SHA</description>
    </attribute>
    <attribute>
      <name>parent</name>
      <data_type>Hash ref (multiple)</data_type>
      <group>Commit</group>
      <description>Parent commit SHA(s) — zero for root, two+ for merges</description>
    </attribute>
    <attribute>
      <name>author</name>
      <data_type>Identity + timestamp</data_type>
      <group>Commit</group>
      <description>Original author 'Name &lt;email&gt; timestamp tz'</description>
    </attribute>
    <attribute>
      <name>committer</name>
      <data_type>Identity + timestamp</data_type>
      <group>Commit</group>
      <description>Committer (may differ from author after rebases)</description>
    </attribute>
    <attribute>
      <name>encoding</name>
      <data_type>String</data_type>
      <group>Commit</group>
      <description>Commit message encoding (default UTF-8)</description>
    </attribute>
    <attribute>
      <name>gpgsig</name>
      <data_type>PGP signature</data_type>
      <group>Commit</group>
      <description>Inline OpenPGP signature of the commit</description>
    </attribute>
    <attribute>
      <name>mergetag</name>
      <data_type>Embedded tag</data_type>
      <group>Commit</group>
      <description>Merged signed tag preserved in merge commit</description>
    </attribute>
    <attribute>
      <name>commit message</name>
      <data_type>Text body</data_type>
      <group>Commit</group>
      <description>Free-form message after blank-line separator</description>
    </attribute>
    <attribute>
      <name>Tree entry: mode</name>
      <data_type>Octal</data_type>
      <group>Tree</group>
      <description>100644 (file), 100755 (executable), 120000 (symlink), 040000 (subdirectory), 160000 (gitlink/submodule), 100664 (group writable, rare)</description>
    </attribute>
    <attribute>
      <name>Tree entry: type</name>
      <data_type>Implied</data_type>
      <group>Tree</group>
      <description>blob or tree (or commit for submodules)</description>
    </attribute>
    <attribute>
      <name>Tree entry: hash</name>
      <data_type>SHA</data_type>
      <group>Tree</group>
      <description>Object hash</description>
    </attribute>
    <attribute>
      <name>Tree entry: name</name>
      <data_type>Bytes</data_type>
      <group>Tree</group>
      <description>Entry filename (no path separators)</description>
    </attribute>
    <attribute>
      <name>object</name>
      <data_type>Hash ref</data_type>
      <group>Tag</group>
      <description>Tagged object hash</description>
    </attribute>
    <attribute>
      <name>type</name>
      <data_type>Object type</data_type>
      <group>Tag</group>
      <description>blob/tree/commit/tag</description>
    </attribute>
