      <data_type>3-bit field</data_type>
      <group>Pack Format</group>
      <description>OBJ_COMMIT(1), OBJ_TREE(2), OBJ_BLOB(3), OBJ_TAG(4), OBJ_OFS_DELTA(6), OBJ_REF_DELTA(7)</description>
    </attribute>
    <attribute>
      <name>Pack object: size</name>
      <data_type>Variable-length</data_type>
      <group>Pack Format</group>
      <description>Inflated size</description>
    </attribute>
    <attribute>
      <name>Pack delta: base ref</name>
