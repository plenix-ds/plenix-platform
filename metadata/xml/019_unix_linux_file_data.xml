<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="019" name="Unix / Linux File Data" category="OS" category_label="Operating System / File System" used_for="Standard Unix filesystem metadata (struct stat)" spec_source="POSIX.1-2017 / IEEE Std 1003.1; Linux stat(2)" completeness="comprehensive" record_count="21">
  <description>POSIX struct stat returned by stat()/fstat()/lstat() — applies to all Unix-like filesystems with adaptations.</description>
  <attributes>
    <attribute>
      <name>st_dev</name>
      <data_type>dev_t</data_type>
      <description>Device ID containing the file</description>
    </attribute>
    <attribute>
      <name>st_ino</name>
      <data_type>ino_t (UInt64)</data_type>
      <description>Inode number — unique within device</description>
    </attribute>
    <attribute>
      <name>st_mode</name>
      <data_type>mode_t (UInt32)</data_type>
      <description>File type + permissions (12 bits)</description>
    </attribute>
    <attribute>
      <name>st_nlink</name>
      <data_type>nlink_t</data_type>
      <description>Hard link count</description>
    </attribute>
    <attribute>
      <name>st_uid</name>
      <data_type>uid_t</data_type>
      <description>Owner user ID</description>
    </attribute>
    <attribute>
      <name>st_gid</name>
      <data_type>gid_t</data_type>
      <description>Owner group ID</description>
    </attribute>
    <attribute>
      <name>st_rdev</name>
      <data_type>dev_t</data_type>
      <description>Device ID (if device file)</description>
    </attribute>
    <attribute>
      <name>st_size</name>
      <data_type>off_t (Int64)</data_type>
      <description>File size in bytes</description>
    </attribute>
    <attribute>
      <name>st_atime / st_atim</name>
      <data_type>time_t / timespec</data_type>
      <description>Last access time (read)</description>
    </attribute>
    <attribute>
      <name>st_mtime / st_mtim</name>
      <data_type>time_t / timespec</data_type>
      <description>Last modification time (content change)</description>
    </attribute>
    <attribute>
      <name>st_ctime / st_ctim</name>
      <data_type>time_t / timespec</data_type>
      <description>Last status change time (metadata)</description>
    </attribute>
    <attribute>
      <name>st_birthtime (BSD/macOS)</name>
      <data_type>time_t</data_type>
      <description>File birth/creation time (not POSIX standard)</description>
    </attribute>
    <attribute>
      <name>st_blksize</name>
      <data_type>blksize_t</data_type>
      <description>Preferred I/O block size</description>
    </attribute>
    <attribute>
      <name>st_blocks</name>
      <data_type>blkcnt_t</data_type>
      <description>Number of 512-byte blocks allocated</description>
    </attribute>
    <attribute>
      <name>File Type (S_IFMT mask)</name>
      <data_type>Bits in st_mode</data_type>
      <description>S_IFREG (regular), S_IFDIR (dir), S_IFLNK (symlink), S_IFBLK (block dev), S_IFCHR (char dev), S_IFIFO (FIFO), S_IFSOCK (socket)</description>
    </attribute>
    <attribute>
      <name>Setuid / Setgid / Sticky</name>
      <data_type>Bits in st_mode</data_type>
      <description>S_ISUID (04000), S_ISGID (02000), S_ISVTX (01000)</description>
    </attribute>
    <attribute>
      <name>Owner perms</name>
      <data_type>Bits in st_mode</data_type>
      <description>rwx for owner: S_IRUSR, S_IWUSR, S_IXUSR</description>
    </attribute>
    <attribute>
      <name>Group perms</name>
      <data_type>Bits in st_mode</data_type>
      <description>rwx for group: S_IRGRP, S_IWGRP, S_IXGRP</description>
    </attribute>
    <attribute>
      <name>Other perms</name>
      <data_type>Bits in st_mode</data_type>
      <description>rwx for others: S_IROTH, S_IWOTH, S_IXOTH</description>
    </attribute>
    <attribute>
      <name>Hard Link Count</name>
      <data_type>nlink_t</data_type>
      <description>Total directory entries pointing to this inode</description>
    </attribute>
    <attribute>
      <name>Symlink Target</name>
      <data_type>String (via readlink)</data_type>
      <description>For symlinks: path target</description>
    </attribute>
  </attributes>
</metadata_system>