<metadata_system id="224" name="Mach-O Binary Metadata" category="SPC" category_label="Specialized" used_for="macOS/iOS executables, dylibs, frameworks" spec_source="Apple loader.h / mach-o/* headers; Apple OS X ABI Mach-O File Format Reference" completeness="comprehensive" record_count="70">
  <description>Mach-O is the native binary format on Apple platforms. Header → Load Commands → Segments/Sections. Has rich code-signing metadata embedded since iOS / macOS Catalina. UUID links binary to its dSYM debug bundle.</description>
  <attributes>
    <attribute>
      <name>magic</name>
      <data_type>UInt32</data_type>
      <group>Mach Header</group>
      <description>0xFEEDFACE (32-bit), 0xFEEDFACF (64-bit), 0xCEFAEDFE/0xCFFAEDFE (swapped)</description>
      <values>
        <value key="0xFEEDFACE">MH_MAGIC (32-bit)</value>
        <value key="0xFEEDFACF">MH_MAGIC_64 (64-bit)</value>
        <value key="0xCEFAEDFE">MH_CIGAM (swapped 32)</value>
        <value key="0xCFFAEDFE">MH_CIGAM_64 (swapped 64)</value>
        <value key="0xCAFEBABE">FAT_MAGIC (universal binary)</value>
        <value key="0xBEBAFECA">FAT_CIGAM</value>
      </values>
    </attribute>
    <attribute>
      <name>cputype</name>
      <data_type>Int32</data_type>
      <group>Mach Header</group>
      <description>CPU type</description>
      <values>
        <value key="0x07">CPU_TYPE_X86</value>
        <value key="0x01000007">CPU_TYPE_X86_64</value>
        <value key="0x0C">CPU_TYPE_ARM</value>
        <value key="0x0100000C">CPU_TYPE_ARM64</value>
        <value key="0x18">CPU_TYPE_PPC</value>
        <value key="0x01000018">CPU_TYPE_PPC64</value>
      </values>
    </attribute>
    <attribute>
      <name>cpusubtype</name>
      <data_type>Int32</data_type>
      <group>Mach Header</group>
      <description>CPU subtype (variant within family)</description>
    </attribute>
    <attribute>
      <name>filetype</name>
      <data_type>UInt32</data_type>
      <group>Mach Header</group>
      <description>File type</description>
      <values>
        <value key="1">MH_OBJECT</value>
        <value key="2">MH_EXECUTE</value>
        <value key="3">MH_FVMLIB</value>
        <value key="4">MH_CORE</value>
        <value key="5">MH_PRELOAD</value>
        <value key="6">MH_DYLIB (shared library)</value>
        <value key="7">MH_DYLINKER</value>
        <value key="8">MH_BUNDLE (loadable)</value>
        <value key="9">MH_DYLIB_STUB</value>
        <value key="10">MH_DSYM (debug)</value>
