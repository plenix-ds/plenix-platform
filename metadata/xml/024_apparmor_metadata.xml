<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="024" name="AppArmor Metadata" category="OS" category_label="Operating System / File System" used_for="Linux application confinement" spec_source="Canonical AppArmor; apparmor(7)" completeness="comprehensive" record_count="20">
  <description>Path-based MAC. Profiles stored in /etc/apparmor.d/. Per-process attachment via security.apparmor xattr or kernel attachment.</description>
  <attributes>
    <attribute>
      <name>Profile Name</name>
      <data_type>String</data_type>
      <description>Full profile name (e.g., /usr/bin/firefox, profile_name)</description>
    </attribute>
    <attribute>
      <name>Profile Mode</name>
      <data_type>Enum</data_type>
      <description>enforce, complain, unconfined, kill, prompt</description>
      <values>
        <value key="enforce">Active enforcement</value>
        <value key="complain">Log violations only</value>
        <value key="unconfined">No confinement</value>
        <value key="kill">Kill on violation</value>
      </values>
    </attribute>
    <attribute>
      <name>Attachment Specification</name>
      <data_type>Path or expression</data_type>
      <description>Which executable paths attach to this profile</description>
    </attribute>
    <attribute>
      <name>File Rule</name>
      <data_type>Pattern + perms</data_type>
      <description>Path pattern with rwx, ix, Px, Cx, Ux permissions</description>
    </attribute>
    <attribute>
      <name>Capability Rule</name>
      <data_type>Capability name</data_type>
      <description>Grant of Linux capability to confined process</description>
    </attribute>
    <attribute>
      <name>Network Rule</name>
      <data_type>Domain + type + protocol</data_type>
      <description>network inet stream, network packet, etc.</description>
    </attribute>
    <attribute>
      <name>Mount Rule</name>
      <data_type>Pattern</data_type>
      <description>mount/umount/remount permissions</description>
    </attribute>
    <attribute>
      <name>Pivot Root Rule</name>
      <data_type>Pattern</data_type>
      <description>pivot_root permission (containers)</description>
    </attribute>
    <attribute>
      <name>Signal Rule</name>
      <data_type>Direction + signal + peer</data_type>
      <description>signal send/receive permissions</description>
    </attribute>
    <attribute>
      <name>Ptrace Rule</name>
      <data_type>Direction + peer</data_type>
      <description>ptrace tracedby/trace permissions</description>
    </attribute>
    <attribute>
      <name>DBus Rule</name>
      <data_type>Bus + path + interface + method</data_type>
      <description>DBus send/receive on bus</description>
    </attribute>
    <attribute>
      <name>Unix Socket Rule</name>
      <data_type>Type + addr</data_type>
      <description>AF_UNIX socket access</description>
    </attribute>
    <attribute>
      <name>Hat / Subprofile</name>
      <data_type>Named scope</data_type>
      <description>Profile-within-profile (change_hat)</description>
    </attribute>
    <attribute>
      <name>Variable</name>
      <data_type>@{name}</data_type>
      <description>Tunable variable (HOME, PROC, etc.)</description>
    </attribute>
    <attribute>
      <name>Include Directive</name>
      <data_type>#include &lt;path&gt;</data_type>
      <description>Pull in shared abstractions</description>
    </attribute>
    <attribute>
      <name>Audit Modifier</name>
      <data_type>Keyword</data_type>
      <description>audit — log every match</description>
    </attribute>
    <attribute>
      <name>Deny Modifier</name>
      <data_type>Keyword</data_type>
      <description>deny — explicit deny rule</description>
    </attribute>
    <attribute>
      <name>Owner Modifier</name>
      <data_type>Keyword</data_type>
      <description>owner — match only when process UID owns file</description>
    </attribute>
    <attribute>
      <name>Profile Flags</name>
      <data_type>Flags</data_type>
      <description>complain, audit, attach_disconnected, mediate_deleted, no_attach_disconnected</description>
    </attribute>
    <attribute>
      <name>Stacked Profile</name>
      <data_type>Profile1//Profile2</data_type>
      <description>Profile stacking (multiple profiles apply)</description>
    </attribute>
  </attributes>
</metadata_system>