<metadata_system id="009" name="Windows Registry Metadata" category="FOR" category_label="Forensics / Activity" used_for="Windows system/app configuration (.dat hives)" spec_source="Microsoft Registry hive format; libregf; Eric Zimmerman RegistryExplorer" completeness="comprehensive" record_count="29">
  <description>Hierarchical database of keys/values. Hives: SYSTEM, SOFTWARE, SAM, SECURITY, NTUSER.DAT (per-user), UsrClass.dat. Forensically rich for activity, persistence, and configuration.</description>
  <attributes>
    <attribute>
      <name>Hive File Signature</name>
      <data_type>ASCII 'regf'</data_type>
      <description>Magic bytes at offset 0</description>
    </attribute>
    <attribute>
      <name>Primary Sequence Number</name>
      <data_type>UInt32</data_type>
      <description>Incremented on writes</description>
    </attribute>
    <attribute>
      <name>Secondary Sequence Number</name>
      <data_type>UInt32</data_type>
      <description>Mismatch indicates dirty hive</description>
    </attribute>
    <attribute>
      <name>Last Written Time</name>
      <data_type>FILETIME</data_type>
      <description>When hive was last modified</description>
    </attribute>
    <attribute>
      <name>Major/Minor Version</name>
      <data_type>UInt32 × 2</data_type>
      <description>Hive format version</description>
    </attribute>
    <attribute>
      <name>Root Cell Offset</name>
      <data_type>UInt32</data_type>
      <description>Offset to root key</description>
    </attribute>
    <attribute>
      <name>Hive Bins Data Size</name>
      <data_type>UInt32</data_type>
      <description>Total size of hbin pages</description>
    </attribute>
    <attribute>
      <name>Hive File Type</name>
      <data_type>UInt32</data_type>
      <description>0=primary, 1=log, 2=external, 6=backup</description>
    </attribute>
    <attribute>
      <name>Checksum</name>
      <data_type>UInt32 XOR</data_type>
      <description>Header checksum</description>
    </attribute>
    <attribute>
      <name>Filename (embedded)</name>
      <data_type>UTF-16 64 chars</data_type>
      <description>Path to hive at creation</description>
    </attribute>
    <attribute>
      <name>Boot Type / Recover</name>
      <data_type>UInt32</data_type>
      <description>Boot recovery state</description>
    </attribute>
    <attribute>
      <name>Key Node (nk)</name>
      <data_type>Cell</data_type>
      <group>Cells</group>
      <description>Key record: name, parent, subkey list, value list, security, class, last-write time</description>
