    </attribute>
    <attribute>
      <name>Number of Values</name>
      <data_type>UInt32</data_type>
      <group>nk fields</group>
      <description>Values directly under key</description>
    </attribute>
    <attribute>
      <name>Class Name</name>
      <data_type>String</data_type>
      <group>nk fields</group>
      <description>Optional class identifier</description>
    </attribute>
    <attribute>
