      <data_type>String</data_type>
      <description>One to two sentence description</description>
    </attribute>
    <attribute>
      <name>og:determiner</name>
      <data_type>Enum</data_type>
      <description>Word that appears before object's title (a/an/the/auto/blank)</description>
      <values>
        <value key="a">a</value>
        <value key="an">an</value>
        <value key="the">the</value>
        <value key="auto">auto</value>
        <value key="">blank</value>
      </values>
    </attribute>
