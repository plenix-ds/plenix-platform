<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="081" name="Open Graph Metadata" category="WEB" category_label="Web / Email" used_for="Social media link previews" spec_source="Open Graph Protocol — ogp.me" completeness="comprehensive" record_count="57">
  <description>Open Graph (originally by Facebook) is the predominant standard for embedding rich link preview metadata in HTML. Specified at ogp.me. Embedded as &lt;meta property='og:...' content='...'&gt; tags in &lt;head&gt;.</description>
  <attributes>
    <attribute>
      <name>og:title</name>
      <data_type>String</data_type>
      <required>true</required>
      <description>Title of the object as it should appear within the graph</description>
    </attribute>
    <attribute>
      <name>og:type</name>
      <data_type>Enum</data_type>
      <required>true</required>
      <description>Type of object (article, book, profile, music, video, website)</description>
      <values>
        <value key="website">Website</value>
        <value key="article">Article</value>
        <value key="book">Book</value>
        <value key="profile">Profile</value>
        <value key="music.song">Music: song</value>
        <value key="music.album">Music: album</value>
        <value key="music.playlist">Music: playlist</value>
        <value key="music.radio_station">Music: radio station</value>
        <value key="video.movie">Video: movie</value>
        <value key="video.episode">Video: episode</value>
        <value key="video.tv_show">Video: TV show</value>
        <value key="video.other">Video: other</value>
      </values>
    </attribute>
    <attribute>
      <name>og:image</name>
      <data_type>URL</data_type>
      <required>true</required>
      <description>Image URL representing the object</description>
    </attribute>
    <attribute>
