<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="082" name="Twitter Card Metadata" category="WEB" category_label="Web / Email" used_for="X/Twitter link previews" spec_source="X (Twitter) Cards markup tags reference (developer.x.com)" completeness="comprehensive" record_count="25">
  <description>Twitter Cards extend Open Graph with X-specific properties via &lt;meta name='twitter:...'&gt; tags. X falls back to Open Graph when twitter:* not present.</description>
  <attributes>
    <attribute>
      <name>twitter:card</name>
      <data_type>Enum</data_type>
      <required>true</required>
      <description>Card type</description>
      <values>
        <value key="summary">Summary card with small thumbnail</value>
        <value key="summary_large_image">Summary with large image</value>
        <value key="app">App download card</value>
        <value key="player">Inline media player</value>
      </values>
    </attribute>
    <attribute>
      <name>twitter:site</name>
      <data_type>@username</data_type>
      <description>@username of website</description>
    </attribute>
    <attribute>
      <name>twitter:site:id</name>
      <data_type>String</data_type>
      <description>Twitter user ID of website</description>
    </attribute>
    <attribute>
      <name>twitter:creator</name>
      <data_type>@username</data_type>
      <description>Content creator @username</description>
    </attribute>
    <attribute>
      <name>twitter:creator:id</name>
      <data_type>String</data_type>
      <description>Creator Twitter user ID</description>
    </attribute>
    <attribute>
      <name>twitter:title</name>
      <data_type>String (≤70 chars)</data_type>
      <description>Title</description>
    </attribute>
    <attribute>
      <name>twitter:description</name>
      <data_type>String (≤200 chars)</data_type>
      <description>Description</description>
    </attribute>
    <attribute>
      <name>twitter:image</name>
      <data_type>URL</data_type>
      <description>Image URL (max 5MB, JPG/PNG/WEBP/GIF)</description>
    </attribute>
    <attribute>
      <name>twitter:image:alt</name>
      <data_type>String (≤420 chars)</data_type>
      <description>Image alt text</description>
    </attribute>
    <attribute>
      <name>twitter:player</name>
      <data_type>URL HTTPS</data_type>
      <group>player</group>
      <description>HTTPS iframe URL</description>
    </attribute>
    <attribute>
      <name>twitter:player:width</name>
      <data_type>Integer</data_type>
      <group>player</group>
      <description>iframe width</description>
    </attribute>
    <attribute>
      <name>twitter:player:height</name>
      <data_type>Integer</data_type>
      <group>player</group>
      <description>iframe height</description>
    </attribute>
    <attribute>
      <name>twitter:player:stream</name>
      <data_type>URL</data_type>
      <group>player</group>
      <description>Direct video stream</description>
    </attribute>
    <attribute>
      <name>twitter:player:stream:content_type</name>
      <data_type>MIME</data_type>
      <group>player</group>
      <description>Stream content type</description>
    </attribute>
    <attribute>
      <name>twitter:app:name:iphone</name>
      <data_type>String</data_type>
      <group>app</group>
    </attribute>
    <attribute>
      <name>twitter:app:id:iphone</name>
      <data_type>String</data_type>
      <group>app</group>
      <description>iTunes ID</description>
    </attribute>
    <attribute>
      <name>twitter:app:url:iphone</name>
      <data_type>URL</data_type>
      <group>app</group>
      <description>iOS deep link</description>
    </attribute>
    <attribute>
      <name>twitter:app:name:ipad / id:ipad / url:ipad</name>
      <data_type>String/URL</data_type>
      <group>app</group>
    </attribute>
    <attribute>
      <name>twitter:app:name:googleplay / id:googleplay / url:googleplay</name>
      <data_type>String/URL</data_type>
      <group>app</group>
      <description>Android equivalents</description>
    </attribute>
    <attribute>
      <name>twitter:app:country</name>
      <data_type>ISO 3166-1 alpha-2</data_type>
      <group>app</group>
      <description>App store country</description>
    </attribute>
    <attribute>
      <name>twitter:dnt</name>
      <data_type>Enum</data_type>
      <description>Privacy setting</description>
      <values>
        <value key="on">Do not track</value>
      </values>
    </attribute>
    <attribute>
      <name>twitter:url</name>
      <data_type>URL</data_type>
      <description>Canonical URL (optional override of og:url)</description>
    </attribute>
    <attribute>
      <name>twitter:domain</name>
      <data_type>String</data_type>
      <description>Domain shown in card</description>
    </attribute>
    <attribute>
      <name>twitter:label1 / data1</name>
      <data_type>String</data_type>
      <description>Custom labeled data field 1</description>
    </attribute>
    <attribute>
      <name>twitter:label2 / data2</name>
      <data_type>String</data_type>
      <description>Custom labeled data field 2</description>
    </attribute>
  </attributes>
</metadata_system>