<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="173" name="Time Machine Metadata" category="OS" category_label="Operating System / File System" used_for="Apple Time Machine backup volume metadata" spec_source="Apple Time Machine Programming Guide; APFS-based TM (macOS 11+)" completeness="comprehensive" record_count="21">
  <description>Time Machine creates hourly/daily/weekly snapshots stored on a backup destination. On modern macOS, TM uses APFS snapshots locally + a remote backup volume.</description>
  <attributes>
    <attribute>
      <name>Backup Volume UUID</name>
      <data_type>UUID</data_type>
      <description>TM destination volume identifier</description>
    </attribute>
    <attribute>
      <name>Backup Volume Path</name>
      <data_type>Path</data_type>
      <description>/Volumes/&lt;TM Drive&gt;/Backups.backupdb/&lt;Mac Name&gt;/</description>
    </attribute>
    <attribute>
      <name>Backup Snapshot Date</name>
      <data_type>ISO8601</data_type>
      <description>Backup folder name (YYYY-MM-DD-HHMMSS)</description>
    </attribute>
    <attribute>
      <name>Latest / Previous Symlinks</name>
      <data_type>Symlinks</data_type>
      <description>Latest and rolling pointers</description>
    </attribute>
    <attribute>
      <name>Source Volume UUID</name>
      <data_type>UUID</data_type>
      <description>Original volume backed up</description>
    </attribute>
    <attribute>
      <name>Source Volume Name</name>
      <data_type>String</data_type>
      <description>Original volume label</description>
    </attribute>
    <attribute>
      <name>Hostname</name>
      <data_type>String</data_type>
      <description>Mac that created the backup</description>
    </attribute>
    <attribute>
      <name>Mac Address</name>
      <data_type>MAC</data_type>
      <description>Backing-up Mac's primary MAC</description>
    </attribute>
    <attribute>
      <name>OS Version</name>
      <data_type>String</data_type>
      <description>macOS version at backup time</description>
    </attribute>
    <attribute>
      <name>TM Version</name>
      <data_type>Integer</data_type>
      <description>Format version</description>
    </attribute>
    <attribute>
      <name>Hard-link Snapshot</name>
      <data_type>Directory</data_type>
      <description>Each backup hardlinks unchanged files (legacy HFS+ TM)</description>
    </attribute>
    <attribute>
      <name>APFS TM Snapshot Name</name>
      <data_type>com.apple.TimeMachine.YYYY-MM-DD-HHMMSS.local</data_type>
      <description>On-disk snapshot name</description>
    </attribute>
    <attribute>
      <name>Local Snapshot (mobile backup)</name>
      <data_type>APFS snapshot</data_type>
      <description>Stored on internal disk for offline rollback</description>
    </attribute>
    <attribute>
      <name>.com.apple.timemachine.donotpresent</name>
      <data_type>Marker file</data_type>
      <description>Suppresses Time Machine UI access</description>
    </attribute>
    <attribute>
      <name>.exclusions.plist</name>
      <data_type>Plist</data_type>
      <description>Per-volume exclusion list</description>
    </attribute>
    <attribute>
      <name>com.apple.timemachine.SkipBackup xattr</name>
      <data_type>Boolean xattr</data_type>
      <description>Per-file exclusion</description>
    </attribute>
    <attribute>
      <name>com.apple.metadata:com_apple_backup_excludeItem xattr</name>
      <data_type>Boolean xattr</data_type>
      <description>Permanent exclusion marker</description>
    </attribute>
    <attribute>
      <name>TM Inheritance Token</name>
      <data_type>Binary</data_type>
      <description>Cross-disk migration linkage</description>
    </attribute>
    <attribute>
      <name>MachineID.plist</name>
      <data_type>Plist</data_type>
      <description>BackupAlias, HostUUID, MachineID</description>
    </attribute>
    <attribute>
      <name>VerificationState.plist</name>
      <data_type>Plist</data_type>
      <description>fsck status of backup</description>
    </attribute>
    <attribute>
      <name>TM Quota / Used Bytes</name>
      <data_type>Integer pair</data_type>
      <description>Reserved cap and current usage</description>
    </attribute>
  </attributes>
</metadata_system>