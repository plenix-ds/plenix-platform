<metadata_system id="174" name="System Restore Metadata" category="OS" category_label="Operating System / File System" used_for="Windows System Restore points / VSS shadow copies" spec_source="Microsoft System Restore documentation; Volume Shadow Copy Service" completeness="comprehensive" record_count="22">
