<metadata_system id="088" name="Web Server Log Metadata" category="FOR" category_label="Forensics / Activity" used_for="Website/server activity logs" spec_source="Apache HTTPD mod_log_config; Nginx log_format; W3C Extended Log Format" completeness="comprehensive" record_count="90">
  <description>Web server access/error logs come in three major dialects: Apache Common/Combined Log Format, NCSA Common, and W3C Extended (used by IIS). All log per-request fields about origin, request, response, and timing.</description>
