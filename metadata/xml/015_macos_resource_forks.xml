<metadata_system id="015" name="macOS Resource Forks" category="OS" category_label="Operating System / File System" used_for="Legacy Mac metadata/data (resource manager)" spec_source="Apple Inside Macintosh: More Macintosh Toolbox Ch. 1; HFS Plus Volume Format" completeness="substantial" record_count="30">
