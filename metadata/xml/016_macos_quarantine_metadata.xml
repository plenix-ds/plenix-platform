<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="016" name="macOS Quarantine Metadata" category="OS" category_label="Operating System / File System" used_for="Download/app safety (com.apple.quarantine xattr)" spec_source="Apple Gatekeeper documentation; LaunchServices Quarantine" completeness="comprehensive" record_count="15">
  <description>Set on every file written by a quarantine-aware application. Triggers Gatekeeper on first launch of executable code.</description>
  <attributes>
    <attribute>
      <name>Flags</name>
      <data_type>UInt32 hex</data_type>
      <description>Quarantine flags</description>
      <values>
        <value key="0x0001">kLSQuarantineEventSelf</value>
        <value key="0x0040">Already approved by user</value>
      </values>
    </attribute>
    <attribute>
