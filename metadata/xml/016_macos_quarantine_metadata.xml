      <data_type>Bit</data_type>
      <description>Source is other download</description>
    </attribute>
    <attribute>
      <name>Flag: kLSQuarantineTypeEmailAttachment</name>
      <data_type>Bit</data_type>
      <description>Email attachment</description>
    </attribute>
    <attribute>
      <name>Flag: kLSQuarantineTypeInstantMessageAttachment</name>
      <data_type>Bit</data_type>
      <description>iMessage/IM attachment</description>
    </attribute>
    <attribute>
      <name>Flag: kLSQuarantineTypeCalendarEventAttachment</name>
      <data_type>Bit</data_type>
      <description>Calendar attachment</description>
    </attribute>
    <attribute>
      <name>Flag: kLSQuarantineTypeOtherAttachment</name>
      <data_type>Bit</data_type>
