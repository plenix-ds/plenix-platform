<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="008" name="Windows Prefetch Metadata" category="FOR" category_label="Forensics / Activity" used_for="Program execution traces (.pf files in C:\Windows\Prefetch)" spec_source="libscca; Eric Zimmerman PECmd; SANS Prefetch reference" completeness="comprehensive" record_count="19">
  <description>Generated by Windows whenever an executable runs to speed subsequent launches; preserves rich execution evidence. Hash-named (e.g., NOTEPAD.EXE-D8414F97.pf). Compressed in Win10+.</description>
  <attributes>
    <attribute>
      <name>Format Version</name>
      <data_type>UInt32</data_type>
      <description>17=XP, 23=Vista/7, 26=Win8, 30=Win10/11</description>
    </attribute>
    <attribute>
      <name>Signature</name>
      <data_type>ASCII 'SCCA'</data_type>
      <description>File magic</description>
    </attribute>
    <attribute>
      <name>File Size</name>
      <data_type>UInt32</data_type>
      <description>Size of the .pf file</description>
    </attribute>
    <attribute>
      <name>Executable Name</name>
      <data_type>UTF-16, 60 chars</data_type>
      <description>Name of the program (uppercase)</description>
    </attribute>
    <attribute>
      <name>Prefetch Hash</name>
      <data_type>UInt32 hex</data_type>
      <description>Hash of executable path (last 8 hex chars of filename)</description>
    </attribute>
    <attribute>
      <name>Run Count</name>
      <data_type>UInt32</data_type>
      <description>Number of times executable has run</description>
    </attribute>
    <attribute>
      <name>Last Run Time</name>
      <data_type>FILETIME</data_type>
      <description>Most recent execution</description>
    </attribute>
    <attribute>
      <name>Last Run Time -1</name>
      <data_type>FILETIME (Win8+)</data_type>
      <description>2nd-most-recent execution</description>
    </attribute>
    <attribute>
      <name>Last Run Time -2 through -7</name>
      <data_type>FILETIME × 6 (Win8+)</data_type>
      <description>Up to 8 most recent executions retained</description>
    </attribute>
    <attribute>
      <name>Volume Path</name>
      <data_type>UTF-16</data_type>
      <group>Volume</group>
      <description>\DEVICE\HARDDISKVOLUMEx form</description>
    </attribute>
    <attribute>
      <name>Volume Creation Time</name>
      <data_type>FILETIME</data_type>
      <group>Volume</group>
      <description>When the volume was created</description>
    </attribute>
    <attribute>
      <name>Volume Serial Number</name>
      <data_type>UInt32 hex</data_type>
      <group>Volume</group>
      <description>NTFS volume serial</description>
    </attribute>
    <attribute>
      <name>Number of File Metrics</name>
      <data_type>UInt32</data_type>
      <description>Count of files referenced</description>
    </attribute>
    <attribute>
      <name>File Metrics Array</name>
      <data_type>Array of records</data_type>
      <description>Each entry: filename offset, length, NTFS reference</description>
    </attribute>
    <attribute>
      <name>Trace Chains</name>
      <data_type>Array</data_type>
      <description>Memory page access chains</description>
    </attribute>
    <attribute>
      <name>Filename Strings</name>
      <data_type>UTF-16 sequence</data_type>
      <description>All DLLs/files referenced during first 10 seconds of execution</description>
    </attribute>
    <attribute>
      <name>Number of Filenames</name>
      <data_type>UInt32</data_type>
      <description>Count of referenced filenames</description>
    </attribute>
    <attribute>
      <name>Number of Directories</name>
      <data_type>UInt32 (Win10+)</data_type>
      <description>Directory string count</description>
    </attribute>
    <attribute>
      <name>Directory Strings</name>
      <data_type>UTF-16 sequence (Win10+)</data_type>
      <description>Directories accessed</description>
    </attribute>
  </attributes>
</metadata_system>