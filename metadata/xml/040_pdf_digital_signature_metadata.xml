    </attribute>
    <attribute>
      <name>/SubFilter</name>
      <data_type>Name</data_type>
      <group>Sig dict</group>
      <description>Encoding format — adbe.x509.rsa_sha1 (legacy), adbe.pkcs7.detached, adbe.pkcs7.sha1, ETSI.CAdES.detached, ETSI.RFC3161 (timestamp)</description>
    </attribute>
    <attribute>
      <name>/Contents</name>
      <data_type>Hex string (PKCS#7)</data_type>
      <group>Sig dict</group>
