<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="040" name="PDF Digital Signature Metadata" category="SEC" category_label="Security / Authenticity" used_for="Signed PDFs (/Sig signature dictionaries)" spec_source="ISO 32000-2 §12.8 Digital Signatures; ETSI EN 319 142 (PAdES)" completeness="comprehensive" record_count="39">
  <description>Cryptographic signatures applied to PDFs. Approval signatures embed in form field values; certification signatures lock the document. Modern PAdES levels add LTV (long-term validation).</description>
  <attributes>
    <attribute>
      <name>Signature Field (form field)</name>
      <data_type>Annotation</data_type>
      <description>/FT /Sig form field that holds the signature value</description>
    </attribute>
    <attribute>
      <name>Field Name (T)</name>
      <data_type>String</data_type>
      <description>Field identifier</description>
    </attribute>
    <attribute>
      <name>Lock Dictionary (/Lock)</name>
      <data_type>Dictionary</data_type>
      <description>Defines which fields are locked after signing</description>
    </attribute>
    <attribute>
      <name>Lock Action</name>
      <data_type>Name (/All /Include /Exclude)</data_type>
      <description>Lock scope</description>
    </attribute>
    <attribute>
      <name>Lock Fields</name>
      <data_type>Array</data_type>
      <description>Field names included/excluded</description>
    </attribute>
    <attribute>
      <name>Signature Value (V)</name>
      <data_type>Signature dictionary</data_type>
      <description>The actual signature data</description>
    </attribute>
    <attribute>
      <name>/Type /Sig</name>
