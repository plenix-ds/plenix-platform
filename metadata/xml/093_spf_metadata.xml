<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="093" name="SPF Metadata" category="WEB" category_label="Web / Email" used_for="Email sender authorization (DNS TXT records)" spec_source="RFC 7208 — Sender Policy Framework" completeness="comprehensive" record_count="36">
  <description>SPF authorizes which sending IPs may send mail on a domain's behalf via DNS TXT record at the domain root.</description>
  <attributes>
    <attribute>
      <name>v=spf1</name>
      <data_type>Version tag</data_type>
      <required>true</required>
      <description>SPF version (always 'spf1')</description>
    </attribute>
    <attribute>
      <name>Mechanism: all</name>
      <data_type>Match all</data_type>
      <description>Always matches; placed last with qualifier</description>
    </attribute>
    <attribute>
      <name>Mechanism: ip4</name>
      <data_type>ip4:&lt;addr&gt;[/&lt;cidr&gt;]</data_type>
      <description>Authorize IPv4 address/range</description>
    </attribute>
    <attribute>
      <name>Mechanism: ip6</name>
      <data_type>ip6:&lt;addr&gt;[/&lt;cidr&gt;]</data_type>
      <description>Authorize IPv6 address/range</description>
    </attribute>
    <attribute>
      <name>Mechanism: a</name>
      <data_type>a[:&lt;domain&gt;][/&lt;cidr&gt;]</data_type>
      <description>Authorize IPs in domain's A/AAAA records</description>
    </attribute>
    <attribute>
      <name>Mechanism: mx</name>
      <data_type>mx[:&lt;domain&gt;][/&lt;cidr&gt;]</data_type>
      <description>Authorize IPs in domain's MX records</description>
    </attribute>
    <attribute>
      <name>Mechanism: ptr</name>
      <data_type>ptr[:&lt;domain&gt;]</data_type>
      <description>Authorize via reverse DNS (deprecated, do not use)</description>
    </attribute>
    <attribute>
      <name>Mechanism: exists</name>
      <data_type>exists:&lt;domain&gt;</data_type>
      <description>Match if domain has any A record (used for DNSBL-style lookups)</description>
    </attribute>
    <attribute>
      <name>Mechanism: include</name>
      <data_type>include:&lt;domain&gt;</data_type>
      <description>Recursively evaluate another domain's SPF (e.g., include:_spf.google.com)</description>
    </attribute>
    <attribute>
      <name>Modifier: redirect</name>
      <data_type>redirect=&lt;domain&gt;</data_type>
      <description>Replace whole policy with target domain's</description>
    </attribute>
    <attribute>
      <name>Modifier: exp</name>
      <data_type>exp=&lt;domain&gt;</data_type>
      <description>Domain providing explanation TXT for failures</description>
    </attribute>
    <attribute>
      <name>Qualifier: + (Pass)</name>
      <data_type>Default qualifier</data_type>
      <description>Match results in Pass</description>
    </attribute>
    <attribute>
      <name>Qualifier: - (Fail)</name>
      <data_type>Hard fail</data_type>
      <description>Reject the message</description>
    </attribute>
    <attribute>
      <name>Qualifier: ~ (SoftFail)</name>
      <data_type>Soft fail</data_type>
      <description>Mark suspicious but accept</description>
    </attribute>
    <attribute>
      <name>Qualifier: ? (Neutral)</name>
      <data_type>Neutral</data_type>
      <description>No statement of authorization</description>
    </attribute>
    <attribute>
      <name>Macros: %{s}</name>
      <data_type>Macro</data_type>
      <description>Sender (MAIL FROM)</description>
    </attribute>
    <attribute>
      <name>Macros: %{l}</name>
      <data_type>Macro</data_type>
      <description>Local part of sender</description>
    </attribute>
    <attribute>
      <name>Macros: %{o}</name>
      <data_type>Macro</data_type>
      <description>Sender domain</description>
    </attribute>
    <attribute>
      <name>Macros: %{d}</name>
      <data_type>Macro</data_type>
      <description>Current domain being evaluated</description>
    </attribute>
    <attribute>
      <name>Macros: %{i}</name>
      <data_type>Macro</data_type>
      <description>Sending IP address</description>
    </attribute>
    <attribute>
      <name>Macros: %{p}</name>
      <data_type>Macro</data_type>
      <description>Validated reverse DNS name (avoid)</description>
    </attribute>
    <attribute>
      <name>Macros: %{v}</name>
      <data_type>Macro</data_type>
      <description>'in-addr' or 'ip6'</description>
    </attribute>
    <attribute>
      <name>Macros: %{h}</name>
      <data_type>Macro</data_type>
      <description>HELO/EHLO domain</description>
    </attribute>
    <attribute>
      <name>Macros: %{c}</name>
      <data_type>Macro</data_type>
      <description>SMTP client IP (for exp= only)</description>
    </attribute>
    <attribute>
      <name>Macros: %{r}</name>
      <data_type>Macro</data_type>
      <description>Receiving domain (for exp= only)</description>
    </attribute>
    <attribute>
      <name>Macros: %{t}</name>
      <data_type>Macro</data_type>
      <description>Current Unix timestamp (for exp= only)</description>
    </attribute>
    <attribute>
      <name>Result: pass</name>
      <data_type>Verdict</data_type>
      <description>Authorized sender</description>
    </attribute>
    <attribute>
      <name>Result: fail</name>
      <data_type>Verdict</data_type>
      <description>Not authorized — should reject</description>
    </attribute>
    <attribute>
      <name>Result: softfail</name>
      <data_type>Verdict</data_type>
      <description>Probably not authorized — accept and mark</description>
    </attribute>
    <attribute>
      <name>Result: neutral</name>
      <data_type>Verdict</data_type>
      <description>No assertion</description>
    </attribute>
    <attribute>
      <name>Result: none</name>
      <data_type>Verdict</data_type>
      <description>No SPF record published</description>
    </attribute>
    <attribute>
      <name>Result: temperror</name>
      <data_type>Verdict</data_type>
      <description>Transient DNS error</description>
    </attribute>
    <attribute>
      <name>Result: permerror</name>
      <data_type>Verdict</data_type>
      <description>Permanent SPF parse error</description>
    </attribute>
    <attribute>
      <name>Lookup limit</name>
      <data_type>Counter</data_type>
      <description>≤10 DNS lookups via include/a/mx/ptr/exists/redirect — exceeding causes permerror</description>
    </attribute>
    <attribute>
      <name>Void lookup limit</name>
      <data_type>Counter</data_type>
      <description>≤2 DNS lookups returning empty (RFC 7208 §4.6.4)</description>
    </attribute>
    <attribute>
      <name>Received-SPF: header</name>
      <data_type>Header</data_type>
      <description>Logs SPF result on receiver side</description>
    </attribute>
  </attributes>
</metadata_system>