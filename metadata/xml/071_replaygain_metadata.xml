<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="071" name="ReplayGain Metadata" category="AUD" category_label="Audio" used_for="Audio loudness normalization" spec_source="ReplayGain 2.0 specification (replaygain.org); EBU R128" completeness="comprehensive" record_count="21">
  <description>ReplayGain stores per-track and per-album loudness adjustments in audio file metadata so playback software can normalize playback level across tracks/albums. Originally based on equal loudness contour; modern implementations use EBU R128 / ITU-R BS.1770.</description>
  <attributes>
    <attribute>
      <name>REPLAYGAIN_TRACK_GAIN</name>
      <data_type>String '&lt;n.nn&gt; dB'</data_type>
      <description>Gain to apply to track relative to reference</description>
    </attribute>
    <attribute>
      <name>REPLAYGAIN_TRACK_PEAK</name>
      <data_type>String '&lt;n.nnnnnn&gt;'</data_type>
      <description>Peak amplitude (0.0-1.0+) — sample value, not dB</description>
    </attribute>
    <attribute>
      <name>REPLAYGAIN_ALBUM_GAIN</name>
      <data_type>String '&lt;n.nn&gt; dB'</data_type>
      <description>Album-mode gain (matches loudest track on album)</description>
    </attribute>
    <attribute>
      <name>REPLAYGAIN_ALBUM_PEAK</name>
      <data_type>String '&lt;n.nnnnnn&gt;'</data_type>
      <description>Album peak</description>
    </attribute>
    <attribute>
      <name>REPLAYGAIN_REFERENCE_LOUDNESS</name>
      <data_type>String '89.0 dB'</data_type>
      <description>Reference level (default 89 dB SPL)</description>
    </attribute>
    <attribute>
      <name>REPLAYGAIN_TRACK_RANGE</name>
      <data_type>String '&lt;n.nn&gt; dB' (RG2)</data_type>
      <description>Track loudness range (LRA)</description>
    </attribute>
    <attribute>
      <name>REPLAYGAIN_ALBUM_RANGE</name>
      <data_type>String '&lt;n.nn&gt; dB' (RG2)</data_type>
      <description>Album loudness range</description>
    </attribute>
    <attribute>
      <name>MP3 / ID3v2 — TXXX:REPLAYGAIN_TRACK_GAIN etc.</name>
