<?xml version='1.0' encoding='utf-8'?>
<metadata_system id="021" name="POSIX ACL Metadata" category="OS" category_label="Operating System / File System" used_for="Advanced permissions (POSIX 1003.1e draft 17)" spec_source="POSIX 1003.1e draft 17; Linux acl(5); FreeBSD acl(3)" completeness="comprehensive" record_count="12">
  <description>Extends the basic owner/group/other permission model. Stored in system.posix_acl_access (per-file ACL) and system.posix_acl_default (directory inheritance).</description>
  <attributes>
    <attribute>
      <name>ACL Version</name>
      <data_type>UInt32</data_type>
      <description>Always 2</description>
    </attribute>
    <attribute>
      <name>ACL_USER_OBJ</name>
      <data_type>ACE</data_type>
      <description>Owner permissions (mirrors st_mode owner bits)</description>
    </attribute>
    <attribute>
      <name>ACL_USER</name>
      <data_type>ACE with UID</data_type>
      <description>Specific user permissions</description>
    </attribute>
    <attribute>
      <name>ACL_GROUP_OBJ</name>
      <data_type>ACE</data_type>
      <description>Owning group permissions</description>
    </attribute>
    <attribute>
      <name>ACL_GROUP</name>
      <data_type>ACE with GID</data_type>
      <description>Specific group permissions</description>
    </attribute>
    <attribute>
      <name>ACL_MASK</name>
      <data_type>ACE</data_type>
      <description>Maximum permissions for ACL_USER, ACL_GROUP, ACL_GROUP_OBJ</description>
    </attribute>
    <attribute>
      <name>ACL_OTHER</name>
      <data_type>ACE</data_type>
      <description>Others permissions (mirrors st_mode other bits)</description>
    </attribute>
    <attribute>
      <name>ACL Tag (e_tag)</name>
      <data_type>UInt16</data_type>
      <description>Type of entry (USER, GROUP, MASK, OTHER, USER_OBJ, GROUP_OBJ)</description>
      <values>
        <value key="0x01">ACL_USER_OBJ</value>
        <value key="0x02">ACL_USER</value>
        <value key="0x04">ACL_GROUP_OBJ</value>
        <value key="0x08">ACL_GROUP</value>
        <value key="0x10">ACL_MASK</value>
        <value key="0x20">ACL_OTHER</value>
      </values>
    </attribute>
    <attribute>
      <name>ACL Permissions (e_perm)</name>
      <data_type>UInt16</data_type>
      <description>Read (4), Write (2), Execute (1) bitmask</description>
    </attribute>
    <attribute>
      <name>ACL Qualifier (e_id)</name>
      <data_type>UInt32</data_type>
      <description>UID or GID for ACL_USER/ACL_GROUP entries</description>
    </attribute>
    <attribute>
      <name>Default ACL (directories only)</name>
      <data_type>Whole ACL</data_type>
      <description>Inherited by new files/subdirectories</description>
    </attribute>
    <attribute>
      <name>Effective Permissions Calculation</name>
      <data_type>Computed</data_type>
      <description>acl_user|group AND mask = effective rights</description>
    </attribute>
  </attributes>
</metadata_system>