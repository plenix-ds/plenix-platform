{
  "defaultSeverity": "warning",
  "plugins": ["./tools/stylelint/plenix.mjs"],
  "rules": {
    "plenix/token-tiers": [true, { "severity": "error", "allowedPattern": "^--ds-sample-[a-z-]+$", "allowedIn": "^platform/design-system/" }],
    "plenix/logical-properties": [true, { "severity": "error", "files": "^platform/(components|patterns|templates)/" }],
    "declaration-no-important": [true, { "severity": "error" }],
    "color-no-hex": [true, { "severity": "error" }],
    "function-disallowed-list": [["rgb", "rgba", "hsl", "hsla", "hwb", "lab", "lch", "oklab", "oklch"], { "severity": "error" }],
    "declaration-property-value-disallowed-list": [{
      "/^border(-.+)?-radius$/": ["/(^|[\\s(,])-?(?!0+(\\.0+)?(px|rem|em|%)(?![\\w-]))[0-9.]+(px|rem|em|%)/"],
      "/.*/": ["/(?<!\\w)(?<!\\w-)(?!-?0+(\\.0+)?(px|rem|em|ms|s|vh|vw|ch|pt)(?![\\w-]))-?\\d*\\.?\\d+(px|rem|em|ms|s|vh|vw|ch|pt)(?![\\w-])/",
        "/var\\(\\s*--plx-ref-color-/",
        "/var\\(\\s*--plx-ref-(font-sans|font-mono|font-weight|letter-spacing|radius|border-width|border-style|motion|opacity)/"]
    }, { "severity": "error", "message": "%s: %s: no raw length, time or color; a color comes from a role (--plx-sys-, --plx-comp-), never the palette (--plx-ref-color-); a typeface, weight, letter spacing, radius, border, motion or opacity from the theme's scale (--plx-sys-typeface-, -shape-, -border-width-…), never --plx-ref-" }],
    "selector-disallowed-list": [["/\\.plx-property-list--table\\b/"], { "severity": "error", "message": "the PropertyList table variant is retired: every table is a Table or a DataGrid (batches 226, 229, 234)" }],
    "property-no-unknown": true,
    "no-duplicate-selectors": true,
    "declaration-block-no-duplicate-properties": true
  },
  "overrides": [
    { "files": ["platform/system/**/*.css", "platform/components/**/*.css", "platform/patterns/**/*.css"],
      "rules": { "selector-class-pattern": ["^(plx-|is-)", { "severity": "error", "message": "%s is not a plx- class: a Platform stylesheet defines plx- classes (state classes is-…)" }] } },
    { "files": ["platform/components/RichTextEditor/rich-text-editor.css"],
      "rules": { "selector-class-pattern": ["^(plx-|is-|ProseMirror-(separator|hideselection|selectednode)$|selectedCell$)", { "severity": "error", "message": "%s is not a plx- class (only the editor engine's ProseMirror-separator, -hideselection, -selectednode and selectedCell are allowed here)" }] } }
  ]
}
