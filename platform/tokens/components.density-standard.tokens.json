{
  "$description": "components tokens written under :root,[data-plx-density=\"standard\"]",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/components.css",
      "selector": ":root,[data-plx-density=\"standard\"]",
      "opener": ":root,[data-plx-density=\"standard\"]{"
    }
  },
  "plx-comp": {
    "button-icon-label-gap": {
      "$value": "{plx-ref.space-4px}",
      "$type": "dimension"
    },
    "button-padding-inline": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "button-cluster-gap": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "field-label-control-gap": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "field-control-helper-gap": {
      "$value": "{plx-ref.space-4px}",
      "$type": "dimension"
    },
    "form-field-gap": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "form-group-gap": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "form-section-gap": {
      "$value": "{plx-ref.space-32px}",
      "$type": "dimension"
    },
    "toolbar-control-gap": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "toolbar-group-gap": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "toolbar-padding-inline": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "toolbar-padding-block": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "toolbar-content-gap": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "card-padding": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "card-title-content-gap": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "card-content-actions-gap": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "card-stack-gap": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "panel-padding": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "dialog-padding": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "dialog-title-body-gap": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "dialog-body-footer-gap": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "dialog-action-gap": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "drawer-padding": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "metadata-item-gap": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "metadata-icon-gap": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "metadata-title-gap": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "metadata-group-gap": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    }
  }
}
