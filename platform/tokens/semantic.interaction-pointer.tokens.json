{
  "$description": "semantic tokens written under :root[data-plx-interaction=\"pointer\"]",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/semantic.css",
      "selector": ":root[data-plx-interaction=\"pointer\"]",
      "opener": ":root[data-plx-interaction=\"pointer\"]{"
    }
  },
  "plx-sys": {
    "control-target-min": {
      "$value": "{plx-ref.control-size-24px}",
      "$type": "dimension",
      "$extensions": {
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "rule",
            "level": "required by the source",
            "framework": "WCAG 2.2",
            "version": "2.2 (W3C Recommendation)",
            "name": "SC 2.5.8 Target Size (Minimum), AA",
            "published": "24×24 CSS px",
            "url": "https://www.w3.org/WAI/WCAG22/Understanding/target-size-minimum.html"
          }
        }
      }
    }
  }
}
