{
  "$description": "components tokens written under :root[data-plx-interaction=\"mobile\"],:root[data-plx-interaction=\"mobile\"] [data-plx-density]",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/components.css",
      "selector": ":root[data-plx-interaction=\"mobile\"],:root[data-plx-interaction=\"mobile\"] [data-plx-density]",
      "opener": ":root[data-plx-interaction=\"mobile\"],:root[data-plx-interaction=\"mobile\"] [data-plx-density]{"
    }
  },
  "plx-comp": {
    "button-target-inset-block": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "button-target-inset-inline": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "breadcrumbs-list-row-gap": {
      "$value": "calc({plx-sys.control-target-min} - 1lh)",
      "$type": "dimension",
      "$description": "With a phone a wrapped trail's rows part by the minimum target less one line, so the links' 44px targets of one row do not cover the next (Platforms Standard 3.2)"
    },
    "toolbar-control-gap": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "button-cluster-gap": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension",
      "$extensions": {
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "plenix",
            "level": "Plenix requirement",
            "framework": "Plenix",
            "version": "Platforms Standard 3.2",
            "name": "Spacing between targets, coarse pointer",
            "published": "12px (matches the Apple HIG figure of about 12 pt)",
            "url": "platform/standards/platforms.md#32-spacing-between-targets"
          }
        }
      }
    },
    "dialog-action-gap": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension",
      "$extensions": {
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "plenix",
            "level": "Plenix requirement",
            "framework": "Plenix",
            "version": "Platforms Standard 3.2",
            "name": "Spacing between targets, coarse pointer",
            "published": "12px (matches the Apple HIG figure of about 12 pt)",
            "url": "platform/standards/platforms.md#32-spacing-between-targets"
          }
        }
      }
    },
    "card-padding": {
      "$value": "{plx-ref.space-16px}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): use --plx-sys-space-component-gap-lg instead (the same value in every theme and density). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    },
    "dialog-padding": {
      "$value": "{plx-ref.space-16px}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): use --plx-sys-space-container-inset-lg instead (the same value in every theme and density). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    }
  }
}
