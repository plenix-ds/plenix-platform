{
  "$description": "components tokens written under :root[data-plx-interaction=\"touch\"],:root[data-plx-interaction=\"touch\"] [data-plx-density]",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/components.css",
      "selector": ":root[data-plx-interaction=\"touch\"],:root[data-plx-interaction=\"touch\"] [data-plx-density]",
      "opener": ":root[data-plx-interaction=\"touch\"],:root[data-plx-interaction=\"touch\"] [data-plx-density]{"
    }
  },
  "plx-comp": {
    "breadcrumbs-list-row-gap": {
      "$value": "calc({plx-sys.control-target-min} - 1lh)",
      "$type": "dimension",
      "$description": "With touch a wrapped trail's rows part by the minimum target less one line, so the links' 44px targets of one row do not cover the next (Platforms Standard 3.2)"
    },
    "toolbar-control-gap": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "button-cluster-gap": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension",
      "$extensions": {
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "plenix",
            "level": "Plenix requirement",
            "framework": "Plenix",
            "version": "Platforms Standard 3.2",
            "name": "Spacing between targets, coarse pointer",
            "published": "12px (matches the Apple HIG figure of about 12 pt)",
            "url": "platform/standards/platforms.md#32-spacing-between-targets"
          }
        }
      }
    },
    "dialog-action-gap": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension",
      "$extensions": {
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "plenix",
            "level": "Plenix requirement",
            "framework": "Plenix",
            "version": "Platforms Standard 3.2",
            "name": "Spacing between targets, coarse pointer",
            "published": "12px (matches the Apple HIG figure of about 12 pt)",
            "url": "platform/standards/platforms.md#32-spacing-between-targets"
          }
        }
      }
    },
    "card-padding": {
      "$value": "{plx-ref.space-16px}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): use --plx-ref-space-16px (its value) instead. It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    },
    "app-header-utilities-gap": {
      "$value": "{plx-ref.space-4px}",
      "$type": "dimension"
    },
    "button-target-inset-block": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "button-target-inset-inline": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "tag-remove-before-inset-block-end": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "tag-remove-before-inset-block-start": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "tag-remove-before-inset-inline-end": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "tag-remove-before-inset-inline-start": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "tag-input-add-before-inset-block-end": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "tag-input-add-before-inset-block-start": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "tag-input-add-before-inset-inline-end": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "tag-input-add-before-inset-inline-start": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "combobox-input-margin-block": {
      "$value": "calc({plx-comp.input-border-width} * -1)",
      "$type": "dimension",
      "$description": "With touch the combobox's input (stretched to the field) reaches over the field's border, so its target is the field's full 44px height (Platforms Standard 3.1)"
    },
    "field-info-before-inset-block-end": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "field-info-before-inset-block-start": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "field-info-before-inset-inline-end": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "field-info-before-inset-inline-start": {
      "$value": "min(0px, calc((100% - {plx-sys.control-target-min}) / 2))",
      "$type": "dimension"
    },
    "data-grid-lead-column-width": {
      "$value": "{plx-sys.control-target-min}",
      "$type": "dimension",
      "$description": "With touch the lead column (the selection checkbox, a mark, a row handle) is the minimum target wide; the checkbox's label fills the cell (Platforms Standard 3.1)"
    },
    "tag-list-gap": {
      "$value": "calc({plx-sys.control-target-min} - {plx-comp.tag-remove-width})",
      "$type": "dimension",
      "$description": "With touch the tags part by the minimum target less the × box (28px), so the × target of a tag (44px around its 16px box) and the next target (a chip, the +) do not overlap"
    },
    "tag-list-row-gap": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension",
      "$description": "With touch the rows part by the minimum target less the 20px tag (24px), so the 44px targets of one row do not cover the next"
    },
    "tag-list-padding-block": {
      "$value": "calc(({plx-sys.control-target-min} - {plx-sys.label-height-20px}) / 2)",
      "$type": "dimension",
      "$description": "With touch a tag list keeps half the minimum target less the 20px tag (12px) above and below, so its 44px targets stay inside it and never cover the controls of the row above or below"
    },
    "color-picker-slot-min-width": {
      "$value": "{plx-sys.control-target-min}",
      "$type": "dimension"
    }
  }
}
