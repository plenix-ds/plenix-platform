    "font-sans": {
      "$value": ["DM Sans", "IBM Plex Sans Arabic", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Arial", "sans-serif"],
      "$type": "fontFamily",
      "$description": "The sans stack: DM Sans, then IBM Plex Sans Arabic for Arabic letters only (owner, arabic-font-35).",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* ── TYPOGRAPHY: families ── */"
          ]
        }
      }
