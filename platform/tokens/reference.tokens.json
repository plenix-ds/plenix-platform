    "font-sans-title": {
      "$value": ["DM Sans", "Readex Pro", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Arial", "sans-serif"],
      "$type": "fontFamily",
      "$description": "The titles' stack: DM Sans, then Readex Pro for Arabic letters only (owner, arabic-font-35). Latin titles are DM Sans, as before."
    },
    "font-mono": {
      "$value": ["Reddit Mono", "IBM Plex Sans Arabic", "ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", "monospace"],
      "$type": "fontFamily",
      "$description": "The code and data stack: Reddit Mono, then IBM Plex Sans Arabic for Arabic letters only (owner, arabic-font-35), so Arabic in data text and chart axes is drawn joined, not by a system monospace font."
