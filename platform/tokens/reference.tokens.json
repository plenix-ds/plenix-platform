{
  "$description": "reference tokens written under :root",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/reference.css",
      "selector": ":root",
      "opener": ":root {"
    }
  },
  "plx-ref": {
    "color-black-alpha-50": {
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.502, "hex": "#000000" },
      "$type": "color"
    },
    "color-black-alpha-14": {
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1412, "hex": "#000000" },
      "$type": "color"
    },
    "color-black-alpha-20": {
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.2, "hex": "#000000" },
      "$type": "color",
      "$description": "Black at 20% (owner, 2026-10-15): the closest layer of the Lifted shadow (Material elevation)."
    },
    "color-black-alpha-12": {
      "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1216, "hex": "#000000" },
      "$type": "color",
      "$description": "Black at 12% (owner, 2026-10-15): the widest layer of the Lifted shadow (Material elevation)."
    },
    "font-size-09": {
      "$value": { "value": 0.5625, "unit": "rem" },
