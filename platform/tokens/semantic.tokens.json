{
  "$description": "semantic tokens written under :root",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/semantic.css",
      "selector": ":root",
      "opener": ":root {"
    }
  },
  "plx-sys": {
    "icon-size": {
      "$value": "{plx-ref.size-16px}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* ── ICONS: the default icon box. 16px while the icon files are drawn edge to edge; after the redraw (Iconography),",
            "     20px for pointer and 24px for touch and mobile ── */"
          ]
        }
      }
    },
    "icon-size-xs": {
      "$value": "{plx-ref.size-12px}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* the named icon sizes (Icon size=\"xs | sm | md | lg\"), all on the 4px grid; inside a control the icon takes the",
            "     control's grid icon instead (--plx-sys-control-icon-<role>) */"
          ]
        }
      }
    },
    "icon-size-sm": {
      "$value": "{plx-ref.size-16px}",
      "$type": "dimension"
    },
    "icon-size-md": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "icon-size-lg": {
      "$value": "{plx-ref.size-24px}",
      "$type": "dimension"
    },
    "icon-size-xl": {
      "$value": "{plx-ref.size-48px}",
      "$type": "dimension"
    },
    "shell-phone-below": {
      "$value": "{plx-ref.breakpoint-600px}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* the window classes (Platforms Standard 3.3): Narrow below 600px, Medium to 839px, Wide from 840px. Narrow: the",
            "     navigation is a bottom bar and the pane a screen of its own; a page puts its main content first */"
          ]
        },
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "token",
            "level": "recommended by the source",
            "framework": "Material 3",
            "version": "unversioned (living guidelines)",
            "name": "Breakpoints: Medium (Narrow below)",
            "published": "600 dp",
            "url": "https://m3.material.io/foundations/layout/breakpoints/overview"
          }
        }
      },
      "$description": "Narrow window (Platforms Standard 3.3): below this width the navigation is a bottom bar and the pane a screen of its own"
    },
    "safe-area-top": {
      "$value": "env(safe-area-inset-top, 0px)",
      "$type": "dimension",
      "$description": "The top safe area (a notch, the status bar): the header stays below it (Platforms Standard 3.5)",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* the safe areas (Platforms Standard 3.5): what the device keeps for itself at each edge; every page sets",
            "     viewport-fit=cover, so the shell keeps its content inside them. 0 where the device keeps nothing */"
          ]
        },
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "rule",
            "level": "required by the source",
            "framework": "CSS Environment Variables",
            "version": "Editor's Draft",
            "name": "safe-area-inset-*",
            "published": "env(safe-area-inset-*) with viewport-fit=cover",
            "url": "https://drafts.csswg.org/css-env-1/#safe-area-insets"
          }
        }
      }
    },
    "safe-area-bottom": {
      "$value": "env(safe-area-inset-bottom, 0px)",
      "$type": "dimension",
      "$description": "The bottom safe area (the home indicator, gesture navigation): the bottom bar and the footer stay above it",
      "$extensions": {
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "rule",
            "level": "required by the source",
            "framework": "CSS Environment Variables",
            "version": "Editor's Draft",
            "name": "safe-area-inset-*",
            "published": "env(safe-area-inset-*) with viewport-fit=cover",
            "url": "https://drafts.csswg.org/css-env-1/#safe-area-insets"
          }
        }
      }
    },
    "safe-area-start": {
      "$value": "env(safe-area-inset-left, 0px)",
      "$type": "dimension",
      "$description": "The left safe area (landscape with a notch)",
      "$extensions": {
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "rule",
            "level": "required by the source",
            "framework": "CSS Environment Variables",
            "version": "Editor's Draft",
            "name": "safe-area-inset-*",
            "published": "env(safe-area-inset-*) with viewport-fit=cover",
            "url": "https://drafts.csswg.org/css-env-1/#safe-area-insets"
          }
        }
      }
    },
    "safe-area-end": {
      "$value": "env(safe-area-inset-right, 0px)",
      "$type": "dimension",
      "$description": "The right safe area (landscape with a notch)",
      "$extensions": {
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "rule",
            "level": "required by the source",
            "framework": "CSS Environment Variables",
            "version": "Editor's Draft",
            "name": "safe-area-inset-*",
            "published": "env(safe-area-inset-*) with viewport-fit=cover",
            "url": "https://drafts.csswg.org/css-env-1/#safe-area-insets"
          }
        }
      }
    },
    "touch-long-press-delay": {
      "$value": "{plx-ref.motion-delay-long-press}",
      "$type": "duration",
      "$description": "How long a finger rests on a control before it counts as a long press (Android's long-press timeout is 400 to 500ms); a long press shows a tooltip on touch (Platforms Standard 6.5)"
    },
    "touch-dismiss-delay": {
      "$value": "{plx-ref.motion-delay-dismiss}",
      "$type": "duration",
      "$description": "How long a tooltip opened by a long press stays after the finger lifts (Material 3 › Tooltips: 1.5s)"
    },
    "font-body": {
      "$value": "{plx-sys.typeface-sans}",
      "$type": "fontFamily",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* ── TYPOGRAPHY: font roles ── */"
          ]
        }
      }
    },
    "font-heading": {
      "$value": "{plx-sys.typeface-sans}",
      "$type": "fontFamily"
    },
    "font-label": {
      "$value": "{plx-sys.typeface-sans}",
      "$type": "fontFamily"
    },
    "font-code": {
      "$value": "{plx-sys.typeface-mono}",
      "$type": "fontFamily"
    },
    "font-data": {
      "$value": "{plx-sys.typeface-mono}",
      "$type": "fontFamily"
    },
    "font-data-word-spacing": {
      "$value": "{plx-ref.word-spacing-mono-fit}",
      "$type": "dimension",
      "$description": "Every Reddit Mono text (data, code, numbers): its word spacing, so a space is as wide as DM Sans's beside it (the text-data and text-code roles carry it; check-system rule text-contract)."
    },
    "layer-behind": {
      "$value": "-1",
      "$type": "number",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* ── LAYERS: one level per stacking purpose, lowest to highest ── */"
          ]
        }
      }
    },
    "layer-base": {
      "$value": "0",
      "$type": "dimension"
    },
    "layer-raised": {
      "$value": "1",
      "$type": "number"
    },
    "layer-sticky": {
      "$value": "10",
      "$type": "number"
    },
    "layer-menu": {
      "$value": "100",
      "$type": "number"
    },
    "layer-overlay": {
      "$value": "1000",
      "$type": "number"
    },
    "layer-modal": {
      "$value": "1100",
      "$type": "number"
    },
    "layer-popover": {
      "$value": "1200",
      "$type": "number"
    },
    "layer-toast": {
      "$value": "1300",
      "$type": "number"
    },
    "layer-critical": {
      "$value": "9999",
      "$type": "number"
    },
    "radius-detail-4px": {
      "$value": "{plx-sys.shape-xs}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* ── RADIUS: roles (role + value) ── */"
          ]
        }
      }
    },
    "radius-compact-4px": {
      "$value": "{plx-sys.shape-xs}",
      "$type": "dimension"
    },
    "radius-pill-4px": {
      "$value": "{plx-sys.shape-xs}",
      "$type": "dimension",
      "$description": "Pills: every status, tag and category pill, and the count pill, has 4px corners (owner, 2026-10-14, docs/pills-and-colors.md). The fully round shape (--plx-sys-shape-pill) is for dots, toggles and round marks, never for pills."
    },
    "radius-control-4px": {
      "$value": "{plx-sys.shape-xs}",
      "$type": "dimension"
    },
    "radius-control-6px": {
      "$value": "{plx-sys.shape-sm}",
      "$type": "dimension"
    },
    "radius-media-4px": {
      "$value": "{plx-sys.shape-xs}",
      "$type": "dimension"
    },
    "radius-media-6px": {
      "$value": "{plx-sys.shape-sm}",
      "$type": "dimension"
    },
    "radius-surface-4px": {
      "$value": "{plx-sys.shape-xs}",
      "$type": "dimension"
    },
    "radius-surface-6px": {
      "$value": "{plx-sys.shape-sm}",
      "$type": "dimension"
    },
    "radius-card-4px": {
      "$value": "{plx-sys.shape-xs}",
      "$type": "dimension"
    },
    "radius-card-6px": {
      "$value": "{plx-sys.shape-sm}",
      "$type": "dimension"
    },
    "radius-table-2px": {
      "$value": "{plx-ref.radius-2px}",
      "$type": "dimension",
      "$description": "Tables and data grids: their frame corner (owner, 2026-10-19: every data grid and table at 2px)."
    },
    "radius-menu-6px": {
      "$value": "{plx-sys.shape-sm}",
      "$type": "dimension"
    },
    "radius-dialog-6px": {
      "$value": "{plx-sys.shape-sm}",
      "$type": "dimension"
    },
    "radius-avatar-4px": {
      "$value": "{plx-sys.shape-xs}",
      "$type": "dimension"
    },
    "radius-avatar-6px": {
      "$value": "{plx-sys.shape-sm}",
      "$type": "dimension"
    },
    "space-inline-xs": {
      "$value": "{plx-ref.space-4px}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* ── SPACING ROLES: inline, stack, inset, cluster, region (fixed relationships) ── */"
          ]
        }
      }
    },
    "space-inline-sm": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "space-inline-md": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "space-inline-lg": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "space-stack-xs": {
      "$value": "{plx-ref.space-4px}",
      "$type": "dimension"
    },
    "space-stack-sm": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "space-stack-md": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "space-stack-lg": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "space-stack-xl": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "space-section": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension",
      "$description": "The space between peer sections (a heading and its content, then the next) that are not framed: twice a heading's distance to its content, the same in a page or a split pane, at every density, in either reading direction and on phones (owner, 2026-10-22, issue #242)."
    },
    "space-stack-2xl": {
      "$value": "{plx-ref.space-32px}",
      "$type": "dimension"
    },
    "space-inset-xs": {
      "$value": "{plx-ref.space-4px}",
      "$type": "dimension"
    },
    "space-inset-sm": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "space-inset-md": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "space-inset-lg": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "space-inset-xl": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "space-cluster-xs": {
      "$value": "{plx-ref.space-4px}",
      "$type": "dimension"
    },
    "space-cluster-sm": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "space-cluster-md": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "space-cluster-lg": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "space-layout-sm": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "space-layout-md": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "space-layout-lg": {
      "$value": "{plx-ref.space-32px}",
      "$type": "dimension"
    },
    "space-layout-xl": {
      "$value": "{plx-ref.space-48px}",
      "$type": "dimension"
    },
    "label-height-16px": {
      "$value": "{plx-ref.size-16px}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* ── LABEL HEIGHTS: small non-interactive boxes ── */"
          ]
        }
      }
    },
    "label-height-20px": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "shell-header-height": {
      "$value": "{plx-ref.size-56px}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* ── LAYOUT: shell (the global header; the shell's other regions take their widths from the density) ── */"
          ]
        }
      }
    },
    "field-width-xs": {
      "$value": "{plx-ref.size-48px}",
      "$type": "dimension",
      "$description": "a color well",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* ── SIZES OF THINGS INSIDE A LAYOUT (batch 150): fields narrower than their column, and lists that scroll ── */"
          ],
          "after": "    /* a color well */"
        }
      }
    },
    "field-width-sm": {
      "$value": "{plx-ref.size-80px}",
      "$type": "dimension",
      "$description": "a number, an order",
      "$extensions": {
        "com.plenix": {
          "after": "    /* a number, an order */"
        }
      }
    },
    "field-width-md": {
      "$value": "{plx-ref.size-100px}",
      "$type": "dimension",
      "$description": "a hex value, a short code",
      "$extensions": {
        "com.plenix": {
          "after": "   /* a hex value, a short code */"
        }
      }
    },
    "field-width-lg": {
      "$value": "{plx-ref.size-220px}",
      "$type": "dimension",
      "$description": "a name, a filter, a picker",
      "$extensions": {
        "com.plenix": {
          "after": "   /* a name, a filter, a picker */"
        }
      }
    },
    "scroll-max-sm": {
      "$value": "{plx-ref.size-240px}",
      "$type": "dimension",
      "$description": "a short list in a dialog",
      "$extensions": {
        "com.plenix": {
          "after": "    /* a short list in a dialog */"
        }
      }
    },
    "scroll-max-md": {
      "$value": "{plx-ref.size-320px}",
      "$type": "dimension"
    },
    "scroll-max-lg": {
      "$value": "{plx-ref.size-400px}",
      "$type": "dimension"
    },
    "label-width-sm": {
      "$value": "{plx-ref.size-100px}",
      "$type": "dimension",
      "$description": "the label column of a narrow inline field (an inspector)",
      "$extensions": {
        "com.plenix": {
          "after": "   /* the label column of a narrow inline field (an inspector) */"
        }
      }
    },
    "boundary-outline-width": {
      "$value": "0px",
      "$type": "dimension",
      "$description": "The outline of a surface that floats on a shadow (menus, dialogs, cards): none, and a thin line in forced colors, where shadows are not drawn.",
      "$extensions": {
        "com.plenix": {
          "forcedColors": "{plx-sys.border-width-thin}"
        }
      }
    },
    "boundary-outline-color": {
      "$value": "transparent",
      "$type": "color",
      "$description": "The color of the boundary outline: none, and the text color in forced colors.",
      "$extensions": {
        "com.plenix": {
          "forcedColors": "CanvasText"
        },
        "plenix": {
          "group": "border",
          "purpose": "The outline of a surface that floats on a shadow, drawn only in forced colors (CanvasText there)."
        }
      }
    },
    "forced-indicator": {
      "$value": "initial",
      "$description": "An indicator's fill in forced colors (a progress fill): Highlight there; otherwise not set (initial), so the component keeps its own color.",
      "$extensions": {
        "com.plenix": {
          "forcedColors": "Highlight"
        }
      }
    },
    "forced-gap": {
      "$value": "initial",
      "$description": "The gap in a ring in forced colors (the spinner's): Canvas there; otherwise not set (initial), so the component keeps its own.",
      "$extensions": {
        "com.plenix": {
          "forcedColors": "Canvas"
        }
      }
    },
    "icon-forced-stroke": {
      "$value": "0",
      "$type": "number",
      "$description": "How much of an icon's box its border fills (0 or 1). In forced colors a fill in currentcolor is forced to Canvas while a border in currentcolor takes the system color of where the icon sits (CanvasText, HighlightText in a selected item, GrayText when disabled, LinkText in a link): there the icon is drawn by its border.",
      "$extensions": {
        "com.plenix": {
          "forcedColors": "1"
        }
      }
    },
    "print-hidden": {
      "$value": "initial",
      "$description": "On paper the chrome is left out (the app header, the navigation pane, the skip link, the scrim, the floating action button, toasts, the spotlight): their display reads it. Not set on screen (initial: the element keeps its own).",
      "$extensions": {
        "com.plenix": {
          "print": "none"
        }
      }
    },
    "print-block-size": {
      "$value": "initial",
      "$description": "On paper the shell is as tall as its content: the shell's fixed heights read it. Not set on screen.",
      "$extensions": {
        "com.plenix": {
          "print": "auto"
        }
      }
    },
    "print-max-block-size": {
      "$value": "initial",
      "$description": "On paper nothing is cut to a maximum height: a region with a set height (a data grid's) reads it. Not set on screen.",
      "$extensions": {
        "com.plenix": {
          "print": "none"
        }
      }
    },
    "print-overflow": {
      "$value": "initial",
      "$description": "On paper nothing scrolls: the shell's scrolling regions read it. Not set on screen.",
      "$extensions": {
        "com.plenix": {
          "print": "visible"
        }
      }
    },
    "print-position": {
      "$value": "initial",
      "$description": "On paper the shell's positioned regions take their place in the flow. Not set on screen.",
      "$extensions": {
        "com.plenix": {
          "print": "static"
        }
      }
    },
    "print-shown": {
      "$value": "initial",
      "$description": "On paper what Show print marks is shown: its box reads it. Not set on screen (initial: hidden).",
      "$extensions": {
        "com.plenix": {
          "print": "contents"
        }
      }
    },
    "print-keep": {
      "$value": "initial",
      "$description": "On paper cards, notices and figures are not split across two sheets and headings stay with what follows them: their break-inside and break-after read it. Not set on screen (initial: auto).",
      "$extensions": {
        "com.plenix": {
          "print": "avoid"
        }
      }
    },
    "print-url-before": {
      "$value": "initial",
      "$description": "On paper inside plx-print-urls, the text before an external link's address. Not set on screen (initial: no address).",
      "$extensions": {
        "com.plenix": {
          "print": "\" (\""
        }
      }
    },
    "print-url-after": {
      "$value": "initial",
      "$description": "On paper inside plx-print-urls, the text after an external link's address. Not set on screen.",
      "$extensions": {
        "com.plenix": {
          "print": "\")\""
        }
      }
    }
  }
}
