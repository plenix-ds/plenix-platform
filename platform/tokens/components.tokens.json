{
  "$description": "components tokens written under :root Written on :root and on every density and interaction context, so a component token that points to a density role is computed where the region sets its density (a custom property is computed where it is declared; batch 221).",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/components.css",
      "selector": ":root,[data-plx-density],[data-plx-interaction]",
      "opener": ":root,[data-plx-density],[data-plx-interaction] {"
    }
  },
  "plx-comp": {
    "button-height-xs": {
      "$value": "{plx-ref.control-size-24px}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* ── CONTROLS: the neutral component scale (for a size picked on purpose: data-size=\"xs\" … \"4xl\") ── */"
          ]
        }
      }
    },
    "button-height-sm": {
      "$value": "{plx-ref.control-size-28px}",
      "$type": "dimension"
    },
    "button-height-md": {
      "$value": "{plx-ref.control-size-32px}",
      "$type": "dimension"
    },
    "button-height-lg": {
      "$value": "{plx-ref.control-size-36px}",
      "$type": "dimension"
    },
    "button-height-xl": {
      "$value": "{plx-ref.control-size-40px}",
      "$type": "dimension"
    },
