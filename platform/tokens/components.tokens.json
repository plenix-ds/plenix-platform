      "$type": "dimension"
    },
    "button-size-md-font-size": {
      "$value": "{plx-ref.font-size-13}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* ── BUTTON: every value of the Button (button.css uses only these). Sizes first: md is the default; sm, xs and 2xs are the",
            "     toolbar, inline and smallest roles (muted text, quieter hover); lg is the prominent role ── */"
          ]
        }
      }
    },
    "button-size-md-font-weight": {
      "$value": "{plx-sys.font-weight-semibold}",
      "$type": "fontWeight"
