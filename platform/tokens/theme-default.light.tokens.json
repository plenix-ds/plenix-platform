      "$value": "{plx-ref.color-gray-75}",
      "$type": "color",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  color-scheme: light;",
            "  /* surfaces, states, content, borders, actions, feedback, focus */"
          ]
        }
      }
    },
