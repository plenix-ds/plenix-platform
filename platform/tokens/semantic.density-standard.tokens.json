{
  "$description": "semantic tokens written under :root,[data-plx-density=\"standard\"]",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/semantic.css",
      "selector": ":root,[data-plx-density=\"standard\"]",
      "opener": ":root,[data-plx-density=\"standard\"]{"
    }
  },
  "plx-sys": {
    "control-height-inline": {
      "$value": "{plx-ref.control-size-28px}",
      "$type": "dimension"
    },
    "control-icon-inline": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "control-height-toolbar": {
      "$value": "{plx-ref.control-size-28px}",
      "$type": "dimension"
    },
    "control-icon-toolbar": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "control-height-standard": {
      "$value": "{plx-ref.control-size-32px}",
      "$type": "dimension"
    },
    "control-icon-standard": {
      "$value": "{plx-ref.size-24px}",
      "$type": "dimension"
    },
    "control-height-prominent": {
      "$value": "{plx-ref.control-size-32px}",
      "$type": "dimension"
    },
    "control-icon-prominent": {
      "$value": "{plx-ref.size-24px}",
      "$type": "dimension"
    },
    "control-height-dialog": {
      "$value": "{plx-ref.control-size-36px}",
      "$type": "dimension"
    },
    "control-icon-dialog": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "control-height-dialog-destructive": {
      "$value": "{plx-ref.control-size-36px}",
      "$type": "dimension"
    },
    "control-icon-dialog-destructive": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "table-row-height": {
      "$value": "{plx-ref.size-36px}",
      "$type": "dimension"
    },
    "table-row-height-multiline": {
      "$value": "{plx-ref.size-40px}",
      "$type": "dimension"
    },
    "card-grid-gap": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "grid-gutter": {
      "$value": "{plx-ref.grid-gutter-16px}",
      "$type": "dimension"
    },
    "page-margin-desktop": {
      "$value": "{plx-ref.grid-margin-24px}",
      "$type": "dimension"
    },
    "page-margin-wide": {
      "$value": "{plx-ref.grid-margin-32px}",
      "$type": "dimension"
    },
    "panel-filter-width": {
      "$value": "{plx-ref.size-320px}",
      "$type": "dimension"
    },
    "panel-inspector-width": {
      "$value": "{plx-ref.size-360px}",
      "$type": "dimension"
    },
    "shell-nav-width": {
      "$value": "{plx-ref.size-240px}",
      "$type": "dimension"
    },
    "shell-nav-min-width": {
      "$value": "{plx-ref.size-140px}",
      "$type": "dimension"
    },
    "shell-nav-max-width": {
      "$value": "{plx-ref.size-320px}",
      "$type": "dimension"
    },
    "shell-splitter-step": {
      "$value": "{plx-ref.size-16px}",
      "$type": "dimension"
    },
    "shell-rail-below": {
      "$value": "{plx-ref.breakpoint-768px}",
      "$type": "dimension",
      "$description": "the navigation is a rail below this width",
      "$extensions": {
        "com.plenix": {
          "after": "      /* the navigation is a rail below this width */"
        }
      }
    },
    "shell-inspector-overlay-below": {
      "$value": "{plx-ref.breakpoint-1024px}",
      "$type": "dimension",
      "$description": "the inspector collapses and opens over the main region below this width",
      "$extensions": {
        "com.plenix": {
          "after": "   /* the inspector collapses and opens over the main region below this width */"
        }
      }
    },
    "space-component-gap-xs": {
      "$value": "{plx-ref.space-4px}",
      "$type": "dimension"
    },
    "space-component-gap-sm": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "space-component-gap-md": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "space-component-gap-lg": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "space-container-inset-sm": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "space-container-inset-md": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "space-container-inset-lg": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "space-pattern-stack-sm": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "space-pattern-stack-md": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "space-pattern-stack-lg": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "space-region-space-sm": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "space-region-space-md": {
      "$value": "{plx-ref.space-32px}",
      "$type": "dimension"
    },
    "space-region-space-lg": {
      "$value": "{plx-ref.space-48px}",
      "$type": "dimension"
    },
    "grid-row-height": {
      "$value": "{plx-ref.size-32px}",
      "$type": "dimension"
    },
    "grid-font-size": {
      "$value": "{plx-ref.font-size-13}",
      "$type": "dimension"
    }
  }
}
