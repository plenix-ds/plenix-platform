{
  "$description": "semantic tokens written under :root,[data-plx-density=\"standard\"],[data-plx-density=\"comfortable\"]",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/semantic.css",
      "selector": ":root,[data-plx-density=\"standard\"],[data-plx-density=\"comfortable\"]",
      "opener": ":root,[data-plx-density=\"standard\"],[data-plx-density=\"comfortable\"]{"
    }
  },
  "plx-sys": {
    "radius-control": {
      "$value": "{plx-sys.radius-control-6px}",
      "$type": "dimension"
    }
  }
}
