{
  "$description": "semantic.tokens.json: the values on paper (@media print). A condition set: each token is defined in semantic.tokens.json, and this file holds only its value under the condition (#372 step 4).",
  "plx-sys": {
    "print-hidden": {
      "$value": "none",
      "$extensions": { "com.plenix": { "webOnly": true } }
    },
    "print-block-size": {
      "$value": "auto",
      "$extensions": { "com.plenix": { "webOnly": true } }
    },
    "print-max-block-size": {
      "$value": "none",
      "$extensions": { "com.plenix": { "webOnly": true } }
    },
    "print-overflow": {
      "$value": "visible",
      "$extensions": { "com.plenix": { "webOnly": true } }
    },
    "print-position": {
      "$value": "static",
      "$extensions": { "com.plenix": { "webOnly": true } }
    },
    "print-shown": {
      "$value": "contents",
      "$extensions": { "com.plenix": { "webOnly": true } }
    },
    "print-keep": {
      "$value": "avoid",
      "$extensions": { "com.plenix": { "webOnly": true } }
    },
    "print-url-before": {
      "$value": "\" (\"",
      "$extensions": { "com.plenix": { "webOnly": true } }
    },
    "print-url-after": {
      "$value": "\")\"",
      "$extensions": { "com.plenix": { "webOnly": true } }
    }
  }
}
