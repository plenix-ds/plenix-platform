{
  "$description": "semantic tokens written under :root[data-plx-interaction=\"touch\"],:root[data-plx-interaction=\"touch\"] [data-plx-density]",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/semantic.css",
      "selector": ":root[data-plx-interaction=\"touch\"],:root[data-plx-interaction=\"touch\"] [data-plx-density]",
      "opener": ":root[data-plx-interaction=\"touch\"],:root[data-plx-interaction=\"touch\"] [data-plx-density]{"
    }
  },
  "plx-sys": {
    "control-target-min": {
      "$value": "{plx-ref.control-size-44px}",
      "$type": "dimension",
      "$extensions": {
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "rule",
            "level": "recommended by the source",
            "framework": "WCAG 2.2",
            "version": "2.2 (W3C Recommendation)",
            "name": "SC 2.5.5 Target Size (Enhanced), AAA",
            "published": "44×44 CSS px",
            "url": "https://www.w3.org/WAI/WCAG22/Understanding/target-size-enhanced.html"
          }
        }
      }
    },
    "control-height-inline": {
      "$value": "{plx-ref.control-size-44px}",
      "$type": "dimension"
    },
    "control-icon-inline": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "control-height-toolbar": {
      "$value": "{plx-ref.control-size-44px}",
      "$type": "dimension"
    },
    "control-icon-toolbar": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "control-height-standard": {
      "$value": "{plx-ref.control-size-44px}",
      "$type": "dimension"
    },
    "control-icon-standard": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "control-height-prominent": {
      "$value": "{plx-ref.control-size-44px}",
      "$type": "dimension"
    },
    "control-icon-prominent": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "control-height-dialog": {
      "$value": "{plx-ref.control-size-44px}",
      "$type": "dimension"
    },
    "control-icon-dialog": {
      "$value": "{plx-ref.size-20px}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): no role or component token has its values in every theme and density; the nearest is --plx-sys-control-icon-inline (16px instead of 20px when compact). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    },
    "control-height-dialog-destructive": {
      "$value": "{plx-ref.control-size-44px}",
      "$type": "dimension"
    },
    "control-icon-dialog-destructive": {
      "$value": "{plx-ref.size-20px}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): no role or component token has its values in every theme and density; the nearest is --plx-sys-control-icon-inline (16px instead of 20px when compact). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    },
    "data-grid-row-height": {
      "$value": "{plx-ref.size-44px}",
      "$type": "dimension"
    },
    "table-row-height": {
      "$value": "{plx-ref.size-44px}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): use --plx-sys-data-grid-row-height instead (the same value in every theme and density). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    }
  }
}
