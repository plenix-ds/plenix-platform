   "code": {
    "swiftui": [
     "import SwiftUI",
     "",
     "/// The Plenix button on iOS: the system Button, styled with the Plenix tokens (PlenixTokens.swift).",
     "struct PlenixButtonStyle: ButtonStyle {",
     "    enum Variant { case primary, secondary, ghost, danger, dangerSecondary }",
     "    var variant: Variant = .secondary",
     "    @Environment(\\.isEnabled) private var isEnabled",
     "",
     "    func makeBody(configuration: Configuration) -> some View {",
     "        let shape = RoundedRectangle(cornerRadius: Plenix.Radius.radiusControl)",
     "        return configuration.label",
     "            .font(Plenix.Font.sans(Plenix.Platform.textLabelSize, relativeTo: .subheadline).weight(.semibold))",
     "            .foregroundStyle(isEnabled ? content : Plenix.Colors.contentDisabled)",
     "            .padding(.horizontal, Plenix.Space.spaceInlineMd)",
     "            .frame(minHeight: Plenix.Platform.controlTargetMin)",
     "            .background(background(pressed: configuration.isPressed), in: shape)",
     "            .overlay { if let border { shape.strokeBorder(border, lineWidth: 1) } }",
     "            .contentShape(shape)",
     "    }",
     "",
     "    private var content: Color {",
     "        switch variant {",
     "        case .primary: Plenix.Colors.actionPrimaryContent",
     "        case .secondary: Plenix.Colors.contentDefault",
     "        case .ghost: Plenix.Colors.contentMuted",
     "        case .danger: Plenix.Colors.actionDangerContent",
     "        case .dangerSecondary: Plenix.Colors.feedbackDangerContent",
     "        }",
     "    }",
     "    private func background(pressed: Bool) -> Color {",
     "        switch variant {",
     "        case .primary: pressed ? Plenix.Colors.actionPrimaryBackgroundPressed : Plenix.Colors.actionPrimaryBackground",
     "        case .danger: pressed ? Plenix.Colors.actionDangerBackgroundPressed : Plenix.Colors.actionDangerBackground",
     "        case .ghost: pressed ? Plenix.Colors.statePressed : .clear",
     "        case .secondary, .dangerSecondary: pressed ? Plenix.Colors.statePressed : Plenix.Colors.controlBackground",
     "        }",
     "    }",
     "    private var border: Color? {",
     "        switch variant {",
     "        case .secondary: Plenix.Colors.controlBorder",
     "        case .dangerSecondary: Plenix.Colors.feedbackDangerContent",
     "        default: nil",
     "        }",
     "    }",
     "}",
     "",
     "// In a view",
     "Button(\"Save\", action: save).buttonStyle(PlenixButtonStyle(variant: .primary))",
     "Button(\"Cancel\", role: .cancel, action: dismiss).buttonStyle(PlenixButtonStyle())",
     "Button(\"Delete\", role: .destructive, action: delete).buttonStyle(PlenixButtonStyle(variant: .danger))"
    ],
    "uikit": [
     "import UIKit",
     "import SwiftUI",
     "",
     "/// The Plenix button on iOS in UIKit: a UIButton with a Plenix configuration.",
     "extension UIButton.Configuration {",
     "    static func plenix(background: Color?, content: Color, border: Color? = nil) -> UIButton.Configuration {",
     "        var c = UIButton.Configuration.plain()",
     "        c.cornerStyle = .fixed",
     "        c.background.cornerRadius = Plenix.Radius.radiusControl",
     "        c.background.backgroundColor = background.map(UIColor.init)",
     "        if let border { c.background.strokeColor = UIColor(border); c.background.strokeWidth = 1 }",
     "        c.baseForegroundColor = UIColor(content)",
     "        c.contentInsets = NSDirectionalEdgeInsets(top: 0, leading: Plenix.Space.spaceInlineMd, bottom: 0, trailing: Plenix.Space.spaceInlineMd)",
     "        c.imagePadding = Plenix.Space.spaceInlineXs",
     "        c.titleTextAttributesTransformer = UIConfigurationTextAttributesTransformer { attributes in",
     "            var a = attributes",
     "            let font = UIFont(name: \"DMSans-SemiBold\", size: Plenix.Platform.textLabelSize) ?? .preferredFont(forTextStyle: .subheadline)",
     "            a.font = UIFontMetrics(forTextStyle: .subheadline).scaledFont(for: font)",
     "            return a",
     "        }",
     "        return c",
     "    }",
     "}",
     "",
     "let save = UIButton(configuration: .plenix(background: Plenix.Colors.actionPrimaryBackground, content: Plenix.Colors.actionPrimaryContent),",
     "                    primaryAction: UIAction(title: \"Save\") { _ in save() })",
     "save.heightAnchor.constraint(greaterThanOrEqualToConstant: Plenix.Platform.controlTargetMin).isActive = true",
     "save.configurationUpdateHandler = { button in",
     "    button.configuration?.background.backgroundColor = UIColor(button.isHighlighted ? Plenix.Colors.actionPrimaryBackgroundPressed : Plenix.Colors.actionPrimaryBackground)",
     "}"
    ],
    "appkit": [
     "import AppKit",
     "import SwiftUI",
     "",
     "// The Plenix button on the Mac. A Mac Catalyst app uses the iOS tokens and the UIKit code above. A native AppKit app",
     "// needs a macOS build of PlenixTokens.swift (it uses UIColor today; the macOS build is not generated yet). With it:",
     "let save = NSButton(title: \"Save\", target: self, action: #selector(save(_:)))",
     "save.bezelStyle = .push",
     "save.controlSize = .large",
     "save.bezelColor = NSColor(Plenix.Colors.actionPrimaryBackground)",
     "save.contentTintColor = NSColor(Plenix.Colors.actionPrimaryContent)",
     "save.font = NSFont(name: \"DMSans-SemiBold\", size: Plenix.Platform.textLabelSize)",
     "save.keyEquivalent = \"\r\"   // the default action",
     "",
     "let delete = NSButton(title: \"Delete\", target: self, action: #selector(delete(_:)))",
     "delete.bezelStyle = .push",
     "delete.hasDestructiveAction = true"
    ]
   }
  }
 }
